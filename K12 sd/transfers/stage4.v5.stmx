                <to>Thrust</to>
            </connector>
            <connector x="63" y="414" uid="19">
                <from>Volume_empty_rocket</from>
                <to>Rocket_pressure</to>
            </connector>
            <connector x="424" y="111" uid="20">
                <from>Rocket_diameter</from>
                <to>Cross_sectional_area_of_rocket</to>
            </connector>
            <connector x="392" y="70" uid="21">
