            <stacked_container height="282" width="492" uid="40">
                <graph type="time_series" title="Untitled" background="#C8C8C8" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-04T10:14:27Z" comparative="true" cleared="true" time_precision="2" from="0" to="6">
                    <plot index="0" pen_width="1" color="red" precision="0.01" show_y_axis="true">
                        <scale min="0" max="50" />
