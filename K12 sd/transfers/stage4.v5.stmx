                <from>Gravity</from>
                <to>Weight</to>
            </connector>
            <connector x="140" y="206" uid="5">
                <from>Empty_rocket_mass</from>
                <to>Weight</to>
            </connector>
            <connector x="201" y="223" uid="6">
                <from>Weight</from>
                <to>Total_force</to>
            </connector>
            <connector x="211" y="126" uid="7">
                <from>Velocity</from>
                <to>Total_force</to>
            </connector>
            <connector x="188" y="177" uid="8">
                <from>Total_force</from>
                <to>Acceleration</to>
            </connector>
            <connector x="287" y="128" uid="9">
                <from>Air_resistance</from>
                <to>Total_force</to>
            </connector>
            <connector x="224" y="102" uid="10">
                <from>Velocity</from>
                <to>Air_resistance</to>
            </connector>
            <connector x="328" y="77" uid="11">
                <from>c2</from>
                <to>Air_resistance</to>
            </connector>
            <connector x="129" y="185" uid="12">
                <from>Empty_rocket_mass</from>
                <to>Acceleration</to>
            </connector>
            <connector x="342" y="215" uid="13">
                <from>Thrust</from>
                <to>Total_force</to>
            </connector>
            <connector x="260" y="247" uid="14">
                <from>Gravity</from>
                <to>Flow_through_orifice</to>
            </connector>
            <connector x="165" y="307" uid="15">
                <from>Volume_of_water</from>
                <to>Thrust</to>
            </connector>
            <connector x="125" y="322" uid="16">
                <from>Volume_of_water</from>
                <to>Rocket_pressure</to>
            </connector>
            <connector x="117" y="429" uid="17">
                <from>Initial_pressure</from>
                <to>Rocket_pressure</to>
            </connector>
            <connector x="357" y="412" uid="18">
