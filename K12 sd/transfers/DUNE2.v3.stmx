<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" level="3" xmlns="http://www.systemdynamics.org/XMILE" xmlns:isee="http://iseesystems.com/XMILE">
    <header>
        <smile version="1.0" namespace="std, isee">
            <uses_arrays>1</uses_arrays>
        </smile>
        <name>DUNE2.v3</name>
        <uuid>475dc9c6-d792-4815-aa90-8e66facf823a</uuid>
        <vendor>isee systems, inc.</vendor>
        <product version="10.1.2" isee:saved_by_v1="false" lang="en">iThink</product>
    </header>
    <style>
        <model font-family="Arial" font-size="9" />
        <interface font-family="Arial" font-size="9" />
    </style>
    <sim_specs method="Euler" time_units="Time" isee:pause_after_rates="false" isee:instantaneous_flows="false">
        <start>0</start>
        <stop>100</stop>
        <dt>0.5</dt>
        <isee:analyze_mode>false</isee:analyze_mode>
    </sim_specs>
    <dimensions>
        <dim name="Dim_Name_1" size="1" />
    </dimensions>
    <model_units />
    <isee:prefs last_model="true" layer="model" grid_width="20" grid_height="50" divide_by_zero_alert="true" hide_taskbar="true" show_module_prefix="true">
        <isee:window width="1366" height="685" />
        <isee:security />
        <isee:print_setup width="595" height="775" />
    </isee:prefs>
    <isee:equation_prefs order_by="sector" />
    <model>
        <stock name="dune_height">
            <eqn>0</eqn>
            <scale min="0" max="50" />
            <inflow>dune_growth</inflow>
            <non_negative />
            <display x="180" y="50" color="blue" label_angle="84">
                <scale min="0" max="50" />
            </display>
        </stock>
        <flow name="dune_growth">
            <doc>3</doc>
            <eqn>if (dune_height=0) then 4 else (4/dune_height)</eqn>
            <non_negative />
            <display x="114" y="50" color="blue" label_side="left" label_angle="212">
                <pts>
                    <pt x="68" y="50" />
                    <pt x="160" y="50" />
                </pts>
            </display>
        </flow>
        <stock name="vegetation">
            <eqn>0&#x0D;</eqn>
            <scale min="0" max="50" />
            <inflow>vegetation_growth</inflow>
            <non_negative />
            <display x="328" y="102" color="blue" label_side="right">
                <scale min="0" max="50" />
            </display>
        </stock>
        <flow name="vegetation_growth">
            <eqn>if (dune_height &gt;= 5) then if vegetation=0 then 2 else vegetation*.03 else 0</eqn>
            <scale min="0" max="2" />
            <non_negative />
            <display x="273" y="102" color="blue" label_side="left" label_angle="199">
                <scale min="0" max="2" />
                <pts>
                    <pt x="238" y="102" />
                    <pt x="308" y="102" />
                </pts>
            </display>
        </flow>
        <stock name="forest">
            <eqn>0</eqn>
            <scale min="0" max="50" />
            <inflow>forest_growth</inflow>
            <non_negative />
            <display x="495" y="156" color="blue" label_side="right" label_angle="2">
                <scale min="0" max="50" />
            </display>
        </stock>
        <flow name="forest_growth">
            <eqn>if dune_height&gt;=15 then if (forest = 0) then 1 else forest*.03 else 0</eqn>
            <scale min="0" max="2" />
            <non_negative />
            <display x="439" y="151" color="blue" label_side="left" label_angle="212">
                <scale min="0" max="2" />
                <pts>
                    <pt x="403" y="151" />
                    <pt x="475" y="151" />
                </pts>
            </display>
        </flow>
        <display page_width="595" page_height="775" isee:converter_size="medium" interval="10" scroll_y="56">
            <connector x="178" y="67" uid="0">
                <from>dune_height</from>
                <to>dune_growth</to>
            </connector>
            <connector x="326" y="119" uid="1">
                <from>vegetation</from>
                <to>vegetation_growth</to>
            </connector>
            <connector x="202" y="54" uid="2">
                <from>dune_height</from>
                <to>vegetation_growth</to>
            </connector>
            <connector x="202" y="44" uid="3">
                <from>dune_height</from>
                <to>forest_growth</to>
            </connector>
            <connector x="492" y="173" uid="4">
                <from>forest</from>
                <to>forest_growth</to>
            </connector>
            <stacked_container height="282" width="492" uid="5">
                <graph type="time_series" title="Barrier Island Development Assuming Exponential Growth" background="#C8C8C8" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-07T15:39:51Z" cleared="true" time_precision="0" from="0" to="100">
                    <plot index="0" pen_width="1" color="red" precision="1" show_y_axis="true">
                        <entity name="dune_height" />
                    </plot>
                    <plot index="1" pen_width="1" color="blue" precision="1" show_y_axis="true">
                        <entity name="vegetation" />
                    </plot>
                    <plot index="2" pen_width="1" color="fuchsia" precision="1" show_y_axis="true">
                        <entity name="forest" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="153" y="260" width="26" height="22" color="#0CA0FF" label_side="bottom" label="Barrier Island Development " type="graph" icon_of="5" />
            <stacked_container height="286" width="465" uid="6">
                <table font-size="9" background="#FFFE91" column_width="60" orientation="vertical" interval="10" cleared="true" date_time="1995-08-17T13:36:14Z">
                    <title>Barrier Island Development Assuming Exponential Growth</title>
                    <item type="time" color="black" precision="0.01" width="100" />
                    <item color="black" precision="0.01" delimit_000s="true" index="0">
                        <entity name="dune_height" />
                    </item>
                    <item color="black" precision="0.01" delimit_000s="true" index="1">
                        <entity name="vegetation" />
                    </item>
                    <item color="black" precision="0.01" delimit_000s="true" index="2">
                        <entity name="forest" />
                    </item>
                </table>
            </stacked_container>
            <pad_icon x="302" y="260" width="26" height="22" color="#008F44" label_side="bottom" label="Barrier Island Development" type="table" icon_of="6" />
            <style font-family="Arial" font-size="9" />
        </display>
        <interface page_width="788" page_height="528" scroll_y="40">
            <simulation_delay>0.1</simulation_delay>
            <text_box x="147" y="77" uid="7" color="#7F00FF" font-family="Arial" font-size="14" text-align="center" padding="5" border-style="double" border-width="thick-thin" width="260" height="60">Barrier Island Development &#x0D;Assuming Exponential Growth</text_box>
            <text_box x="146" y="165" uid="8" color="#7F00FF" font-family="Arial" font-size="12" text-align="center" padding="5" width="261" height="119">Aili Carlson&#x0D;acarlson@people.mbhs.edu&#x0D;Sarah Clemmitt&#x0D;sclemmit@people.mbhs.edu&#x0D;Maryland Virtual High School&#x0D;August 1995</text_box>
            <style font-family="Arial" font-size="9" />
        </interface>
        <popup x="16" y="78" content="5" />
        <popup x="16" y="78" content="6" />
        <style font-family="Arial" font-size="9" />
    </model>
</xmile>
