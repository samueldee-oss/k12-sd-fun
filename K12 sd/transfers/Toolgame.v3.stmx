<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" level="3" xmlns="http://www.systemdynamics.org/XMILE" xmlns:isee="http://iseesystems.com/XMILE">
    <header>
        <smile version="1.0" namespace="std, isee">
            <uses_arrays>1</uses_arrays>
        </smile>
        <name>Toolgame.v3</name>
        <uuid>121e1568-86ab-40e4-8f73-9aad2cdcb793</uuid>
        <vendor>isee systems, inc.</vendor>
        <product version="10.1.2" isee:saved_by_v1="false" lang="en">iThink</product>
    </header>
    <style>
        <model font-family="Arial" font-size="9" />
        <interface font-family="Arial" font-size="9" />
    </style>
    <sim_specs method="Euler" time_units="Weeks" pause_interval="1" isee:pause_after_rates="false" isee:instantaneous_flows="false">
        <start>0</start>
        <stop>40</stop>
        <dt>0.25</dt>
        <isee:analyze_mode>false</isee:analyze_mode>
    </sim_specs>
    <dimensions>
        <dim name="Dim_Name_1" size="1" />
    </dimensions>
    <model_units />
    <isee:prefs last_model="true" layer="model" grid_width="20" grid_height="50" divide_by_zero_alert="true" hide_taskbar="true" show_module_prefix="true" hide_bundled_connectors="true" hide_pads_icons="true">
        <isee:window width="1366" height="685" />
        <isee:security />
        <isee:print_setup width="595" height="775" />
    </isee:prefs>
    <isee:equation_prefs order_by="sector" show_pages="true" />
    <model>
        <stock name="Assignment_Backlog">
            <eqn>1e-7</eqn>
            <scale min="0" max="100" />
            <inflow>Assignment_Rate</inflow>
            <outflow>Completion_Rate</outflow>
            <non_negative />
            <display x="200" y="348" color="blue">
                <scale min="0" max="100" />
            </display>
        </stock>
        <stock name="Cumulative_Hours_Worked">
            <eqn>0</eqn>
            <scale min="0" max="250" />
            <inflow>Change_in_Hours_Worked</inflow>
            <non_negative />
            <display x="378" y="618" color="blue" label_angle="57">
                <scale min="0" max="250" />
            </display>
        </stock>
        <stock name="Energy_Level">
            <eqn>1</eqn>
            <scale min="0" max="1" />
            <inflow>EL_Regeneration</inflow>
            <outflow>E_Depletion</outflow>
            <non_negative />
            <event_poster min="0" max="1">
                <threshold value="0.2" direction="decreasing">
                    <event>
                        <text_box>You feel horrible.  Why even bother to go to school?  It&apos;s not worth it, you can&apos;t do anything right.</text_box>
                    </event>
                </threshold>
                <threshold value="0.4" direction="decreasing">
                    <event>
                        <text_box>You feel very drained.  You find you have difficulty concentrating in class.  It takes you noticeably longer to do your homework.  You don&apos;t really understand it anyway, but it doesn&apos;t matter, it&apos;s so stupid.</text_box>
                    </event>
                </threshold>
                <threshold value="0.6" direction="decreasing">
                    <event>
                        <text_box>Yawn!  You almost doze off in class.  Luckily, you woke up right away.</text_box>
                    </event>
                </threshold>
            </event_poster>
            <display x="800" y="65" color="blue">
                <scale min="0" max="1" />
            </display>
        </stock>
        <stock name="Hours_Allocated_Per_Assignment">
            <eqn>Actual_Desired_HAA</eqn>
            <scale min="0" max="10" />
            <inflow>Change_in_Hours_Allocated_Per_Assignment</inflow>
            <display x="413" y="137" color="blue">
                <scale min="0" max="10" />
            </display>
        </stock>
        <stock name="Total_Assignments_Completed">
            <eqn>1e-7</eqn>
            <scale min="0" max="50" />
            <inflow>Assigment_Completion_Rate</inflow>
            <non_negative />
            <display x="815" y="394" color="blue">
                <scale min="0" max="50" />
            </display>
        </stock>
        <stock name="Total_Points_Received">
            <eqn>Points_Per_Assignment*1e-7</eqn>
            <scale min="0" max="3500" />
            <inflow>Change_in_Total_Points_Received</inflow>
            <non_negative />
            <display x="803" y="499" color="blue">
                <scale min="0" max="3500" />
            </display>
        </stock>
        <flow name="Assignment_Rate">
            <eqn>Reference_Assignment_Rate*Assignment_Rate_Function</eqn>
            <scale min="0" max="100" />
            <non_negative />
            <display x="107" y="343" color="blue" label_side="top" label_angle="101">
                <scale min="0" max="100" />
                <pts>
                    <pt x="35" y="343" />
                    <pt x="180" y="343" />
                </pts>
            </display>
        </flow>
        <flow name="Completion_Rate">
            <eqn>Effective_Hours_Worked_Per_Week/Hours_Allocated_Per_Assignment</eqn>
            <scale min="0" max="20" />
            <non_negative />
            <display x="275" y="347" color="blue" label_side="top" label_angle="54">
                <scale min="0" max="20" />
                <pts>
                    <pt x="220" y="347" />
                    <pt x="331" y="347" />
                </pts>
            </display>
        </flow>
        <flow name="EL_Regeneration">
            <eqn>EL_Regeneration_Normal*Effect_of_Hours_Worked_on_Regeneration*Effect_of_High_EL_on_Regeneration</eqn>
            <scale min="0" max="0.5" />
            <non_negative />
            <display x="730" y="66" color="blue" label_side="top">
                <scale min="0" max="0.5" />
                <pts>
                    <pt x="680" y="66" />
                    <pt x="780" y="66" />
                </pts>
            </display>
        </flow>
        <flow name="E_Depletion">
            <eqn>Effect_of_Grades_on_EL_Depletion*E_Depletion_Normal*Effect_of_Low_EL_on_Depletion*Effect_of_Hours_Worked_on_Depletion</eqn>
            <scale min="0" max="0.5" />
            <non_negative />
            <display x="879" y="65" color="blue" label_side="top" label_angle="101">
                <scale min="0" max="0.5" />
                <pts>
                    <pt x="820" y="65" />
                    <pt x="939" y="65" />
                </pts>
            </display>
        </flow>
        <flow name="Change_in_Hours_Allocated_Per_Assignment">
            <eqn>(Actual_Desired_HAA-Hours_Allocated_Per_Assignment)/Time_to_adjust_HAA</eqn>
            <display x="345" y="142" color="blue" label_angle="300">
                <pts>
                    <pt x="297" y="142" />
                    <pt x="393" y="142" />
                </pts>
            </display>
        </flow>
        <flow name="Assigment_Completion_Rate">
            <eqn>Completion_Rate</eqn>
            <non_negative />
            <display x="729" y="381" color="blue">
                <pts>
                    <pt x="663" y="381" />
                    <pt x="795" y="381" />
                </pts>
            </display>
        </flow>
        <flow name="Change_in_Total_Points_Received">
            <eqn>Completion_Rate*Points_Per_Assignment</eqn>
            <non_negative />
            <display x="724" y="508" color="blue">
                <pts>
                    <pt x="665" y="508" />
                    <pt x="783" y="508" />
                </pts>
            </display>
        </flow>
        <flow name="Change_in_Hours_Worked">
            <eqn>Hours_Worked_Per_Week</eqn>
            <non_negative />
            <display x="252" y="617" color="blue">
                <pts>
                    <pt x="146" y="617" />
                    <pt x="358" y="617" />
                </pts>
            </display>
        </flow>
        <aux name="Assignment_Rate_Function">
            <eqn>1</eqn>
            <display x="165" y="372" color="blue" />
        </aux>
        <aux name="Effective_Hours_Worked_Per_Week">
            <eqn>Hours_Worked_Per_Week*Effect_of_EL_on_Production</eqn>
            <display x="331" y="412" color="blue" label_side="right" label_angle="348" />
        </aux>
        <aux name="Grade_Satisfaction">
            <eqn>GPA_1/Desired_GPA</eqn>
            <display x="1053" y="197" color="blue" />
        </aux>
        <aux name="Desired_GPA">
            <eqn>70</eqn>
            <scale min="0" max="100" />
            <display x="206" y="112" color="blue">
                <scale min="0" max="100" />
            </display>
        </aux>
        <aux name="E_Depletion_Normal">
            <eqn>.1</eqn>
            <display x="1010" y="80" color="blue" label_angle="327" />
        </aux>
        <aux name="EL_Regeneration_Normal">
            <eqn>.25</eqn>
            <display x="628" y="85" color="blue" label_angle="251" />
        </aux>
        <aux name="GPA">
            <eqn>Total_Points_Received/Total_Assignments_Completed</eqn>
            <scale min="0" max="100" />
            <display x="867" y="435" color="blue">
                <scale min="0" max="100" />
            </display>
        </aux>
        <aux name="HAA_Ratio">
            <eqn>Hours_Allocated_Per_Assignment/Reference_HAA</eqn>
            <display x="931" y="567" color="blue" />
        </aux>
        <aux name="Hours_Worked_Per_Week">
            <eqn>min(Requested_Hours_Worked_Per_Week,Limit_on_Hours_Per_Week)</eqn>
            <scale min="0" max="100" />
            <display x="260" y="462" color="blue" label_angle="292">
                <scale min="0" max="100" />
            </display>
        </aux>
        <aux name="Limit_on_Hours_Per_Week">
            <eqn>80</eqn>
            <display x="72" y="47" color="blue" />
        </aux>
        <aux name="Normal_Completion_Time">
            <eqn>100</eqn>
            <display x="207" y="45" color="blue" />
        </aux>
        <aux name="Normal_Time_Per_Assignment">
            <eqn>100</eqn>
            <display x="79" y="107" color="blue" />
        </aux>
        <aux name="Points_Per_Assignment">
            <eqn>100*Effect_of_HAA_on_Grades*Effect_of_Energy_on_Grades</eqn>
            <scale min="0" max="100" />
            <display x="695" y="594" color="blue">
                <scale min="0" max="100" />
            </display>
        </aux>
        <aux name="Reference_Assignment_Rate">
            <eqn>6</eqn>
            <display x="80" y="167" color="blue" />
        </aux>
        <aux name="Requested_Hours_Worked_Per_Week">
            <eqn>Daily_Study_Time*6.3</eqn>
            <display x="117" y="465" color="blue" label_side="top" label_angle="43" />
        </aux>
        <aux name="Reference_HAA">
            <eqn>7</eqn>
            <display x="910" y="523" color="blue" label_side="top" label_angle="127" />
        </aux>
        <aux name="Time_to_adjust_HAA">
            <eqn>1</eqn>
            <display x="432" y="207" color="blue" />
        </aux>
        <aux name="Effect_of_EL_on_Production">
            <eqn>Energy_Level</eqn>
            <gf>
                <xscale min="0" max="1" />
                <yscale min="0" max="1" />
                <ypts>0,0.10000000000000001,0.20000000000000001,0.29999999999999999,0.40000000000000002,0.5,0.59999999999999998,0.69999999999999996,0.80000000000000004,0.90000000000000002,1</ypts>
            </gf>
            <display x="363" y="502" color="blue" />
        </aux>
        <aux name="Effect_of_High_EL_on_Regeneration">
            <eqn>Energy_Level</eqn>
            <gf>
                <xscale min="0.5" max="1" />
                <yscale min="0" max="1" />
                <ypts>1,1,1,1,1,0.97499999999999998,0.94499999999999995,0.875,0.79000000000000004,0.59499999999999997,0</ypts>
            </gf>
            <display x="755" y="156" color="blue" />
        </aux>
        <aux name="Effect_of_Hours_Worked_on_Regeneration">
            <eqn>Hours_Worked_Per_Week</eqn>
            <gf>
                <xscale min="0" max="60" />
                <yscale min="0" max="1.5" />
                <ypts>1.2450000000000001,1.1924999999999999,1.0800000000000001,0.90000000000000002,0.72750000000000004,0.56999999999999995,0.33750000000000002,0.1575,0.10000000000000001,0.10000000000000001,0.105</ypts>
            </gf>
            <display x="662" y="195" color="blue" label_angle="240" />
        </aux>
        <aux name="Effect_of_Low_EL_on_Depletion">
            <eqn>Energy_Level</eqn>
            <gf>
                <xscale min="0" max="0.5" />
                <yscale min="0" max="1" />
                <ypts>0,0.40000000000000002,0.69999999999999996,0.90000000000000002,1,1,1,1,1,1,1</ypts>
            </gf>
            <display x="866" y="132" color="blue" label_angle="263" />
        </aux>
        <aux name="Effect_of_Hours_Worked_on_Depletion">
            <eqn>Hours_Worked_Per_Week</eqn>
            <gf>
                <xscale min="0" max="60" />
                <yscale min="0" max="4" />
                <ypts>0.40000000000000002,0.40000000000000002,0.40000000000000002,0.40000000000000002,0.41999999999999998,0.44,0.57999999999999996,0.93999999999999995,1.5600000000000001,2.1000000000000001,3.1800000000000002</ypts>
            </gf>
            <display x="882" y="209" color="blue" label_angle="267" />
        </aux>
        <aux name="Effect_of_Grades_on_EL_Depletion">
            <eqn>Grade_Satisfaction</eqn>
            <gf>
                <xscale min="0" max="2.5" />
                <yscale min="0" max="4" />
                <ypts>3.5,2.5,1.8999999999999999,1.3999999999999999,1,0.80000000000000004,0.69999999999999996,0.63,0.59999999999999998,0.59999999999999998,0.59999999999999998</ypts>
            </gf>
            <display x="1014" y="138" color="blue" />
        </aux>
        <aux name="Actual_Desired_HAA">
            <eqn>if Time_Per_Assignment = 0 &#x0D;then 1e-7&#x0D;else Time_Per_Assignment</eqn>
            <display x="312" y="220" color="blue" />
        </aux>
        <aux name="Effect_of_HAA_on_Grades">
            <eqn>HAA_Ratio</eqn>
            <gf>
                <xscale min="0" max="2" />
                <yscale min="0" max="1" />
                <ypts>0,0.40000000000000002,0.75,0.87,0.94999999999999996,1,1,1,1,1,1</ypts>
            </gf>
            <display x="818" y="591" color="blue" label_angle="292" />
        </aux>
        <aux name="Effect_of_Energy_on_Grades">
            <eqn>Energy_Level</eqn>
            <gf>
                <xscale min="0" max="2" />
                <yscale min="0" max="1" />
                <ypts>0,0.25,0.59999999999999998,0.80000000000000004,0.96999999999999997,1,1,1,1,1,1</ypts>
            </gf>
            <display x="836" y="654" color="blue" label_angle="251" />
        </aux>
        <aux name="Time_Per_Assignment">
            <eqn>4</eqn>
            <display x="201" y="169" color="blue" />
        </aux>
        <aux name="Daily_Study_Time">
            <eqn>4</eqn>
            <display x="62" y="474" color="blue" />
        </aux>
