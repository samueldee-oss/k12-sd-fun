                <graph type="time_series" title="Untitled" background="#FFFFC9" show_grid="true" plot_numbers="true" isee:use_five_segments="false" hide_detail="true" comparative="true" cleared="true" time_precision="2" from="0" to="104">
                    <plot index="0" pen_width="3" color="blue" precision="1" show_y_axis="true">
                        <entity name="MY___SAVINGS" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="695" y="1332" width="26" height="22" color="#008F44" label_side="bottom" label="Graph 2" type="graph" icon_of="25" />
            <stacked_container height="291" width="328" uid="26">
                <table font-size="9" background="#E0E0E0" column_width="88" orientation="vertical" interval="1" cleared="true" date_time="2010-12-21T13:31:27Z">
                    <title>Untitled Table</title>
