<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" level="3" xmlns="http://www.systemdynamics.org/XMILE" xmlns:isee="http://iseesystems.com/XMILE">
    <header>
        <smile version="1.0" namespace="std, isee">
            <uses_arrays>1</uses_arrays>
        </smile>
        <name>Inflfeed.v5</name>
        <uuid>d2d79817-dc02-42f6-ad32-91c227aa4994</uuid>
        <vendor>isee systems, inc.</vendor>
        <product version="10.1.2" isee:saved_by_v1="false" lang="en">iThink</product>
    </header>
    <style>
        <model font-family="Arial" font-size="9" />
        <interface font-family="Arial" font-size="9" />
    </style>
    <sim_specs method="RK4" time_units="Days" isee:pause_after_rates="false" isee:instantaneous_flows="false">
        <start>1</start>
        <stop>60</stop>
        <dt>0.25</dt>
        <isee:analyze_mode>false</isee:analyze_mode>
    </sim_specs>
    <dimensions>
        <dim name="Dim_Name_1" size="1" />
    </dimensions>
    <model_units />
    <isee:prefs last_model="false" layer="map" grid_width="20" grid_height="50" divide_by_zero_alert="true" link_high_level_map="true" show_module_prefix="true">
        <isee:window width="621" height="382" />
        <isee:security />
        <isee:print_setup width="552" height="728" />
    </isee:prefs>
    <isee:equation_prefs order_by="sector" show_documentation="true" />
    <model>
        <aux name="become_immune`">
            <eqn> { Place right hand side of equation here... }</eqn>
            <display x="182" y="72" color="white" label_side="top" label_angle="77" />
        </aux>
        <aux name="births">
            <eqn> { Place right hand side of equation here... }</eqn>
            <display x="104" y="213" color="white" />
        </aux>
        <aux name="birth_rate">
            <eqn> { Place right hand side of equation here... }</eqn>
            <display x="71" y="257" color="white" />
        </aux>
        <aux name="total_population">
            <eqn> { Place right hand side of equation here... }</eqn>
            <display x="142" y="258" color="white" />
        </aux>
        <flow name="become_vaccinated">
            <eqn> { Place right hand side of equation here... }</eqn>
            <non_negative />
            <display x="484" y="170" color="white" label_angle="298">
                <pts>
                    <pt x="420" y="170" />
                    <pt x="548" y="170" />
                </pts>
            </display>
        </flow>
        <flow name="death_2">
            <eqn> { Place right hand side of equation here... }</eqn>
            <non_negative />
            <display x="567" y="226" color="white" label_side="right" label_angle="305">
                <pts>
                    <pt x="567" y="185" />
                    <pt x="567" y="268" />
                </pts>
            </display>
        </flow>
        <flow name="death">
            <eqn> { Place right hand side of equation here... }</eqn>
            <non_negative />
            <display x="244" y="474" color="white" label_angle="286">
                <pts>
                    <pt x="244" y="432" />
                    <pt x="244" y="517" />
                </pts>
            </display>
        </flow>
        <stock name="Infected">
            <eqn> { Place initial value here... }</eqn>
            <inflow>people_also_get_sick</inflow>
            <non_negative />
            <display x="772" y="173" color="white" />
        </stock>
        <flow name="people_also_get_sick">
            <eqn> { Place right hand side of equation here... }</eqn>
            <non_negative />
            <display x="670" y="171" color="white">
                <pts>
                    <pt x="588" y="171" />
                    <pt x="752" y="171" />
                </pts>
            </display>
        </flow>
        <aux name="prob_that_person_is_uninfected">
            <eqn> { Place right hand side of equation here... }</eqn>
            <display x="682" y="129" color="white" label_side="top" />
        </aux>
        <stock name="Infected`">
            <eqn> { Place initial value here... }</eqn>
            <inflow>people_get_sick</inflow>
            <non_negative />
            <display x="430" y="420" color="white" />
        </stock>
        <flow name="people_get_sick">
            <eqn> { Place right hand side of equation here... }</eqn>
            <non_negative />
            <display x="335" y="418" color="white" label_side="top">
                <pts>
                    <pt x="261" y="418" />
                    <pt x="410" y="418" />
                </pts>
            </display>
        </flow>
        <aux name="prob_that_pers_is_uninfected">
            <eqn> { Place right hand side of equation here... }</eqn>
            <display x="348" y="496" color="white" />
        </aux>
        <stock name="Ill">
            <eqn> { Place initial value here... }</eqn>
            <inflow>show_symptons</inflow>
            <outflow>become_immune</outflow>
            <outflow>death_4</outflow>
            <outflow>die</outflow>
            <non_negative />
            <display x="750" y="450" color="white" label_angle="119" />
        </stock>
        <flow name="show_symptons">
            <eqn> { Place right hand side of equation here... }</eqn>
            <non_negative />
            <display x="684" y="453" color="white" label_side="top" label_angle="93">
                <pts>
                    <pt x="638" y="453" />
                    <pt x="730" y="453" />
                </pts>
            </display>
        </flow>
        <stock name="Immune">
            <eqn> { Place initial value here... }</eqn>
            <inflow>become_immune</inflow>
            <outflow>death_5</outflow>
            <non_negative />
            <display x="754" y="557" color="white" label_side="bottom" />
        </stock>
        <flow name="become_immune">
            <eqn> { Place right hand side of equation here... }</eqn>
            <non_negative />
            <display x="752" y="503" color="white" label_side="right" label_angle="344">
                <pts>
                    <pt x="752" y="465" />
                    <pt x="752" y="542" />
                </pts>
            </display>
        </flow>
        <flow name="death_5">
            <eqn> { Place right hand side of equation here... }</eqn>
            <non_negative />
            <display x="691" y="559" color="white">
                <pts>
                    <pt x="734" y="559" />
                    <pt x="649" y="559" />
                </pts>
            </display>
        </flow>
        <flow name="death_4">
            <eqn> { Place right hand side of equation here... }</eqn>
            <non_negative />
            <display x="754" y="383" color="white" label_side="top" label_angle="47">
                <pts>
                    <pt x="754" y="435" />
                    <pt x="754" y="332" />
                </pts>
            </display>
        </flow>
        <stock name="Dead_from_Disease">
            <eqn> { Place initial value here... }</eqn>
            <inflow>die</inflow>
            <non_negative />
            <display x="888" y="450" color="white" />
        </stock>
        <flow name="die">
            <eqn> { Place right hand side of equation here... }</eqn>
            <non_negative />
            <display x="819" y="450" color="white">
                <pts>
                    <pt x="770" y="450" />
                    <pt x="868" y="450" />
                </pts>
            </display>
        </flow>
        <stock name="Initial_and_New">
            <doc>This stock represents the initial population of the United States and new additions through births and people who haven&apos;t become immune.</doc>
            <eqn>270000000</eqn>
            <inflow>new</inflow>
            <non_negative />
            <display x="188" y="150" color="black" />
        </stock>
        <flow name="new">
            <doc>This inflow represents the new people who are being added to the initial and new population.</doc>
            <eqn>non_immune_people+births</eqn>
            <non_negative />
            <display x="124" y="149" color="black">
                <pts>
                    <pt x="80" y="149" />
                    <pt x="168" y="149" />
                </pts>
            </display>
        </flow>
        <aux name="non_immune_people">
            <doc>This represents the people who haven&apos;t become immune to the particular strain of influenza virus.</doc>
            <eqn>1-become_immune`</eqn>
            <display x="133" y="100" color="black" label_side="left" label_angle="167" />
        </aux>
        <stock name="Initial_and_New``">
            <doc>This stock represents the initial population of the United States and new additions through births and people who haven&apos;t become immune.</doc>
            <eqn>270000000</eqn>
            <outflow>become_vaccinated</outflow>
            <non_negative />
            <display x="400" y="173" color="black" label_angle="112" />
        </stock>
        <stock name="Non_Vaccinated">
            <doc>This stock represents the people in the United States who have chosen not become vaccinated against the influenza virus and are, therefore, susceptible.</doc>
            <eqn>0</eqn>
            <inflow>not_vaccinated</inflow>
            <outflow>death</outflow>
            <outflow>people_get_sick</outflow>
            <non_negative />
            <display x="241" y="417" color="black" />
        </stock>
        <flow name="not_vaccinated">
            <doc>This flow represents the people choosing not to become vaccinated.</doc>
            <eqn>Initial_and_New`*non_vacc_perc_2</eqn>
            <non_negative />
            <display x="165" y="416" color="black" label_side="top" label_angle="82">
                <pts>
                    <pt x="109" y="416" />
                    <pt x="221" y="416" />
                </pts>
            </display>
        </flow>
        <stock name="Initial_and_New`">
            <doc>This stock represents the initial population of the United States and new additions through births and people who haven&apos;t become immune.</doc>
            <eqn>270000000</eqn>
            <outflow>not_vaccinated</outflow>
            <non_negative />
            <display x="89" y="414" color="black" label_angle="99" />
        </stock>
        <stock name="Vaccinated`">
            <doc>This stock represents the people in the United States who have chosen to  become vaccinated.</doc>
            <eqn>0</eqn>
            <inflow>become_vaccinated</inflow>
            <outflow>success</outflow>
            <outflow>death_2</outflow>
            <outflow>people_also_get_sick</outflow>
            <non_negative />
            <display x="568" y="170" color="black" label_side="left" label_angle="154" />
        </stock>
        <stock name="Unsucseptible">
            <doc>This stock represents the people with whom the vaccine has worked and are now at no risk of being infected.</doc>
            <eqn>0</eqn>
            <inflow>success</inflow>
            <non_negative />
            <display x="571" y="65" color="black" label_angle="81" />
        </stock>
        <flow name="success">
            <doc>This flow represents the vaccinated people with whom the vaccine has worked.</doc>
            <eqn>(1-fault_rate)*Vaccinated`</eqn>
            <non_negative />
            <display x="568" y="117" color="black" label_side="left">
                <pts>
                    <pt x="568" y="155" />
                    <pt x="568" y="80" />
                </pts>
            </display>
        </flow>
        <stock name="Infected``">
            <doc>This stock represents people who are infected with the influenza virus, but aren&apos;t yet showing symptoms.</doc>
            <eqn>1</eqn>
            <outflow>death_3</outflow>
            <outflow>show_symptons</outflow>
            <non_negative />
            <display x="618" y="451" color="black" label_side="left" />
        </stock>
        <flow name="death_3">
            <doc>This outflow represents the people dying for reasons unrelated to the influenza virus.</doc>
            <eqn>death_rate_2*Infected``</eqn>
            <non_negative />
            <display x="621" y="384" color="black" label_side="top" label_angle="62">
                <pts>
                    <pt x="621" y="436" />
                    <pt x="621" y="332" />
                </pts>
            </display>
        </flow>
        <display page_width="552" page_height="728" page_cols="5" page_rows="3" isee:converter_size="large" interval="5" scroll_y="303">
