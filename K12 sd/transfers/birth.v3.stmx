<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" level="3" xmlns="http://www.systemdynamics.org/XMILE" xmlns:isee="http://iseesystems.com/XMILE">
    <header>
        <smile version="1.0" namespace="std, isee">
            <uses_arrays>1</uses_arrays>
        </smile>
        <name>birth.v3</name>
        <uuid>a81787fe-3b07-4d9f-9e72-5c4c7dacfb95</uuid>
        <vendor>isee systems, inc.</vendor>
        <product version="10.1.2" isee:saved_by_v1="false" lang="en">iThink</product>
    </header>
    <style>
        <model font-family="Arial" font-size="9" />
        <interface font-family="Arial" font-size="9" />
    </style>
    <sim_specs method="Euler" time_units="Hours" isee:pause_after_rates="false" isee:instantaneous_flows="false">
        <start>0</start>
        <stop>25</stop>
        <dt>0.25</dt>
        <isee:analyze_mode>false</isee:analyze_mode>
    </sim_specs>
    <dimensions>
        <dim name="Dim_Name_1" size="1" />
    </dimensions>
    <model_units />
    <isee:prefs last_model="true" layer="model" grid_width="20" grid_height="50" divide_by_zero_alert="true" hide_taskbar="true" show_module_prefix="true">
        <isee:window width="1366" height="685" />
        <isee:security />
        <isee:print_setup width="595" height="775" />
    </isee:prefs>
    <isee:equation_prefs order_by="sector" show_documentation="true" />
    <model>
        <stock name="population">
            <eqn>100</eqn>
            <scale min="0" max="1000" />
            <inflow>births</inflow>
            <display x="274" y="88" color="blue" label_side="bottom">
                <scale min="0" max="1000" />
            </display>
        </stock>
        <flow name="births">
            <eqn>birth_rate*population</eqn>
            <non_negative />
            <display x="206" y="89" color="blue" label_side="top">
                <pts>
                    <pt x="159" y="89" />
                    <pt x="254" y="89" />
                </pts>
            </display>
        </flow>
        <aux name="birth_rate">
            <eqn>.1</eqn>
            <display x="149" y="139" color="blue" />
        </aux>
        <aux name="normalized_population">
            <eqn>population/INIT(population)</eqn>
            <scale min="0" max="10" />
            <display x="275" y="37" color="blue" label_side="top">
                <scale min="0" max="10" />
            </display>
        </aux>
        <display page_width="595" page_height="775" page_order="column" isee:converter_size="medium">
            <connector x="255" y="105" uid="0">
                <from>population</from>
                <to>births</to>
                <polarity>-</polarity>
            </connector>
            <connector x="154" y="131" uid="1">
                <from>birth_rate</from>
                <to>births</to>
                <polarity>-</polarity>
            </connector>
            <connector x="274" y="73" uid="2">
                <from>population</from>
                <to>normalized_population</to>
                <polarity>-</polarity>
            </connector>
            <stacked_container x="7" y="172" height="270" width="474" uid="3">
                <graph type="time_series" title="Untitled Graph" background="white" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-07T15:39:16Z" cleared="true" time_precision="0" from="0" to="25">
                    <plot index="0" pen_width="1" color="red" precision="1" show_y_axis="true">
                        <entity name="normalized_population" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="285" y="252" width="26" height="22" color="#0CA0FF" label_side="bottom" label="Graph 1" type="graph" icon_of="3" />
            <style font-family="Arial" font-size="9" />
        </display>
        <interface page_order="column" page_cols="0" page_rows="0" page_width="788" page_height="528" home_page="0">
            <simulation_delay>0.1</simulation_delay>
            <style font-family="Arial" font-size="9" />
        </interface>
        <style font-family="Arial" font-size="9" />
    </model>
</xmile>
