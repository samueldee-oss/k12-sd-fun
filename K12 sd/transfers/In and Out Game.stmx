<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" level="3" xmlns="http://www.systemdynamics.org/XMILE" xmlns:isee="http://iseesystems.com/XMILE">
    <header>
        <smile version="1.0" namespace="std, isee">
            <uses_arrays>1</uses_arrays>
        </smile>
        <name>In and Out Game</name>
        <uuid>996a19fe-4db2-4ed4-a3ed-1895e6fc245b</uuid>
        <vendor>isee systems, inc.</vendor>
        <product version="10.1.2" isee:saved_by_v1="false" lang="en">iThink</product>
    </header>
    <style>
        <model font-family="Georgia" font-size="10" />
        <interface font-family="Arial" font-size="12" />
    </style>
    <sim_specs method="Euler" time_units="Rounds" isee:pause_after_rates="false" isee:instantaneous_flows="false">
        <start>0</start>
        <stop>20</stop>
        <dt>1</dt>
    </sim_specs>
    <dimensions>
        <dim name="Dim_Name_1" size="1" />
    </dimensions>
    <model_units />
    <isee:prefs last_model="false" layer="interface" grid_width="20" grid_height="50" divide_by_zero_alert="true" hide_taskbar="true" show_module_prefix="true">
        <isee:window width="1009" height="659" />
        <isee:security />
        <isee:print_setup width="576" height="768" />
    </isee:prefs>
    <isee:equation_prefs order_by="module" show_pages="true" />
    <model>
        <stock name="Players\nin_the_Stock">
            <eqn>1</eqn>
            <inflow>Players__going_in</inflow>
            <outflow>Players__going_out</outflow>
            <non_negative />
            <display x="294" y="223" color="blue" />
        </stock>
        <flow name="Players_\ngoing_in">
            <eqn>2</eqn>
            <non_negative />
            <display x="197" y="222" color="blue">
                <pts>
                    <pt x="123" y="222" />
                    <pt x="272" y="222" />
                </pts>
            </display>
        </flow>
        <flow name="Players_\ngoing_out">
            <eqn>1</eqn>
            <non_negative />
            <display x="400" y="224" color="blue">
                <pts>
                    <pt x="316" y="224" />
                    <pt x="484" y="224" />
                </pts>
            </display>
        </flow>
        <display show_pages="true" page_width="576" page_height="768" isee:converter_size="medium" zoom="150" isee:animate_flows="true" isee:animate_stocks="true" isee:animate_converters="true" interval="DT">
            <style font-family="Georgia" font-size="10" />
        </display>
        <interface show_pages="true" page_cols="4" page_rows="4" page_width="1268" page_height="952" home_page="2">
            <simulation_delay>0.1</simulation_delay>
            <stacked_container x="9" y="36" height="297" width="518" uid="0">
                <graph type="time_series" title="Rounds" background="#FFFFC9" show_grid="true" plot_numbers="true" isee:use_five_segments="false" hide_detail="true" cleared="true" time_precision="0" from="0" to="20">
                    <plot index="0" pen_width="3" color="blue" precision="1" show_y_axis="true">
                        <scale min="0" max="40" />
                        <entity name="Players_in_the_Stock" />
                    </plot>
                </graph>
                <graph type="time_series" title="Rounds" background="#FFFFC9" show_grid="true" plot_numbers="true" isee:use_five_segments="false" hide_detail="true" cleared="true" time_precision="2" from="0" to="20">
                    <plot index="0" pen_width="3" color="blue" precision="1" show_y_axis="true">
                        <scale min="0" max="10" />
                        <entity name="Players__going_in" />
                    </plot>
                    <plot index="1" pen_width="3" color="red" precision="1" show_y_axis="true">
                        <scale min="0" max="10" />
                        <entity name="Players__going_out" />
