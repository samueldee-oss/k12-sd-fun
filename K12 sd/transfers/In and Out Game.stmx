                <graph type="time_series" title="Challenge 1" background="#FFFFC9" show_grid="true" plot_numbers="true" isee:use_five_segments="false" hide_detail="true" cleared="true" time_precision="2" from="0" to="20">
                    <plot index="0" pen_width="1" color="blue" precision="1" show_y_axis="true">
                        <scale min="0" max="40" />
                        <entity name="Players_in_the_Stock" />
                    </plot>
