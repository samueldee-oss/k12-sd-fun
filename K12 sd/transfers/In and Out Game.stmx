            <pad_icon x="150" y="900" width="26" height="22" color="#008F44" label_side="bottom" label="Graph 2" type="graph" icon_of="1" />
            <stacked_container x="492" y="818" height="261" width="455" uid="2">
                <graph type="time_series" title="Challenge 2" background="#FFFFC9" show_grid="true" plot_numbers="true" isee:use_five_segments="false" hide_detail="true" cleared="true" time_precision="2" from="0" to="20">
                    <plot index="0" pen_width="1" color="blue" precision="1" show_y_axis="true">
