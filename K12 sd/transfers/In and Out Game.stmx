            <pad_icon x="602" y="978" width="26" height="22" color="#008F44" label_side="bottom" label="Graph 3" type="graph" icon_of="2" />
            <stacked_container x="13" y="1096" height="259" width="453" uid="3">
                <graph type="time_series" title="Challenge 3" background="#FFFFC9" show_grid="true" plot_numbers="true" isee:use_five_segments="false" hide_detail="true" cleared="true" time_precision="2" from="0" to="20">
                    <plot index="0" pen_width="1" color="blue" precision="1" show_y_axis="true">
                        <scale min="0" max="40" />
                        <entity name="Players_in_the_Stock" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="187" y="1185" width="26" height="22" color="#008F44" label_side="bottom" label="Graph 4" type="graph" icon_of="3" />
            <stacked_container x="491" y="1095" height="261" width="456" uid="4">
                <graph type="time_series" title="Challenge 4" background="#FFFFC9" show_grid="true" plot_numbers="true" isee:use_five_segments="false" hide_detail="true" cleared="true" time_precision="2" from="0" to="20">
                    <plot index="0" pen_width="1" color="blue" precision="1" show_y_axis="true">
                        <scale min="0" max="40" />
                        <entity name="Players_in_the_Stock" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="612" y="1177" width="26" height="22" color="#008F44" label_side="bottom" label="Graph 5" type="graph" icon_of="4" />
            <stacked_container x="555" y="43" height="529" width="473" uid="5">
                <table font-size="12" background="#FFFFC9" column_width="129" orientation="vertical" interval="DT" cleared="true" date_time="2010-11-22T14:17:54Z">
                    <title>In and Out Game</title>
                    <item type="time" color="black" precision="max" width="58" />
                    <item color="black" precision="1" delimit_000s="true" index="0">
                        <entity name="Players_in_the_Stock" />
                    </item>
                    <item color="black" precision="1" delimit_000s="true" index="1">
                        <entity name="Players__going_in" />
                    </item>
                    <item color="black" precision="1" delimit_000s="true" index="2">
                        <entity name="Players__going_out" />
                    </item>
                </table>
            </stacked_container>
            <pad_icon x="799" y="140" width="26" height="22" color="#008F44" label_side="bottom" label="Table 1" type="table" icon_of="5" />
            <knob x="83" y="453" show_name="false" color="black" width="83" height="91" min="0" max="20" precision="1">
                <entity name="Players_in_the_Stock" value="7" />
            </knob>
            <slider x="278" y="411" isee:navigate_to="true" color="#55CB56" width="197" height="43" min="0" max="5" precision="1">
                <entity name="Players__going_in" value="2" />
            </slider>
            <slider x="281" y="494" color="red" width="197" height="43" min="0" max="5" precision="1">
                <entity name="Players__going_out" />
            </slider>
            <text_box x="15" y="356" uid="6" color="black" font-family="Arial" font-size="12" padding="5" border-style="solid" border-width="thin" width="146" height="182">Starting number of&#x0D;         players</text_box>
            <text_box x="171" y="357" uid="7" color="black" font-family="Arial" font-size="12" padding="5" border-style="solid" border-width="thin" width="215" height="182" />
            <button x="412" y="384" width="98" height="47" uid="8" appearance="opaque" background="black" color="white" style="rounded" label="Run" font-family="Arial" font-size="12" text-align="center">
                <menu_action>run</menu_action>
            </button>
            <text_box x="1554" y="125" uid="9" color="black" font-family="Arial" font-size="12" padding="5" border-style="solid" border-width="thin" width="516" height="349">&#x0D;THE IN AND OUT GAME&#x0D;&#x0D;This simple activity tracks the number of players in the &quot;stock&quot; of a game.  Rules specify how many players enter the stock each round (inflow) and how many exit the stock (outflow).  As the game proceeds, the number of players in the stock can grow, remain constant, or decrease, depending on the rules.  &#x0D;&#x0D;The flows determine if and how the stock will change.  Once the rules are set, they don&apos;t change until a new game is begun.  The graphs are always straight lines because the inflows and outflows are constant values.&#x0D;&#x0D;Click the button below to play The In and Out Game.  You will set the rules of the game and have the computer run a simulated game.  There are some challenge graphs for you to try to match if you wish.&#x0D;&#x0D;You can click the tabs on the left of the screen to see a stock and flow map, model, or the equations of The In and Out Game.  </text_box>
            <button x="1754" y="517" width="132" height="57" uid="10" appearance="opaque" background="black" color="white" style="square" label="Play The In and Out Game" font-family="Arial" font-size="12" text-align="center">
                <link target="interface" x="0" y="0" />
            </button>
            <button x="414" y="452" width="95" height="52" uid="11" appearance="opaque" background="black" color="white" style="rounded" label="Restore Graphs &amp; Tables" font-family="Arial" font-size="12" text-align="center">
                <menu_action>restore_graphs_tables</menu_action>
            </button>
            <text_box x="183" y="1725" uid="12" color="black" font-family="Times New Roman" font-size="12" padding="5" border-style="double" border-width="thin" width="512" height="230" />
            <button x="411" y="527" width="103" height="48" uid="13" appearance="opaque" background="black" color="white" style="rounded" label="View Challenges" font-family="Arial" font-size="12" text-align="center">
                <link target="interface" x="0" y="720" />
            </button>
            <button x="461" y="738" width="122" height="49" uid="14" appearance="opaque" background="black" color="white" style="rounded" label="To Sliders and Graph" font-family="Arial" font-size="12" text-align="center">
                <link target="interface" x="0" y="0" />
            </button>
            <text_box x="30" y="734" uid="15" color="black" font-family="Arial" font-size="12" padding="5" border-style="solid" border-width="thin" width="403" height="61">Challenge: Use the sliders to reproduce each of the graphs below.</text_box>
            <button x="194" y="577" width="80" height="64" uid="16" appearance="opaque" background="black" color="white" style="square" icon="5">
