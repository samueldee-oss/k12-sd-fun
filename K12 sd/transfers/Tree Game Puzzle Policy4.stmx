<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" level="3" xmlns="http://www.systemdynamics.org/XMILE" xmlns:isee="http://iseesystems.com/XMILE">
    <header>
        <smile version="1.0" namespace="std, isee">
            <uses_arrays>1</uses_arrays>
        </smile>
        <name>Tree Game Puzzle Policy4</name>
        <uuid>04c73f63-d23f-4e77-91fd-6378a38a518b</uuid>
        <vendor>isee systems, inc.</vendor>
        <product version="10.1.2" isee:saved_by_v1="false" lang="en">iThink</product>
    </header>
    <style>
        <model font-family="Arial" font-size="14" />
        <interface font-family="Arial" font-size="9" />
    </style>
    <sim_specs method="Euler" time_units="Years" isee:pause_after_rates="false" isee:instantaneous_flows="false">
        <start>0</start>
        <stop>20</stop>
        <dt>1</dt>
    </sim_specs>
    <dimensions>
        <dim name="Dim_Name_1" size="1" />
    </dimensions>
    <model_units />
    <isee:prefs last_model="true" layer="interface" grid_width="20" grid_height="50" divide_by_zero_alert="true" hide_taskbar="true" show_module_prefix="true">
        <isee:window width="1094" height="658" />
        <isee:security />
        <isee:print_setup width="576" height="768" />
    </isee:prefs>
    <isee:equation_prefs order_by="module" />
    <model>
        <stock name="Trees_on_Farm">
            <eqn>120</eqn>
            <inflow>Planting_Trees</inflow>
            <outflow>Cutting_Trees</outflow>
            <non_negative />
            <display x="248" y="185" color="blue" />
        </stock>
        <flow name="Planting_Trees">
            <eqn>Number_of_Trees_to_Plant</eqn>
            <non_negative />
            <display x="154" y="181" color="blue" label_angle="223">
                <pts>
                    <pt x="83" y="181" />
                    <pt x="226" y="181" />
                </pts>
            </display>
        </flow>
        <flow name="Cutting_Trees">
            <eqn>Number_of_Trees_to_Cut</eqn>
            <non_negative />
            <display x="350" y="180" color="blue" label_angle="299">
                <pts>
                    <pt x="270" y="180" />
                    <pt x="430" y="180" />
                </pts>
            </display>
        </flow>
        <stock name="Number\nof_Trees_to_Plant">
            <eqn>1</eqn>
            <inflow>Increase_in_Planting</inflow>
            <non_negative />
            <display x="215" y="335" color="blue" />
        </stock>
        <stock name="Number\nof_Trees_to_Cut">
            <eqn>2</eqn>
            <inflow>Increase_in__Cutting</inflow>
            <non_negative />
            <display x="452" y="330" color="blue" />
        </stock>
        <flow name="Increase_in\nPlanting">
            <eqn>Number_of_Trees_to_Plant*Planting_Growth__Fraction</eqn>
            <non_negative />
            <display x="136" y="332" color="blue">
                <pts>
                    <pt x="80" y="332" />
                    <pt x="193" y="332" />
                </pts>
            </display>
        </flow>
        <flow name="Increase_in_\nCutting">
            <eqn>Number_of_Trees_to_Cut*Cutting_Growth_Fraction</eqn>
            <non_negative />
            <display x="391" y="339" color="blue">
                <pts>
                    <pt x="352" y="339" />
                    <pt x="430" y="339" />
                </pts>
            </display>
        </flow>
        <stock name="Total_Sold">
            <eqn>0</eqn>
            <inflow>Cutting_Trees</inflow>
            <non_negative />
            <display x="452" y="184" color="blue" />
        </stock>
        <aux name="Planting_Growth_\nFraction">
            <eqn>0</eqn>
            <display x="71" y="408" color="blue" />
        </aux>
        <aux name="Cutting_Growth\nFraction">
            <eqn>.1</eqn>
            <display x="462" y="411" color="blue" />
        </aux>
        <display page_width="576" page_height="768" isee:converter_size="medium" isee:animate_flows="true" isee:animate_stocks="true" isee:animate_converters="true" interval="DT">
            <connector x="198" y="318" uid="0">
                <from>Number_of_Trees_to_Plant</from>
                <to>Increase_in_Planting</to>
            </connector>
            <connector x="203" y="319" uid="1">
                <from>Number_of_Trees_to_Plant</from>
                <to>Planting_Trees</to>
            </connector>
            <connector x="440" y="313" uid="2">
                <from>Number_of_Trees_to_Cut</from>
                <to>Cutting_Trees</to>
            </connector>
            <connector x="430" y="313" uid="3">
                <from>Number_of_Trees_to_Cut</from>
                <to>Increase_in__Cutting</to>
            </connector>
            <connector x="75" y="399" uid="4">
                <from>Planting_Growth__Fraction</from>
                <to>Increase_in_Planting</to>
            </connector>
            <connector x="460" y="402" uid="5">
                <from>Cutting_Growth_Fraction</from>
                <to>Increase_in__Cutting</to>
            </connector>
            <style font-family="Arial" font-size="14" />
        </display>
        <interface show_pages="true" page_cols="2" page_rows="2" page_width="1012" page_height="696" scroll_y="696" home_page="3">
            <simulation_delay>0.1</simulation_delay>
            <stacked_container x="25" y="38" height="319" width="556" uid="6">
                <graph type="time_series" title="Untitled" background="#FFFFC9" show_grid="true" plot_numbers="true" isee:use_five_segments="false" hide_detail="true" cleared="true" time_precision="2" from="0" to="20">
                    <plot index="0" pen_width="3" color="blue" precision="1" show_y_axis="true">
                        <entity name="Trees_on_Farm" />
                    </plot>
                </graph>
                <graph type="time_series" title="Untitled" background="#FFFFC9" show_grid="true" plot_numbers="true" isee:use_five_segments="false" hide_detail="true" cleared="true" time_precision="2" from="0" to="20">
                    <plot index="0" pen_width="3" color="blue" precision="1" show_y_axis="true">
                        <entity name="Trees_on_Farm" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="233" y="128" width="26" height="22" color="#008F44" label_side="bottom" label="Graph 1" type="graph" icon_of="6" />
            <stacked_container x="608" y="37" height="322" width="389" uid="7">
                <table font-size="9" background="#FFFFC9" column_width="93" orientation="vertical" interval="DT" cleared="true" date_time="2010-12-08T13:53:00Z">
                    <title>Trees</title>
                    <item type="time" color="black" header-font-weight="bold" precision="1" width="47" />
                    <item color="black" header-font-weight="bold" precision="1" delimit_000s="true" index="0">
                        <entity name="Trees_on_Farm" />
                    </item>
                    <item color="black" header-font-weight="bold" precision="1" delimit_000s="true" index="1">
                        <entity name="Planting_Trees" />
                    </item>
                    <item color="black" header-font-weight="bold" precision="1" delimit_000s="true" index="2">
                        <entity name="Cutting_Trees" />
                    </item>
                </table>
            </stacked_container>
            <pad_icon x="903" y="161" width="26" height="22" color="#CACB30" label_side="bottom" label="Table 1" type="table" icon_of="7" />
            <slider x="150" y="412" color="#30CB32" width="197" height="43" min="0" max="1" precision="0.01">
                <entity name="Planting_Growth__Fraction" />
            </slider>
            <slider x="145" y="492" color="red" width="197" height="43" min="0" max="1" precision="0.01">
                <entity name="Cutting_Growth_Fraction" value="0.2" />
            </slider>
            <button x="334" y="440" width="68" height="45" uid="8" appearance="opaque" background="black" color="white" style="rounded" label="Restore Graphs &amp; Tables" font-family="Arial" font-size="12" text-align="center">
                <menu_action>restore_graphs_tables</menu_action>
            </button>
            <button x="335" y="381" width="65" height="34" uid="9" appearance="opaque" background="black" color="white" style="rounded" label="Run" font-family="Arial" font-size="12" text-align="center">
                <menu_action>run</menu_action>
            </button>
            <numeric_display precision="1" display_as="number" color="blue" show_name="true" retain_ending_value="true" uid="10" x="897" y="385">
                <entity name="Total_Sold" />
            </numeric_display>
            <text_box x="510" y="411" uid="11" color="black" font-family="Arial" font-size="12" padding="5" border-style="solid" border-width="thin" width="260" height="58">POLICY EXAMPLE 4:&#x0D;Planting: Exponential&#x0D;Cutting: Exponential</text_box>
            <button x="842" y="413" width="114" height="50" uid="12" appearance="opaque" background="black" color="white" style="rounded" label="Restore Numeric Displays" font-family="Arial" font-size="12" text-align="center">
                <menu_action>restore_numeric_displays</menu_action>
            </button>
            <button x="892" y="501" width="48" height="53" uid="13" appearance="opaque" background="black" color="white" style="rounded" icon="5">
                <link target="home_page" isee:default_icon="true" />
            </button>
            <text_box x="201" y="766" uid="14" color="black" font-family="Arial" font-size="12" padding="5" border-style="solid" border-width="thin" width="573" height="264">THE TREE GAME PUZZLE             POLICY 4&#x0D;&#x0D;POLICY EXAMPLE 4:&#x0D;Planting: Exponential&#x0D;Cutting:   Exponential&#x0D;&#x0D;Here&apos;s the situation:  One tree is being planted each year and two are being cut.   The manager can set the policy for the next 20 years - by what percentage should the planting and cutting numbers change each year.  The simulation is set to run with no change to planting policy so that one tree per year will be planted.  The cutting policy is set to increase at an annual rate of 20%.  Run the simulation to see what happens.&#x0D;&#x0D;Then it&apos;s your turn.  Experiment with the planting and cutting policies by changing the percentage of increase from the starting numbers of one new tree planted and two cut down.  Changing by a constant factor causes the change to be exponential.  The graph and table and will help you evaluate the results of your policy.</text_box>
            <button x="434" y="1066" width="97" height="46" uid="15" appearance="opaque" background="black" color="white" style="rounded" label="Try your policy" font-family="Arial" font-size="12" text-align="center">
                <link target="interface" x="0" y="0" />
            </button>
            <style font-family="Arial" font-size="9" />
        </interface>
        <style font-family="Arial" font-size="14" />
    </model>
</xmile>
