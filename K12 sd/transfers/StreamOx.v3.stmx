<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" level="3" xmlns="http://www.systemdynamics.org/XMILE" xmlns:isee="http://iseesystems.com/XMILE">
    <header>
        <smile version="1.0" namespace="std, isee">
            <uses_arrays>1</uses_arrays>
        </smile>
        <name>StreamOx.v3</name>
        <uuid>4d5bba8c-b7a2-47ac-81ed-6621ee294011</uuid>
        <vendor>isee systems, inc.</vendor>
        <product version="10.1.2" isee:saved_by_v1="false" lang="en">iThink</product>
    </header>
    <style>
        <model font-family="Arial" font-size="9" />
        <interface font-family="Arial" font-size="9" />
    </style>
    <sim_specs method="Euler" time_units="Time" isee:pause_after_rates="false" isee:instantaneous_flows="false">
        <start>0</start>
        <stop>100</stop>
        <dt>1</dt>
        <isee:analyze_mode>false</isee:analyze_mode>
    </sim_specs>
    <dimensions>
        <dim name="Dim_Name_1" size="1" />
    </dimensions>
    <model_units />
    <isee:prefs last_model="true" layer="model" grid_width="20" grid_height="50" divide_by_zero_alert="true" hide_taskbar="true" show_module_prefix="true">
        <isee:window width="1366" height="685" />
        <isee:security />
        <isee:print_setup width="595" height="775" />
    </isee:prefs>
    <isee:equation_prefs order_by="sector" />
    <model>
        <flow name="WasteinPPM">
            <eqn>GramsWasteIn*(time)/(Volume*1000)</eqn>
            <non_negative />
            <display x="137" y="233" color="blue">
                <pts>
                    <pt x="80" y="233" />
                    <pt x="194" y="233" />
                </pts>
            </display>
        </flow>
        <aux name="GramsWasteIn">
            <eqn>IF TIME = 1 THEN&#x0D;250000*1000&#x0D;ELSE&#x0D;0</eqn>
            <display x="68" y="293" color="blue" />
        </aux>
        <flow name="ReOx">
            <eqn>IF OxygenPPM=9.8 THEN&#x0D;0&#x0D;ELSE&#x0D;MIN((Volume/StreamHeight)*(9.8-OxygenPPM)*ReOxCoeff*(time-dt),9.8-OxygenPPM)</eqn>
            <non_negative />
            <display x="144" y="33" color="blue">
                <pts>
                    <pt x="84" y="33" />
                    <pt x="205" y="33" />
                </pts>
            </display>
        </flow>
        <aux name="StreamHeight">
            <eqn>20</eqn>
            <display x="55" y="89" color="blue" />
        </aux>
        <aux name="Volume">
            <eqn>Area*StreamHeight</eqn>
            <display x="125" y="120" color="blue" />
        </aux>
        <stock name="WastePPM">
            <eqn>0</eqn>
            <inflow>WasteinPPM</inflow>
            <outflow>WasteEaten</outflow>
            <non_negative />
            <display x="214" y="235" color="blue" />
        </stock>
        <stock name="OxygenPPM">
            <eqn>9.8</eqn>
            <scale min="0" max="9.8000000000000007" />
            <inflow>ReOx</inflow>
            <outflow>OxGone</outflow>
            <non_negative />
            <display x="225" y="34" color="blue">
                <scale min="0" max="9.8000000000000007" />
            </display>
        </stock>
        <flow name="WasteEaten">
            <eqn>WasteCoef*WastePPM*(time+dt)</eqn>
            <non_negative />
            <display x="293" y="233" color="blue">
                <pts>
                    <pt x="234" y="233" />
                    <pt x="352" y="233" />
                </pts>
            </display>
        </flow>
        <aux name="ReOxCoeff">
            <eqn>.0000738</eqn>
            <display x="189" y="103" color="blue" />
        </aux>
        <flow name="OxGone">
            <eqn>DeOx</eqn>
            <non_negative />
            <display x="314" y="34" color="blue" label_side="top" label_angle="72">
                <pts>
                    <pt x="245" y="34" />
                    <pt x="383" y="34" />
                </pts>
            </display>
        </flow>
        <aux name="WasteCoef">
            <eqn>.00165</eqn>
            <display x="251" y="297" color="blue" />
        </aux>
        <aux name="Area">
            <eqn>200</eqn>
            <display x="49" y="136" color="blue" />
        </aux>
        <aux name="DeOx">
            <eqn>(WasteCoef*WastePPM*(time))-(ReOxCoeff/StreamHeight*OxygenPPM*(time))</eqn>
            <display x="317" y="128" color="blue" />
        </aux>
        <display page_width="595" page_height="775" isee:converter_size="medium" isee:animate_flows="true" isee:animate_stocks="true" isee:animate_converters="true" interval="DT">
            <connector x="76" y="288" uid="0">
                <from>GramsWasteIn</from>
                <to>WasteinPPM</to>
            </connector>
            <connector x="203" y="47" uid="1">
                <from>OxygenPPM</from>
                <to>ReOx</to>
            </connector>
            <connector x="63" y="85" uid="2">
                <from>StreamHeight</from>
                <to>ReOx</to>
            </connector>
            <connector x="134" y="121" uid="3">
                <from>Volume</from>
                <to>WasteinPPM</to>
            </connector>
            <connector x="185" y="95" uid="4">
                <from>ReOxCoeff</from>
                <to>ReOx</to>
            </connector>
            <connector x="120" y="112" uid="5">
                <from>Volume</from>
                <to>ReOx</to>
            </connector>
            <connector x="317" y="119" uid="6">
                <from>DeOx</from>
                <to>OxGone</to>
            </connector>
            <connector x="253" y="288" uid="7">
                <from>WasteCoef</from>
                <to>WasteEaten</to>
            </connector>
            <connector x="236" y="239" uid="8">
                <from>WastePPM</from>
                <to>WasteEaten</to>
            </connector>
            <alias x="381" y="84" uid="9">
                <of>WasteCoef</of>
            </alias>
            <connector x="234" y="221" uid="10">
                <from>WastePPM</from>
                <to>DeOx</to>
            </connector>
            <alias x="364" y="176" uid="11">
                <of>StreamHeight</of>
            </alias>
            <connector x="356" y="167" uid="12">
                <from>
                    <alias uid="11" />
                </from>
                <to>DeOx</to>
            </connector>
            <connector x="201" y="105" uid="13">
                <from>ReOxCoeff</from>
                <to>DeOx</to>
            </connector>
            <connector x="65" y="95" uid="14">
                <from>StreamHeight</from>
                <to>Volume</to>
            </connector>
            <connector x="61" y="134" uid="15">
                <from>Area</from>
                <to>Volume</to>
            </connector>
            <connector x="371" y="91" uid="16">
                <from>
                    <alias uid="9" />
                </from>
                <to>DeOx</to>
            </connector>
            <connector x="232" y="49" uid="17">
                <from>OxygenPPM</from>
                <to>DeOx</to>
            </connector>
            <stacked_container height="282" width="492" uid="18">
                <graph type="time_series" title="Oxygen and Waste" background="white" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-07T15:51:26Z" cleared="true" time_precision="0" from="0" to="100">
                    <plot index="0" pen_width="1" color="black" precision="1" show_y_axis="true">
                        <entity name="OxygenPPM" />
                    </plot>
                    <plot index="1" pen_width="1" color="black" precision="1" show_y_axis="true">
                        <entity name="WastePPM" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="168" y="345" width="26" height="22" color="#0CA0FF" label_side="bottom" label="Graph 1" type="graph" icon_of="18" />
            <stacked_container height="286" width="465" uid="19">
                <table font-size="9" background="#FFFE91" column_width="60" orientation="vertical" interval="1" cleared="true" date_time="1995-09-02T13:28:15Z">
                    <title>Untitled Table</title>
                    <item type="time" color="black" precision="0.01" width="100" />
                    <item color="black" precision="0.01" delimit_000s="true" index="0">
                        <entity name="OxygenPPM" />
                    </item>
                    <item color="black" precision="0.01" delimit_000s="true" index="1">
                        <entity name="WastePPM" />
                    </item>
                    <item color="black" precision="0.01" delimit_000s="true" index="2">
                        <entity name="OxGone" />
                    </item>
                    <item color="black" precision="0.01" delimit_000s="true" index="3">
                        <entity name="ReOx" />
                    </item>
                    <item color="black" precision="0.01" delimit_000s="true" index="4">
                        <entity name="WasteEaten" />
                    </item>
                    <item color="black" precision="0.01" delimit_000s="true" index="5">
                        <entity name="GramsWasteIn" />
                    </item>
                </table>
            </stacked_container>
            <pad_icon x="320" y="340" width="26" height="22" color="#008F44" label_side="bottom" label="Table 1" type="table" icon_of="19" />
            <style font-family="Arial" font-size="9" />
        </display>
        <interface page_cols="0" page_rows="0" page_width="788" page_height="528" home_page="0">
            <simulation_delay>0.1</simulation_delay>
            <style font-family="Arial" font-size="9" />
        </interface>
        <popup x="16" y="78" content="18" />
        <popup x="16" y="78" content="19" />
        <style font-family="Arial" font-size="9" />
    </model>
</xmile>
