<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" level="3" xmlns="http://www.systemdynamics.org/XMILE" xmlns:isee="http://iseesystems.com/XMILE">
    <header>
        <smile version="1.0" namespace="std, isee">
            <uses_arrays>1</uses_arrays>
        </smile>
        <name>SocialStudies3.1.v3</name>
        <uuid>bad3d63e-749e-448b-8c2c-1a1730a05b3d</uuid>
        <vendor>isee systems, inc.</vendor>
        <product version="10.1.2" isee:saved_by_v1="false" lang="en">iThink</product>
    </header>
    <style>
        <model font-family="Arial" font-size="9" />
        <interface font-family="Arial" font-size="9" />
    </style>
    <sim_specs method="Euler" time_units="Days" isee:pause_after_rates="false" isee:instantaneous_flows="false">
        <start>0</start>
        <stop>12</stop>
        <dt>1</dt>
        <isee:analyze_mode>false</isee:analyze_mode>
    </sim_specs>
    <dimensions>
        <dim name="Dim_Name_1" size="1" />
    </dimensions>
    <model_units />
    <isee:prefs last_model="true" layer="model" grid_width="20" grid_height="50" divide_by_zero_alert="true" hide_taskbar="true" show_module_prefix="true">
        <isee:window width="1366" height="685" />
        <isee:security />
        <isee:print_setup width="595" height="775" />
    </isee:prefs>
    <isee:equation_prefs order_by="sector" />
    <model>
        <stock name="Amount_of_Graffiti">
            <eqn>100000</eqn>
            <inflow>New_Graffiti</inflow>
            <outflow>Graffiti_painted_over</outflow>
            <non_negative />
            <display x="200" y="59" color="black" label_side="bottom" label_angle="287" />
        </stock>
        <flow name="New_Graffiti">
            <eqn>Graffiti_artists*New_Graffiti_per_artist</eqn>
            <non_negative />
            <display x="121" y="60" color="black" label_side="top">
                <pts>
                    <pt x="63" y="60" />
                    <pt x="180" y="60" />
                </pts>
            </display>
        </flow>
        <flow name="Graffiti_painted_over">
            <eqn>Area_Painted_per_Scout*Scouts</eqn>
            <non_negative />
            <display x="293" y="57" color="black" label_side="top" label_angle="77">
                <pts>
                    <pt x="220" y="57" />
                    <pt x="367" y="57" />
                </pts>
            </display>
        </flow>
        <aux name="Graffiti_artists">
            <eqn>IF(Time&lt;3)THEN(5)ELSE(2)</eqn>
            <display x="47" y="108" color="black" />
        </aux>
        <aux name="New_Graffiti_per_artist">
            <eqn>50</eqn>
            <display x="134" y="155" color="black" />
        </aux>
        <aux name="Scouts">
            <eqn>23</eqn>
            <display x="262" y="144" color="black" />
        </aux>
        <aux name="Area_Painted_per_Scout">
            <eqn>500</eqn>
            <display x="371" y="115" color="black" />
        </aux>
        <display page_width="595" page_height="775" isee:converter_size="medium" interval="DT">
            <connector x="52" y="100" uid="0">
                <from>Graffiti_artists</from>
                <to>New_Graffiti</to>
            </connector>
            <connector x="133" y="146" uid="1">
                <from>New_Graffiti_per_artist</from>
                <to>New_Graffiti</to>
            </connector>
            <connector x="268" y="137" uid="2">
                <from>Scouts</from>
                <to>Graffiti_painted_over</to>
            </connector>
            <connector x="365" y="109" uid="3">
                <from>Area_Painted_per_Scout</from>
                <to>Graffiti_painted_over</to>
            </connector>
            <stacked_container height="282" width="492" uid="4">
                <graph type="time_series" title="Untitled Graph" background="#C8C8C8" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-07T15:50:48Z" cleared="true" time_precision="0" from="0" to="12">
                    <plot index="0" pen_width="1" color="red" precision="1" show_y_axis="true">
                        <scale min="0" max="100000" />
                        <entity name="Amount_of_Graffiti" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="477" y="66" width="26" height="22" color="black" label_side="bottom" label="Graph 1" type="graph" icon_of="4" />
            <stacked_container height="286" width="465" uid="5">
                <table font-size="9" background="#FFFE91" column_width="60" orientation="vertical" interval="1" cleared="true" date_time="1997-07-16T21:56:04Z">
                    <title>Untitled Table</title>
                    <item type="time" color="black" precision="0.01" width="100" />
                    <item color="black" precision="0.01" delimit_000s="true" index="0">
                        <entity name="Amount_of_Graffiti" />
                    </item>
                    <item color="black" precision="0.01" delimit_000s="true" index="1">
                        <entity name="Graffiti_painted_over" />
                    </item>
                    <item color="black" precision="0.01" delimit_000s="true" index="2">
                        <entity name="New_Graffiti" />
                    </item>
                </table>
            </stacked_container>
            <pad_icon x="482" y="131" width="26" height="22" color="black" label_side="bottom" label="Table 1" type="table" icon_of="5" />
            <style font-family="Arial" font-size="9" />
        </display>
        <interface page_cols="0" page_rows="0" page_width="788" page_height="528" home_page="0">
            <simulation_delay>0.1</simulation_delay>
            <style font-family="Arial" font-size="9" />
        </interface>
        <popup x="16" y="78" content="4" />
        <popup x="16" y="78" content="5" />
        <style font-family="Arial" font-size="9" />
    </model>
</xmile>
