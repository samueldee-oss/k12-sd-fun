        <name>industry.v3</name>
        <uuid>c55c1c1d-3318-4893-a9ba-1094a08713f6</uuid>
        <vendor>isee systems, inc.</vendor>
        <product version="10.1.2" isee:saved_by_v1="false" lang="en">iThink</product>
    </header>
    <style>
        <model font-family="Arial" font-size="9" />
        <interface font-family="Arial" font-size="9" />
    </style>
    <sim_specs method="Euler" time_units="Weeks" isee:pause_after_rates="false" isee:instantaneous_flows="false">
        <start>0</start>
        <stop>50</stop>
        <dt>1</dt>
        <isee:analyze_mode>false</isee:analyze_mode>
    </sim_specs>
    <dimensions>
        <dim name="Dim_Name_1" size="1" />
    </dimensions>
    <model_units />
    <isee:prefs last_model="true" layer="model" grid_width="20" grid_height="50" divide_by_zero_alert="true" hide_taskbar="true" show_module_prefix="true">
        <isee:window width="1366" height="685" />
        <isee:security />
        <isee:print_setup width="595" height="775" />
    </isee:prefs>
    <isee:equation_prefs order_by="sector" show_pages="true" />
    <model>
        <stock name="TOTAL_PRODUCTION">
            <eqn>0</eqn>
            <inflow>production_rate</inflow>
            <outflow>sales_rate</outflow>
            <non_negative />
            <display x="249" y="144" color="blue" />
        </stock>
        <flow name="production_rate">
            <eqn>(Total_Workers+More_workers)*Per_Worker_Productivity+(Total_Workers*Cost_Benefit_of_New_Tech)</eqn>
            <non_negative />
            <display x="170" y="144" color="blue" label_side="top" label_angle="74">
                <pts>
                    <pt x="111" y="144" />
                    <pt x="229" y="144" />
                </pts>
            </display>
        </flow>
        <aux name="Total_Workers">
            <eqn>20</eqn>
            <display x="201" y="174" color="blue" label_angle="313" />
        </aux>
        <aux name="Per_Worker_Productivity">
            <eqn>50&#x0D;</eqn>
            <display x="178" y="216" color="blue" label_angle="303" />
        </aux>
        <aux name="Gross_net">
            <eqn>sales_rate*Price_per_unit</eqn>
            <display x="710" y="305" color="blue" label_side="right" label_angle="356" />
        </aux>
        <flow name="after_expenses">
            <eqn>Gross_net-Total_Expenses</eqn>
            <non_negative />
            <display x="798" y="352" color="blue" label_side="top" label_angle="82">
                <pts>
                    <pt x="754" y="352" />
                    <pt x="843" y="352" />
                </pts>
            </display>
        </flow>
        <aux name="Per_Worker_Cost">
            <eqn>5</eqn>
            <display x="721" y="427" color="blue" label_side="left" label_angle="176" />
        </aux>
        <aux name="Cost_of_Technology">
            <eqn>2</eqn>
            <display x="782" y="497" color="blue" />
        </aux>
        <aux name="Raw_materials">
            <eqn>1</eqn>
            <display x="861" y="451" color="blue" />
        </aux>
        <flow name="sales_rate">
            <eqn>if TOTAL_PRODUCTION &gt; (TOTAL_BUYERS-Purchases_From_Competition) then TOTAL_BUYERS-Purchases_From_Competition else TOTAL_PRODUCTION</eqn>
            <non_negative />
            <display x="356" y="324" color="blue" label_side="right" label_angle="10">
                <pts>
                    <pt x="248" y="159" />
                    <pt x="248" y="324" />
                    <pt x="465" y="324" />
                </pts>
            </display>
        </flow>
        <aux name="TOTAL_BUYERS">
            <eqn>2000</eqn>
            <display x="351" y="270" color="blue" label_side="right" label_angle="330" />
        </aux>
        <aux name="Total_Expenses">
            <eqn>(Per_Worker_Cost*Total_Workers)+(Raw_materials*production_rate*Cost_of_Technology)+Invest_in_New_Technology</eqn>
            <display x="807" y="406" color="blue" label_side="right" label_angle="27" />
        </aux>
        <stock name="BOTTOM_LINE">
            <eqn>0</eqn>
            <inflow>after_expenses</inflow>
            <outflow>spend</outflow>
            <non_negative />
            <display x="863" y="354" color="blue" />
        </stock>
        <aux name="Price_per_unit">
            <eqn>2</eqn>
            <display x="387" y="243" color="blue" label_side="right" label_angle="348" />
        </aux>
        <aux name="Profit_taking">
            <eqn>0</eqn>
            <display x="972" y="306" color="blue" label_side="top" label_angle="42" />
        </aux>
        <aux name="Purchases_From_Competition">
            <eqn>if Competition_Price &lt; Price_per_unit  and (TOTAL_BUYERS-Competition_Production) &gt; 0 then Competition_Production else TOTAL_BUYERS-TOTAL_PRODUCTION</eqn>
            <display x="333" y="185" color="blue" label_side="top" label_angle="53" />
        </aux>
        <flow name="spend">
            <eqn>(More_workers*Per_Worker_Cost)+Invest_in_New_Technology+Profit_taking </eqn>
            <non_negative />
            <display x="945" y="351" color="blue" label_side="top" label_angle="106">
                <pts>
                    <pt x="883" y="351" />
                    <pt x="1007" y="351" />
                </pts>
            </display>
        </flow>
        <aux name="More_workers">
            <eqn>0</eqn>
            <display x="987" y="420" color="blue" label_angle="305" />
        </aux>
        <aux name="Invest_in_New_Technology">
            <eqn>0</eqn>
            <display x="929" y="437" color="blue" label_angle="325" />
        </aux>
        <aux name="Competition_Price">
            <eqn>5</eqn>
            <display x="455" y="159" color="blue" label_side="top" label_angle="60" />
        </aux>
        <aux name="Competition_Production">
            <eqn>1000</eqn>
            <display x="416" y="204" color="blue" label_angle="333" />
        </aux>
        <aux name="Cost_Benefit_of_New_Tech">
            <eqn>Invest_in_New_Technology</eqn>
            <gf>
                <xscale min="0" max="500" />
                <yscale min="0" max="1" />
                <ypts>0,0,0.025000000000000001,0.14000000000000001,0.23000000000000001,0.33500000000000002,0.42999999999999999,0.52000000000000002,0.60499999999999998,0.72499999999999998,0.82499999999999996</ypts>
            </gf>
            <display x="92" y="190" color="blue" label_side="top" label_angle="131" />
        </aux>
