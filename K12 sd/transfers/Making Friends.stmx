    <model_units />
    <isee:prefs last_model="true" layer="interface" grid_width="20" grid_height="50" divide_by_zero_alert="true" hide_taskbar="true" show_module_prefix="true">
        <isee:window width="905" height="587" />
        <isee:security />
        <isee:print_setup width="576" height="768" />
    </isee:prefs>
    <isee:equation_prefs order_by="module" />
    <model>
        <stock name="Friends_in_game_2">
            <eqn>1</eqn>
            <inflow>Making_Friends_in__game_2</inflow>
            <non_negative />
            <display x="372" y="364" color="blue" />
        </stock>
        <flow name="Making_Friends_in\n_game_2">
            <eqn>Friends_in_game_2</eqn>
            <non_negative />
            <display x="265" y="366" color="blue">
                <pts>
                    <pt x="181" y="366" />
                    <pt x="350" y="366" />
                </pts>
            </display>
        </flow>
        <stock name="Friends_in_game_1">
            <eqn>1</eqn>
            <inflow>Making_Friends_in_game_1</inflow>
            <non_negative />
            <display x="375" y="146" color="blue" />
        </stock>
        <flow name="Making_Friends_in\ngame_1">
            <eqn>2</eqn>
            <non_negative />
            <display x="276" y="149" color="blue">
                <pts>
                    <pt x="199" y="149" />
                    <pt x="353" y="149" />
                </pts>
            </display>
        </flow>
        <display page_width="576" page_height="768" isee:converter_size="medium" isee:animate_flows="true" isee:animate_stocks="true" isee:animate_converters="true" interval="DT">
            <connector x="350" y="349" uid="0">
                <from>Friends_in_game_2</from>
                <to>Making_Friends_in__game_2</to>
            </connector>
            <text_box x="180" y="250" uid="1" color="black" font-family="Arial" font-size="18" text-align="center" padding="5" border-style="solid" border-width="5px" width="260" height="58">Game 2</text_box>
            <text_box x="182" y="28" uid="2" color="black" font-family="Arial" font-size="18" text-align="center" padding="5" border-style="solid" border-width="5px" width="260" height="58">Game 1</text_box>
            <style font-family="Arial" font-size="18" />
        </display>
        <interface page_cols="2" page_rows="2" page_width="788" page_height="528" scroll_y="528" home_page="3">
            <simulation_delay>0.1</simulation_delay>
            <stacked_container x="158" y="46" height="282" width="492" visible_index="2" uid="3">
                <graph type="time_series" title="Making Friends Game 1" background="#FFFFC9" show_grid="true" plot_numbers="true" isee:use_five_segments="false" hide_detail="true" cleared="true" time_precision="2" from="0" to="12">
                    <plot index="0" pen_width="3" color="blue" precision="1" show_y_axis="true">
                        <scale min="0" max="100" />
                        <entity name="Friends_in_game_1" />
                    </plot>
                </graph>
                <graph type="time_series" title="Making Friends Game 2" background="#FFFFC9" show_grid="true" plot_numbers="true" isee:use_five_segments="false" hide_detail="true" cleared="true" time_precision="2" from="0" to="12">
                    <plot index="0" pen_width="3" color="blue" precision="1" show_y_axis="true">
                        <scale min="0" max="1000" />
                        <entity name="Friends_in_game_2" />
                    </plot>
                </graph>
                <graph type="time_series" title="Comparing Games 1 and 2" background="#FFFFC9" show_grid="true" plot_numbers="true" isee:use_five_segments="false" hide_detail="true" cleared="true" time_precision="2" from="0" to="12">
                    <plot index="0" pen_width="3" color="blue" precision="1" show_y_axis="true">
                        <scale min="0" max="200" />
                        <entity name="Friends_in_game_1" />
                    </plot>
                    <plot index="1" pen_width="3" color="red" precision="1" show_y_axis="true">
                        <scale min="0" max="200" />
                        <entity name="Friends_in_game_2" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="216" y="182" width="26" height="22" color="#008F44" label_side="bottom" label="Graph 1" type="graph" icon_of="3" />
            <stacked_container x="1045" y="49" height="434" width="383" uid="4">
                <table font-size="9" background="#E0E0E0" column_width="90" orientation="vertical" interval="1" cleared="true" date_time="2010-12-08T15:21:18Z">
                    <title>Making Friends</title>
                    <item type="time" color="black" precision="max" width="100" />
                    <item color="black" precision="0.01" delimit_000s="true" index="0">
                        <entity name="Friends_in_game_1" />
                    </item>
                    <item color="black" precision="0.01" delimit_000s="true" index="1">
                        <entity name="Friends_in_game_2" />
                    </item>
