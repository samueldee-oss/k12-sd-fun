<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" level="3" xmlns="http://www.systemdynamics.org/XMILE" xmlns:isee="http://iseesystems.com/XMILE">
    <header>
        <smile version="1.0" namespace="std, isee">
            <uses_arrays>1</uses_arrays>
        </smile>
        <name>JHJP3.v5</name>
        <uuid>bc5a3be8-9864-45d5-b6cf-77acca2536b5</uuid>
        <vendor>isee systems, inc.</vendor>
        <product version="10.1.2" isee:saved_by_v1="false" lang="en">iThink</product>
    </header>
    <style>
        <model font-family="Arial" font-size="9" />
        <interface font-family="Arial" font-size="9" />
    </style>
    <sim_specs method="Euler" time_units="Years" isee:pause_after_rates="false" isee:instantaneous_flows="false">
        <start>0</start>
        <stop>50</stop>
        <dt>1</dt>
        <isee:analyze_mode>false</isee:analyze_mode>
    </sim_specs>
    <dimensions>
        <dim name="Dim_Name_1" size="1" />
    </dimensions>
    <model_units />
    <isee:prefs last_model="true" layer="model" grid_width="20" grid_height="50" divide_by_zero_alert="true" link_high_level_map="true" show_module_prefix="true">
        <isee:window width="817" height="572" />
        <isee:security />
        <isee:print_setup width="552" height="728" />
    </isee:prefs>
    <isee:equation_prefs order_by="sector" />
    <model>
        <stock name="Population">
            <scale min="0" max="40000" />
            <inflow>Growth_Rate</inflow>
            <outflow>Death_Rate</outflow>
            <non_negative />
            <display x="229" y="67" color="blue">
                <scale min="0" max="40000" />
            </display>
        </stock>
        <flow name="Growth_Rate">
            <non_negative />
            <display x="155" y="67" color="blue">
                <pts>
                    <pt x="101" y="67" />
                    <pt x="209" y="67" />
                </pts>
            </display>
        </flow>
        <flow name="Death_Rate">
            <non_negative />
            <display x="296" y="67" color="blue">
                <pts>
                    <pt x="249" y="67" />
                    <pt x="344" y="67" />
                </pts>
            </display>
        </flow>
        <aux name="Death_Fraction">
            <display x="328" y="156" color="blue" />
        </aux>
        <aux name="Birth_Fraction">
            <display x="62" y="164" color="blue" />
        </aux>
        <aux name="Immigration">
            <eqn>&#x0D;</eqn>
            <display x="169" y="150" color="blue" />
        </aux>
        <display page_width="552" page_height="728" isee:converter_size="large" interval="DT">
            <connector x="71" y="156" uid="0">
                <from>Birth_Fraction</from>
                <to>Growth_Rate</to>
            </connector>
            <connector x="178" y="142" uid="1">
                <from>Immigration</from>
                <to>Growth_Rate</to>
            </connector>
            <connector x="208" y="71" uid="2">
                <from>Population</from>
                <to>Growth_Rate</to>
            </connector>
            <connector x="333" y="145" uid="3">
                <from>Death_Fraction</from>
                <to>Death_Rate</to>
            </connector>
            <connector x="251" y="72" uid="4">
                <from>Population</from>
                <to>Death_Rate</to>
            </connector>
            <stacked_container height="282" width="492" uid="5">
                <graph type="time_series" title="Untitled Graph" background="#C8C8C8" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-04T09:47:39Z" cleared="true" time_precision="2" from="0" to="50">
                    <plot index="0" pen_width="1" color="red" precision="0.01" show_y_axis="true">
                        <entity name="Population" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="410" y="67" width="26" height="22" color="#0CA0FF" label_side="bottom" label="Graph 1" type="graph" icon_of="5" />
            <style font-family="Arial" font-size="9" />
        </display>
        <interface page_cols="0" page_rows="0" page_width="640" page_height="480" home_page="0">
            <simulation_delay>0</simulation_delay>
            <style font-family="Arial" font-size="9" />
        </interface>
        <popup x="8" y="51" content="5" />
        <style font-family="Arial" font-size="9" />
    </model>
</xmile>
