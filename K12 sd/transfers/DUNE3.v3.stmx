<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" level="3" xmlns="http://www.systemdynamics.org/XMILE" xmlns:isee="http://iseesystems.com/XMILE">
    <header>
        <smile version="1.0" namespace="std, isee">
            <uses_arrays>1</uses_arrays>
        </smile>
        <name>DUNE3.v3</name>
        <uuid>73ef28c7-e9f3-4c4a-b1b4-4181de3eb2a5</uuid>
        <vendor>isee systems, inc.</vendor>
        <product version="10.1.2" isee:saved_by_v1="false" lang="en">iThink</product>
    </header>
    <style>
        <model font-family="Arial" font-size="9" />
        <interface font-family="Arial" font-size="9" />
    </style>
    <sim_specs method="Euler" time_units="Time" isee:pause_after_rates="false" isee:instantaneous_flows="false">
        <start>0</start>
        <stop>100</stop>
        <dt>0.5</dt>
        <isee:analyze_mode>false</isee:analyze_mode>
    </sim_specs>
    <dimensions>
        <dim name="Dim_Name_1" size="1" />
    </dimensions>
    <model_units />
    <isee:prefs last_model="true" layer="model" grid_width="20" grid_height="50" divide_by_zero_alert="true" hide_taskbar="true" show_module_prefix="true">
        <isee:window width="1366" height="685" />
        <isee:security />
        <isee:print_setup width="595" height="775" />
    </isee:prefs>
    <isee:equation_prefs order_by="sector" />
    <model>
        <stock name="dune_height">
            <eqn>0</eqn>
            <scale min="0" max="50" />
            <inflow>dune_growth</inflow>
            <non_negative />
            <display x="184" y="48" color="blue" label_angle="84">
                <scale min="0" max="50" />
            </display>
        </stock>
        <flow name="dune_growth">
            <doc>3</doc>
            <eqn>if (dune_height= 0) then 4  else 4/dune_height</eqn>
            <non_negative />
            <display x="115" y="44" color="blue" label_side="top" label_angle="85">
                <pts>
                    <pt x="67" y="44" />
                    <pt x="164" y="44" />
                </pts>
            </display>
        </flow>
        <stock name="vegetation">
            <eqn>0&#x0D;</eqn>
            <scale min="0" max="20" />
            <inflow>vegetation_growth</inflow>
            <non_negative />
            <display x="241" y="148" color="blue" label_side="right">
                <scale min="0" max="20" />
            </display>
        </stock>
        <flow name="vegetation_growth">
            <eqn>if vegetation = 0 then 2 - salt_spray else (2 - salt_spray) * vegetation * .1</eqn>
            <scale min="0" max="2" />
            <non_negative />
            <display x="186" y="148" color="blue" label_side="left" label_angle="208">
                <scale min="0" max="2" />
                <pts>
                    <pt x="151" y="148" />
                    <pt x="221" y="148" />
                </pts>
            </display>
        </flow>
        <stock name="forest">
            <eqn>0</eqn>
            <scale min="0" max="20" />
            <inflow>forest_growth</inflow>
            <non_negative />
            <display x="470" y="148" color="blue" label_side="right" label_angle="2">
                <scale min="0" max="20" />
            </display>
        </stock>
        <flow name="forest_growth">
            <eqn>if (salt_spray=0) then if (forest = 0) then .25 else forest*.1 else 0</eqn>
            <scale min="0" max="2" />
            <non_negative />
            <display x="416" y="146" color="blue" label_side="left" label_angle="202">
                <scale min="0" max="2" />
                <pts>
                    <pt x="382" y="146" />
                    <pt x="450" y="146" />
                </pts>
            </display>
        </flow>
        <aux name="salt_spray">
            <eqn>if (dune_height &gt;= 20) then 0 else if dune_height &lt; 1 then 15 else 20/dune_height</eqn>
            <scale min="0" max="20" />
            <display x="319" y="55" color="blue" label_side="right" label_angle="16">
                <scale min="0" max="20" />
            </display>
        </aux>
        <display page_width="595" page_height="775" isee:converter_size="medium" interval="20" scroll_x="16">
            <connector x="325" y="62" uid="0">
                <from>salt_spray</from>
                <to>forest_growth</to>
            </connector>
            <connector x="181" y="65" uid="1">
                <from>dune_height</from>
                <to>dune_growth</to>
            </connector>
            <connector x="247" y="165" uid="2">
                <from>vegetation</from>
                <to>vegetation_growth</to>
            </connector>
            <connector x="482" y="165" uid="3">
                <from>forest</from>
                <to>forest_growth</to>
            </connector>
            <connector x="311" y="58" uid="4">
                <from>salt_spray</from>
                <to>vegetation_growth</to>
            </connector>
            <connector x="204" y="37" uid="5">
                <from>dune_height</from>
                <to>salt_spray</to>
            </connector>
            <stacked_container height="282" width="492" uid="6">
                <graph type="time_series" title="Barrier Island Development Including Salt Spray as a Variable" background="#C8C8C8" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-07T15:39:55Z" cleared="true" time_precision="0" from="0" to="100">
                    <plot index="0" pen_width="1" color="red" precision="1" show_y_axis="true">
                        <entity name="dune_height" />
                    </plot>
                    <plot index="1" pen_width="1" color="#008F44" precision="1" show_y_axis="true">
                        <entity name="vegetation" />
                    </plot>
                    <plot index="2" pen_width="1" color="blue" precision="1" show_y_axis="true">
                        <entity name="forest" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="109" y="219" width="26" height="22" color="#0CA0FF" label_side="bottom" label_angle="277" label="Barrier Island Development" type="graph" icon_of="6" />
            <stacked_container height="282" width="492" uid="7">
                <graph type="time_series" title="Comparison of Salt Spray and Vegetation/Forest Growth" background="#C8C8C8" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-07T15:39:55Z" cleared="true" time_precision="0" from="0" to="100">
                    <plot index="0" pen_width="1" color="blue" precision="1" show_y_axis="true">
                        <entity name="salt_spray" />
                    </plot>
                    <plot index="1" pen_width="1" color="#008F44" precision="1" show_y_axis="true">
                        <entity name="vegetation" />
                    </plot>
                    <plot index="2" pen_width="1" color="fuchsia" precision="1" show_y_axis="true">
                        <entity name="forest" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="109" y="275" width="26" height="22" color="#0CA0FF" label_side="bottom" label="Salt Spray vs Vegetation\Forest" type="graph" icon_of="7" />
            <stacked_container height="286" width="465" uid="8">
                <table font-size="9" background="#FFFE91" column_width="60" orientation="vertical" interval="20" cleared="true" date_time="1995-08-17T13:16:24Z">
                    <title>Salt Spray</title>
                    <item type="time" color="black" precision="0.01" width="100" />
                    <item color="black" precision="0.01" delimit_000s="true" index="0">
                        <entity name="dune_height" />
                    </item>
                    <item color="black" precision="0.01" delimit_000s="true" index="1">
                        <entity name="salt_spray" />
                    </item>
                    <item color="black" precision="0.01" delimit_000s="true" index="2">
                        <entity name="vegetation" />
                    </item>
                    <item color="black" precision="0.01" delimit_000s="true" index="3">
                        <entity name="forest" />
                    </item>
                </table>
            </stacked_container>
            <pad_icon x="322" y="277" width="26" height="22" color="#008F44" label_side="bottom" label="Salt Spray vs Vegetation\Forest" type="table" icon_of="8" />
            <style font-family="Arial" font-size="9" />
        </display>
        <interface page_width="788" page_height="528" scroll_x="48" scroll_y="24">
            <simulation_delay>0.1</simulation_delay>
            <text_box x="133" y="47" uid="9" color="#7F00FF" font-family="Arial" font-size="14" text-align="center" padding="5" border-style="double" border-width="thick-thin" width="314" height="55">Barrier Island Development &#x0D;Including Salt Spray as a Variable</text_box>
            <text_box x="133" y="154" uid="10" color="#7F00FF" font-family="Arial" font-size="12" text-align="center" padding="5" width="314" height="110">Aili Carlson&#x0D;acarlson@people.mbhs.edu&#x0D;Sarah Clemmitt&#x0D;sclemmit@people.mbhs.edu&#x0D;Maryland Virtual High School&#x0D;August 1995</text_box>
            <style font-family="Arial" font-size="9" />
        </interface>
        <popup x="16" y="78" content="6" />
        <popup x="16" y="78" content="7" />
        <popup x="16" y="78" content="8" />
        <style font-family="Arial" font-size="9" />
    </model>
</xmile>
