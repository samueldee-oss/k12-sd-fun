            <pad_icon x="217" y="374" width="26" height="22" color="fuchsia" label_side="bottom" label="Graph 1" type="graph" icon_of="0" />
            <text_box x="115" y="5" uid="1" color="#7F00FF" font-family="Arial" font-size="14" font-weight="bold" text-align="center" padding="5" width="314" height="78">LINEAR MODELS IN STELLA II&#x0D;Fisher and Rogers, 1992&#x0D;Answer Key for Introductory Scenario</text_box>
