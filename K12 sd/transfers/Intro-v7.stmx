        <isee:print_setup width="595" height="744" />
    </isee:prefs>
    <isee:equation_prefs order_by="sector" show_pages="true" />
    <model>
        <stock name="MILES_WALKED">
            <eqn>0&#x0D;{Total miles walked; zero miles had been walked at the start of the simulation}</eqn>
            <inflow>Miles_Walked_per_Hour</inflow>
            <non_negative />
            <display x="231" y="210" color="blue" />
        </stock>
        <flow name="Miles_Walked_per_Hour">
            <eqn>3&#x0D;{Miles per hour}</eqn>
            <non_negative />
            <display x="152" y="220" color="blue">
                <pts>
                    <pt x="95" y="220" />
                    <pt x="209" y="220" />
                </pts>
            </display>
        </flow>
        <display show_pages="true" page_width="595" page_height="744" isee:converter_size="large" interval="DT">
            <stacked_container x="45" y="308" height="282" width="492" uid="0">
                <graph type="time_series" title="Untitled" background="white" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-04T09:46:20Z" cleared="true" time_precision="2" from="0" to="8">
                    <plot index="0" pen_width="1" color="red" precision="1" show_y_axis="true">
