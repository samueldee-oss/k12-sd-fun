<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" level="3" xmlns="http://www.systemdynamics.org/XMILE" xmlns:isee="http://iseesystems.com/XMILE">
    <header>
        <smile version="1.0" namespace="std, isee">
            <uses_arrays>1</uses_arrays>
        </smile>
        <name>PopPart1Model1.v3</name>
        <uuid>feefa27d-fcf9-45df-9768-cd5b17d039ba</uuid>
        <vendor>isee systems, inc.</vendor>
        <product version="10.1.2" isee:saved_by_v1="false" lang="en">iThink</product>
    </header>
    <style>
        <model font-family="Arial" font-size="9" />
        <interface font-family="Arial" font-size="9" />
    </style>
    <sim_specs method="Euler" time_units="Years" isee:pause_after_rates="false" isee:instantaneous_flows="false">
        <start>0</start>
        <stop>50</stop>
        <dt>1</dt>
        <isee:analyze_mode>false</isee:analyze_mode>
    </sim_specs>
    <dimensions>
        <dim name="Dim_Name_1" size="1" />
    </dimensions>
    <model_units />
    <isee:prefs last_model="true" layer="model" grid_width="20" grid_height="50" divide_by_zero_alert="true" hide_taskbar="true" show_module_prefix="true">
        <isee:window width="1366" height="685" />
        <isee:security />
        <isee:print_setup width="595" height="775" />
    </isee:prefs>
    <isee:equation_prefs order_by="sector" />
    <model>
        <stock name="Population">
            <eqn>100000</eqn>
            <inflow>Births</inflow>
            <outflow>Deaths</outflow>
            <non_negative />
            <display x="256" y="132" color="blue" />
        </stock>
        <flow name="Births">
            <eqn>Population*Birth_Fraction</eqn>
            <non_negative />
            <display x="189" y="128" color="blue">
                <pts>
                    <pt x="142" y="128" />
                    <pt x="236" y="128" />
                </pts>
            </display>
        </flow>
        <flow name="Deaths">
            <eqn>Population*Death_Fraction</eqn>
            <non_negative />
            <display x="330" y="130" color="blue">
                <pts>
                    <pt x="276" y="130" />
                    <pt x="385" y="130" />
                </pts>
            </display>
        </flow>
        <aux name="Birth_Fraction">
            <eqn>0.013</eqn>
            <display x="113" y="211" color="blue" />
        </aux>
        <aux name="Death_Fraction">
            <eqn>0.008&#x0D;</eqn>
            <display x="407" y="219" color="blue" />
        </aux>
        <display page_width="595" page_height="775" isee:converter_size="medium" interval="DT">
            <connector x="117" y="203" uid="0">
                <from>Birth_Fraction</from>
                <to>Births</to>
            </connector>
            <connector x="406" y="210" uid="1">
                <from>Death_Fraction</from>
                <to>Deaths</to>
            </connector>
            <connector x="278" y="144" uid="2">
                <from>Population</from>
                <to>Deaths</to>
            </connector>
            <connector x="234" y="146" uid="3">
                <from>Population</from>
                <to>Births</to>
            </connector>
            <stacked_container height="282" width="492" uid="4">
                <graph type="time_series" title="Untitled Graph" background="#C8C8C8" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-07T15:47:40Z" cleared="true" time_precision="0" from="0" to="50">
                    <plot index="0" pen_width="1" color="fuchsia" precision="1" show_y_axis="true">
                        <scale min="0" max="10000" />
                        <entity name="Births" />
                    </plot>
                    <plot index="1" pen_width="1" color="#008F44" precision="1" show_y_axis="true">
                        <scale min="0" max="10000" />
                        <entity name="Deaths" />
                    </plot>
                    <plot index="2" pen_width="1" color="red" precision="1" show_y_axis="true">
                        <scale min="0" max="250000" />
                        <entity name="Population" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="262" y="224" width="26" height="22" color="#0CA0FF" label_side="bottom" label="Graph 1" type="graph" icon_of="4" />
            <style font-family="Arial" font-size="9" />
        </display>
        <interface page_cols="0" page_rows="0" page_width="788" page_height="528" home_page="0">
            <simulation_delay>0.1</simulation_delay>
            <style font-family="Arial" font-size="9" />
        </interface>
        <popup x="16" y="78" content="4" />
        <style font-family="Arial" font-size="9" />
    </model>
</xmile>
