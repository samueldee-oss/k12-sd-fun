            <pad_icon x="287" y="250" width="26" height="22" color="#008F44" label_side="bottom" label="Dune Height Over Time" type="table" icon_of="5" />
            <style font-family="Arial" font-size="9" />
        </display>
        <interface page_width="788" page_height="528">
            <simulation_delay>0.1</simulation_delay>
            <text_box x="153" y="71" uid="6" color="#7F00FF" font-family="Arial" font-size="14" text-align="center" padding="5" border-style="double" border-width="thick-thin" width="260" height="60">Barrier Island Development&#x0D; Assuming Linear Growth</text_box>
