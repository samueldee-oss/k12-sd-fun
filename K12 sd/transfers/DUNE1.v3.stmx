<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" level="3" xmlns="http://www.systemdynamics.org/XMILE" xmlns:isee="http://iseesystems.com/XMILE">
    <header>
        <smile version="1.0" namespace="std, isee">
            <uses_arrays>1</uses_arrays>
        </smile>
        <name>DUNE1.v3</name>
        <uuid>a7695083-49ca-4a22-808c-ddccc9e9369c</uuid>
        <vendor>isee systems, inc.</vendor>
        <product version="10.1.2" isee:saved_by_v1="false" lang="en">iThink</product>
    </header>
    <style>
        <model font-family="Arial" font-size="9" />
        <interface font-family="Arial" font-size="9" />
    </style>
    <sim_specs method="Euler" time_units="Time" isee:pause_after_rates="false" isee:instantaneous_flows="false">
        <start>0</start>
        <stop>10</stop>
        <dt>1</dt>
        <isee:analyze_mode>false</isee:analyze_mode>
    </sim_specs>
    <dimensions>
        <dim name="Dim_Name_1" size="1" />
    </dimensions>
    <model_units />
    <isee:prefs last_model="true" layer="model" grid_width="20" grid_height="50" divide_by_zero_alert="true" hide_taskbar="true" show_module_prefix="true">
        <isee:window width="1366" height="685" />
        <isee:security />
        <isee:print_setup width="595" height="775" />
    </isee:prefs>
    <isee:equation_prefs order_by="sector" />
    <model>
        <stock name="dune_height">
            <eqn>0</eqn>
            <scale min="0" max="25" />
            <inflow>dune_growth</inflow>
            <non_negative />
            <display x="178" y="48" color="blue">
                <scale min="0" max="25" />
            </display>
        </stock>
        <flow name="dune_growth">
            <doc>3</doc>
            <eqn>4</eqn>
            <non_negative />
            <display x="109" y="44" color="blue">
                <pts>
                    <pt x="61" y="44" />
                    <pt x="158" y="44" />
                </pts>
            </display>
        </flow>
        <stock name="vegetation">
            <eqn>0&#x0D;</eqn>
            <scale min="0" max="25" />
            <inflow>vegetation_growth</inflow>
            <non_negative />
            <display x="302" y="103" color="blue">
                <scale min="0" max="25" />
            </display>
        </stock>
        <flow name="vegetation_growth">
            <eqn>if (dune_height &gt;=5) then (2) else 0</eqn>
            <scale min="0" max="2" />
            <non_negative />
            <display x="246" y="103" color="blue">
                <scale min="0" max="2" />
                <pts>
                    <pt x="210" y="103" />
                    <pt x="282" y="103" />
                </pts>
            </display>
        </flow>
        <stock name="forest">
            <eqn>0</eqn>
            <scale min="0" max="25" />
            <inflow>forest_growth</inflow>
            <non_negative />
            <display x="482" y="103" color="blue">
                <scale min="0" max="25" />
            </display>
        </stock>
        <flow name="forest_growth">
            <eqn>if (dune_height &gt;=15) then 1 else 0</eqn>
            <scale min="0" max="2" />
            <non_negative />
            <display x="426" y="103" color="blue">
                <scale min="0" max="2" />
                <pts>
                    <pt x="390" y="103" />
                    <pt x="462" y="103" />
                </pts>
            </display>
        </flow>
        <display page_width="595" page_height="775" isee:converter_size="medium" interval="DT" scroll_y="96">
            <connector x="200" y="57" uid="0">
                <from>dune_height</from>
                <to>vegetation_growth</to>
            </connector>
            <connector x="200" y="39" uid="1">
                <from>dune_height</from>
                <to>forest_growth</to>
            </connector>
            <stacked_container height="282" width="492" uid="2">
                <graph type="time_series" title="Barrier Island Development" background="#C8C8C8" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-07T15:39:46Z" cleared="true" time_precision="0" from="0" to="10">
                    <plot index="0" pen_width="1" color="red" precision="1" show_y_axis="true">
                        <scale min="0" max="40" />
                        <entity name="dune_height" />
                    </plot>
                    <plot index="1" pen_width="1" color="fuchsia" precision="1" show_y_axis="true">
                        <scale min="0" max="40" />
                        <entity name="vegetation" />
                    </plot>
                    <plot index="2" pen_width="1" color="#008F44" precision="1" show_y_axis="true">
                        <scale min="0" max="40" />
                        <entity name="forest" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="122" y="312" width="26" height="22" color="#0CA0FF" label_side="bottom" label="Barrier Island Development" type="graph" icon_of="2" />
            <stacked_container height="282" width="492" uid="3">
                <graph type="time_series" title="Dune Height Over Time" background="#C8C8C8" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-07T15:39:46Z" cleared="true" time_precision="0" from="0" to="10">
                    <plot index="0" pen_width="1" color="red" precision="1" show_y_axis="true">
                        <entity name="dune_height" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="121" y="251" width="26" height="22" color="#0CA0FF" label_side="bottom" label="Dune Height Over Time" type="graph" icon_of="3" />
            <stacked_container height="286" width="465" uid="4">
                <table font-size="9" background="#FFFE91" column_width="60" orientation="vertical" interval="1" cleared="true" date_time="1995-08-17T13:31:34Z">
                    <title>Barrier Island Develoment</title>
                    <item type="time" color="black" precision="0.01" width="100" />
                    <item color="black" precision="0.01" delimit_000s="true" index="0">
                        <entity name="dune_height" />
