<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" level="3" xmlns="http://www.systemdynamics.org/XMILE" xmlns:isee="http://iseesystems.com/XMILE">
    <header>
        <smile version="1.0" namespace="std, isee">
            <uses_arrays>1</uses_arrays>
        </smile>
        <name>Mathematics4.2.v3</name>
        <uuid>e64a9a53-4ac0-46fc-8bc3-50680900c436</uuid>
        <vendor>isee systems, inc.</vendor>
        <product version="10.1.2" isee:saved_by_v1="false" lang="en">iThink</product>
    </header>
    <style>
        <model font-family="Arial" font-size="9" />
        <interface font-family="Arial" font-size="9" />
    </style>
    <sim_specs method="Euler" time_units="Years" isee:pause_after_rates="false" isee:instantaneous_flows="false">
        <start>0</start>
        <stop>50</stop>
        <dt>1</dt>
        <isee:analyze_mode>false</isee:analyze_mode>
    </sim_specs>
    <dimensions>
        <dim name="Dim_Name_1" size="1" />
    </dimensions>
    <model_units />
    <isee:prefs last_model="true" layer="model" grid_width="20" grid_height="50" divide_by_zero_alert="true" hide_taskbar="true" show_module_prefix="true">
        <isee:window width="1366" height="685" />
        <isee:security />
        <isee:print_setup width="595" height="775" />
    </isee:prefs>
    <isee:equation_prefs order_by="sector" />
    <model>
        <stock name="Alexandria_Balance">
            <eqn>2000</eqn>
            <inflow>Percent_Growth_Rate</inflow>
            <non_negative />
            <display x="267" y="70" color="blue" />
        </stock>
        <flow name="Percent_Growth_Rate">
            <eqn>.1*Alexandria_Balance</eqn>
            <non_negative />
            <display x="207" y="72" color="blue">
                <pts>
                    <pt x="167" y="72" />
                    <pt x="247" y="72" />
                </pts>
            </display>
        </flow>
        <stock name="Minh_Balance">
            <eqn>2000</eqn>
            <inflow>Annual_Deposit</inflow>
            <non_negative />
            <display x="265" y="156" color="blue" />
        </stock>
        <flow name="Annual_Deposit">
            <eqn>2000</eqn>
            <non_negative />
            <display x="209" y="151" color="blue">
                <pts>
                    <pt x="173" y="151" />
                    <pt x="245" y="151" />
                </pts>
            </display>
        </flow>
        <display page_width="595" page_height="775" isee:converter_size="medium" interval="DT">
            <connector x="245" y="85" uid="0">
                <from>Alexandria_Balance</from>
                <to>Percent_Growth_Rate</to>
            </connector>
            <stacked_container height="282" width="492" uid="1">
                <graph type="time_series" title="Untitled Graph" background="#C8C8C8" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-07T15:45:45Z" cleared="true" time_precision="0" from="0" to="50">
                    <plot index="0" pen_width="1" color="red" precision="1" show_y_axis="true">
                        <scale min="0" max="300000" />
                        <entity name="Alexandria_Balance" />
                    </plot>
                    <plot index="1" pen_width="1" color="blue" precision="1" show_y_axis="true">
                        <scale min="0" max="300000" />
                        <entity name="Minh_Balance" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="368" y="113" width="26" height="22" color="#0CA0FF" label_side="bottom" label="Graph 1" type="graph" icon_of="1" />
            <style font-family="Arial" font-size="9" />
        </display>
        <interface page_cols="0" page_rows="0" page_width="788" page_height="528" home_page="0">
            <simulation_delay>0.1</simulation_delay>
            <style font-family="Arial" font-size="9" />
        </interface>
        <popup x="16" y="78" content="1" />
        <style font-family="Arial" font-size="9" />
    </model>
</xmile>
