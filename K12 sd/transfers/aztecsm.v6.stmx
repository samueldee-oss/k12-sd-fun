                <label_side>bottom</label_side>
                <label_angle>318</label_angle>
            </alias>
            <alias x="297" y="353" uid="9">
                <of>INFECTED_BUT_NOT_CONTAGIOUS</of>
                <label_side>bottom</label_side>
                <label_angle>233</label_angle>
            </alias>
            <alias x="249" y="328" uid="10">
                <of>SUSCEPTIBLE</of>
                <label_side>bottom</label_side>
                <label_angle>241</label_angle>
            </alias>
            <connector x="269" y="316" uid="11">
                <from>
                    <alias uid="10" />
                </from>
                <to>total_living_population</to>
            </connector>
            <connector x="317" y="340" uid="12">
                <from>
                    <alias uid="9" />
                </from>
                <to>total_living_population</to>
            </connector>
            <connector x="385" y="323" uid="13">
                <from>
                    <alias uid="8" />
                </from>
                <to>total_living_population</to>
            </connector>
            <connector x="422" y="301" uid="14">
                <from>
                    <alias uid="7" />
                </from>
                <to>total_living_population</to>
            </connector>
            <connector x="320" y="273" uid="15">
                <from>total_living_population</from>
                <to>susceptible_contacts_between_infected_and_suscept</to>
            </connector>
            <connector x="184" y="232" uid="16">
                <from>susceptible_contacts_between_infected_and_suscept</from>
                <to>Become_Infected</to>
            </connector>
            <connector x="91" y="162" uid="17">
                <from>SUSCEPTIBLE</from>
                <to>susceptible_contacts_between_infected_and_suscept</to>
            </connector>
            <connector x="392" y="143" uid="18">
                <from>CONTAGIOUS_AND_VISIBLY_ILL</from>
                <to>Die_From_Smallpox</to>
            </connector>
            <connector x="93" y="101" uid="19">
                <from>enter_first_infected_but_not_contagious_individual</from>
                <to>Become_Infected</to>
            </connector>
            <button x="533" y="354" width="47" height="27" uid="20" appearance="opaque" background="blue" color="white" style="rounded" clicking_sound="false" label="Back" font-family="Arial" font-size="12" text-align="center" font-weight="bold">
                <link target="back" />
            </button>
            <style font-family="Arial" font-size="9" />
        </display>
        <interface page_cols="6" page_rows="4" page_width="640" page_height="480" scroll_y="1104">
            <simulation_delay>0</simulation_delay>
            <stacked_container x="36" y="108" height="275" width="482" uid="21">
                <graph type="time_series" title="Untitled" background="white" show_grid="true" plot_numbers="true" isee:use_five_segments="true" date_time="2025-02-04T09:22:20Z" cleared="true" time_precision="2" from="0" to="150">
                    <plot index="0" pen_width="1" color="red" precision="0.01" show_y_axis="true">
                        <scale min="0" max="250000" />
                        <entity name="CONTAGIOUS_AND_VISIBLY_ILL" />
                    </plot>
                    <plot index="1" pen_width="1" color="blue" precision="0.01" show_y_axis="true">
                        <scale min="0" max="250000" />
                        <entity name="FUNCTIONING_HEALTHY_POPULATION" />
                    </plot>
                    <plot index="2" pen_width="1" color="fuchsia" precision="0.01" show_y_axis="true">
                        <scale min="0" max="250000" />
                        <entity name="DEAD" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="180" y="131" width="26" height="22" color="#FFC9E4" label_side="bottom" label="Graph 1" type="graph" icon_of="21" />
            <text_box x="40" y="1" uid="22" color="red" font-family="Arial" font-size="12" font-weight="bold" text-align="center" lock_text="true" padding="5" width="507" height="42">WHAT WERE THE DYNAMICS OF THE  SMALLPOX EPIDEMIC IN TENOCHTITLAN IN 1520?</text_box>
            <slider x="294" y="84" color="red" width="197" height="43" min="0" max="1" precision="0.01">
                <entity name="initial_smallpox_mortality_fraction" />
            </slider>
            <button x="530" y="234" width="44" height="33" uid="23" appearance="opaque" background="red" color="white" style="rounded" label="Run" font-family="Arial" font-size="12" text-align="center" font-weight="bold">
                <menu_action>run</menu_action>
            </button>
            <button x="521" y="275" width="63" height="20" uid="24" appearance="opaque" background="red" color="white" style="rounded" label="Clear" font-family="Arial" font-size="12" text-align="center" font-weight="bold">
                <menu_action>restore_all</menu_action>
            </button>
            <slider x="491" y="84" color="red" width="197" height="43" min="0" max="20" precision="1">
                <entity name="contacts_per_day" />
            </slider>
            <slider x="99" y="84" color="red" width="197" height="43" min="0" max="1" precision="0.1">
                <entity name="initial_fraction_of_population_susceptible" />
            </slider>
            <button x="47" y="35" width="107" height="15" uid="25" appearance="opaque" background="blue" color="white" style="rounded" label="Susceptible?" font-family="Arial" font-size="12" text-align="center" font-weight="bold">
                <link target="interface" x="1466" y="0" />
            </button>
            <button x="220" y="37" width="161" height="15" uid="26" appearance="opaque" background="blue" color="white" style="rounded" label="Mortality Fraction?" font-family="Arial" font-size="12" text-align="center" font-weight="bold">
                <link target="interface" x="1466" y="1104" />
            </button>
            <button x="426" y="34" width="140" height="16" uid="27" appearance="opaque" background="blue" color="white" style="rounded" label="Contacts?" font-family="Arial" font-size="12" text-align="center" font-weight="bold">
                <link target="interface" x="2925" y="0" />
            </button>
            <numeric_display precision="1" delimit_000s="true" color="fuchsia" show_name="true" retain_ending_value="true" uid="28" x="499" y="210">
                <entity name="DEAD" />
            </numeric_display>
            <text_box x="527" y="153" uid="29" color="fuchsia" font-family="Arial" font-size="10" font-weight="bold" padding="5" width="57" height="49">TOTAL&#x0D;AZTEC DEAD:</text_box>
            <text_box x="22" y="1108" uid="30" color="red" font-family="Arial" font-size="14" font-weight="bold" text-align="center" padding="5" width="546" height="48">WERE THE AZTEC DEFEATED BY SPANISH GUNS OR GERMS?&#x0D;Revisiting the Smallpox Epidemic in Tenochtitlan in 1520 </text_box>
            <button x="457" y="1457" width="123" height="23" uid="31" appearance="opaque" background="blue" color="white" style="rounded" clicking_sound="false" label="To Simulation" font-family="Arial" font-size="12" text-align="center" font-weight="bold">
                <link target="interface" x="0" y="0" />
            </button>
            <graphics_frame x="399" y="1159" uid="32" width="167" height="206" border-color="#0CA0FF" fill="none">
                <image size_to_parent="true" width="253" height="347">data:image/png;base64,</image>
            </graphics_frame>
            <text_box x="25" y="1157" uid="33" color="black" font-family="Times New Roman" font-size="12" padding="5" width="369" height="214">Recent scholarship such as Albert Crosby&apos;s book, The Columbian Exchange, has raised new questions about the virulence of European diseases upon native American populations during the initial encounters.  Regrettably, there is only limited historical evidence which definitively explains the likely course of epidemic disease spread among native peoples.&#x0D;&#x0D;This is particularly true in the case of a known smallpox epidemic which erupted in the Aztec capital of Tenochtitlan during the fall of 1520.  Following on the heels of Hernando Cortez&apos;s ill-fated escape with his tiny army of 400 Spaniards, the specific dynamics of this epidemic are largely unknown.  Aztec sources, written after the Spanish conquest, assert that the epidemic was a powerful one; however, these same sources offer no connection between the epidemic (which ended in late December, 1520) and the successful Spanish attack of the city between May and August, 1521.  Spanish sources, in turn, barely mention the disease at all, acknowledging that the Aztec King, who had vanquished them from his city, had fallen victim to the disease, as had some other prominent leaders in the region. </text_box>
            <text_box x="24" y="1362" uid="34" color="black" font-family="Times New Roman" font-size="12" padding="5" width="518" height="46">Much like the Aztec, however, the Spaniards make no connection between the epidemic and Cortez&apos;s return to Tecnochtitlan (this time, with a native army of more than 80,000 joining with the 1,000 or so Spanish Conquistadors). </text_box>
            <text_box x="22" y="1402" uid="35" color="blue" font-family="Times New Roman" font-size="12" font-style="italic" padding="5" width="470" height="70">Did the epidemic play a significant role in the defeat of the Aztec?  To answer this, we&apos;ve constructed a &quot;model&quot; of the epidemic with which to &quot;reconstruct&quot; what happened.  As is always the case, the quality of the model&apos;s output will only be as strong as the quality of your thinking in defining it.  We&apos;ll assume you&apos;ve carefully reviewed the materials which have been designed to assist you with the challenge.  Thus prepared, we invite you to  proceed.</text_box>
            <text_box x="1526" y="2" uid="36" color="red" font-family="Arial" font-size="14" font-weight="bold" text-align="center" padding="5" width="476" height="48">What fraction of the Aztec Population was &quot;Susceptible&quot; to Becoming Infected?</text_box>
            <button x="1994" y="347" width="49" height="29" uid="37" appearance="opaque" background="blue" color="white" style="rounded" clicking_sound="false" label="Back" font-family="Arial" font-size="12" text-align="center" font-weight="bold">
                <link target="interface" x="0" y="0" />
            </button>
            <text_box x="1516" y="66" uid="38" color="black" font-family="Times New Roman" font-size="12" padding="5" width="483" height="262">When you think about diseases, you recognize that some people are more likely (or unlikely) to become infected than others.  In the case of certain diseases, once you&apos;ve had the disease (measles, mumps, etc.) you become IMMUNE and are no longer susceptible to becoming infected a second time.  In other cases involving diseases that can strike multiple times, some people have greater NATURAL IMMUNTIES which are likely to be the product of genetic backgrounds and adaptation.&#x0D;&#x0D;Where does that lead us when coonsidering the fraction of the Aztec likely to have been susceptible to infection with the smallpox virus? Consider the facts:&#x0D;&#x0D;         • We know that they had never before been exposed to smallpox;&#x0D;&#x0D;         • We know, in the case of other so-called &quot;virgin soil&quot; epidemics (where populations have&#x0D;               no previous exposure and, subsequently, no natural immunities), the fraction of the&#x0D;               population who has been susceptible to becoming infected can be quite large, with &#x0D;               historical evidence ranging from 10% upwards of 75% of the population.&#x0D;&#x0D;  You&apos;ve been given a packet of materials which provide additional information which should be helpful for generated a more precise number (albeit, still an educated guess!)  We encourage you to review the materials carefully before selecting one or more options. </text_box>
            <text_box x="1521" y="1111" uid="39" color="red" font-family="Arial" font-size="14" font-weight="bold" text-align="center" padding="5" width="481" height="48">What Fraction of the Aztec Who Contracted the Disease Would Likely Have Died From It?</text_box>
            <text_box x="1512" y="1184" uid="40" color="black" font-family="Times New Roman" font-size="12" padding="5" width="510" height="226">This is an interesting question.  Here we have several sets of data, some conflicting:&#x0D;&#x0D;&#x0D;       • Aztec sources suggest that mortality rates were high, but give no indication of numbers;&#x0D;&#x0D;       • Spanish sources vary, some suggesting a mortality rate as high as 50%, others, only a &#x0D;            tiny fraction.&#x0D;&#x0D;      •  Scholars, too, disagree. Most cite other &quot;virgin soil&quot; epidemics which occurred in the most&#x0D;            recent past and for which we have solid mortality figures to suggest a higher rate, between&#x0D;            25 and 50%, is most likely.  Others, observing the limited discussion which the epidemic&#x0D;            generates within primary sources, assert the fraction was comparable to Europe, at less than&#x0D;            10%.&#x0D;&#x0D;&#x0D;With this evidence in hand, you again have the oppotunity to select one or more fractions which make the best sense to you and explore the results. </text_box>
            <button x="1990" y="1449" width="49" height="28" uid="41" appearance="opaque" background="blue" color="white" style="rounded" clicking_sound="false" label="Back" font-family="Arial" font-size="12" text-align="center" font-weight="bold">
                <link target="back" />
            </button>
            <button x="3459" y="349" width="49" height="30" uid="42" appearance="opaque" background="blue" color="white" style="rounded" clicking_sound="false" label="Back" font-family="Arial" font-size="12" text-align="center" font-weight="bold">
                <link target="back" />
            </button>
            <text_box x="2966" y="5" uid="43" color="red" font-family="Arial" font-size="14" font-weight="bold" text-align="center" padding="5" width="520" height="48">HOW MANY &quot;CONTACTS&quot; DID A CATAGIOUS AZTEC INDIVIDUAL  HAVE IN A DAY?</text_box>
            <text_box x="2955" y="63" uid="44" color="black" font-family="Times New Roman" font-size="12" padding="5" width="537" height="262">Suffice it to say, this one&apos;s a challenge!  At best, we can answer this question indirectly, by weighing some key variables and comparing the Aztec situation with some current projections. Recognizing that the smallpox virus is transmitted through open sores (delightful, isn&apos;t it?), we need to consider:&#x0D;&#x0D;      • the number of direct human contacts, between family members, friends, and others who would come&#x0D;           into contact with the individual him or herself.&#x0D;&#x0D;      • alternately, we need to consider that the live virus can be transmitted for some length of time via the&#x0D;           clothing or blankets with which an infect individual came into contact. &#x0D;&#x0D;Now, consider a modern circumstance.  Scholars projecting a &quot;what if&quot; attack by terrorists using smallpox have gravitated toward a figure of 40 contacts per day.  This assumes that an attack will occur within a highly densely populated area and will involve contacts with hospital personnel. &#x0D;&#x0D;If we compare this with the Aztec, we know, based on our reading of various sources, that the city of Tenochtitlan was also densely populated and people, especially families lived within close proximity of one another. We also know that people would not have followed any particular regimen as far as disposing of infected persons&apos; bedding or clothes.&#x0D;&#x0D;Where does that leave us? Here again, you have options for defining contagious contacts for infected individuals each day. </text_box>
            <button x="520" y="302" width="67" height="33" uid="45" appearance="opaque" background="red" color="white" style="rounded" label="Debrief" font-family="Arial" font-size="12" text-align="center" font-weight="bold">
                <link target="interface" x="2928" y="1106" />
            </button>
            <button x="3463" y="1446" width="46" height="32" uid="46" appearance="opaque" background="blue" color="white" style="rounded" clicking_sound="false" label="Back" font-family="Arial" font-size="12" text-align="center" font-weight="bold">
                <link target="back" />
            </button>
            <text_box x="3114" y="1109" uid="47" color="red" font-family="Arial" font-size="14" font-weight="bold" text-align="center" padding="5" width="222" height="29">LET&apos;S REVIEW</text_box>
            <text_box x="2951" y="1145" uid="48" color="black" font-family="Times New Roman" font-size="12" padding="5" width="538" height="106">What do we know?  Based upon historical sources we know:&#x0D;&#x0D;         • Smallpox has struck Tenochtitlan and other large cities in the area.&#x0D;         • The Spaniards have been largely immune from the disease.&#x0D;         • The Aztec emperor is dead, as are numbers of other leaders in the area&#x0D;&#x0D;         • Cortez is regrouping, rearming, and successfully forging alliances with native peoples newly&#x0D;               willing to join him for a new assualt on Tenochtitlan.</text_box>
            <text_box x="2955" y="1256" uid="49" color="black" font-family="Times New Roman" font-size="12" padding="5" width="498" height="34">Now, we have a better understanding of what the epidemic must have looked like from an Aztec perspective.  Of the original population of 250,000 residents of the city:</text_box>
            <numeric_display precision="1" delimit_000s="true" color="red" show_name="true" retain_ending_value="true" uid="50" x="3355" y="1297">
                <entity name="DEAD" />
            </numeric_display>
            <numeric_display precision="1" delimit_000s="true" color="red" show_name="true" retain_ending_value="true" uid="51" x="3355" y="1321">
                <entity name="total_living_population" />
            </numeric_display>
            <numeric_display precision="1" delimit_000s="true" color="red" show_name="true" retain_ending_value="true" uid="52" x="3355" y="1346">
                <entity name="IMMUNE" />
            </numeric_display>
            <text_box x="3007" y="1292" uid="53" color="red" font-family="Times New Roman" font-size="12" padding="5" width="264" height="70">This is the total number who died of smallpox.......&#x0D;&#x0D;This is the size of the remaining population..........&#x0D;&#x0D;This is the number who survived the disease........ </text_box>
            <text_box x="2951" y="1360" uid="54" color="blue" font-family="Times New Roman" font-size="12" padding="5" width="499" height="118">Now, for some better questions to consider:&#x0D;&#x0D;(1) Were there likely to be military ramifications arising from the epidemic?  If so, why didn&apos;t the     &#x0D;      Aztec elaborate upon these in their later accounts?&#x0D;&#x0D;(2) Were there psychological ramifications associated with the epidemic, either impacting upon the &#x0D;      Aztec directly or indirectly upon other native peoples and/or the Spanish Conquistators?&#x0D;&#x0D;(3) What other evidence could/should we review to test out our hypotheses?  </text_box>
            <button x="530" y="345" width="48" height="32" uid="55" appearance="opaque" background="blue" color="white" style="rounded" clicking_sound="false" label="Back" font-family="Arial" font-size="12" text-align="center" font-weight="bold">
                <link target="interface" x="0" y="1104" />
            </button>
            <button x="513" y="1419" width="62" height="30" uid="56" appearance="opaque" background="blue" color="white" style="rounded" clicking_sound="false" label="See model" font-family="Arial" font-size="12" text-align="center" font-weight="bold">
                <link target="model" x="0" y="8" />
            </button>
            <style font-family="Arial" font-size="9" />
        </interface>
        <style font-family="Arial" font-size="9" />
    </model>
</xmile>
