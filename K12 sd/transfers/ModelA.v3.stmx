<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" level="3" xmlns="http://www.systemdynamics.org/XMILE" xmlns:isee="http://iseesystems.com/XMILE">
    <header>
        <smile version="1.0" namespace="std, isee">
            <uses_arrays>1</uses_arrays>
        </smile>
        <name>ModelA.v3</name>
        <uuid>dd247f8e-1246-4c9a-8591-4359ea46622d</uuid>
        <vendor>isee systems, inc.</vendor>
        <product version="10.1.2" isee:saved_by_v1="false" lang="en">iThink</product>
    </header>
    <style>
        <model font-family="Arial" font-size="9" />
        <interface font-family="Arial" font-size="9" />
    </style>
    <sim_specs method="Euler" time_units="Years" isee:pause_after_rates="false" isee:instantaneous_flows="false">
        <start>0</start>
        <stop>12</stop>
        <dt>1</dt>
        <isee:analyze_mode>false</isee:analyze_mode>
    </sim_specs>
    <dimensions>
        <dim name="Dim_Name_1" size="1" />
    </dimensions>
    <model_units />
    <isee:prefs last_model="true" layer="model" grid_width="20" grid_height="50" divide_by_zero_alert="true" hide_taskbar="true" show_module_prefix="true">
        <isee:window width="1366" height="685" />
        <isee:security />
        <isee:print_setup width="595" height="775" />
    </isee:prefs>
    <isee:equation_prefs order_by="sector" />
    <model>
        <stock name="Squirrels">
            <doc>Initial number of squirrels in spring</doc>
            <eqn>100</eqn>
            <inflow>Net_Growth</inflow>
            <non_negative />
            <display x="224" y="66" color="blue" />
        </stock>
        <flow name="Net_Growth">
            <eqn>Growth_Rate*Squirrels</eqn>
            <non_negative />
            <display x="153" y="59" color="blue">
                <pts>
                    <pt x="102" y="59" />
                    <pt x="204" y="59" />
                </pts>
            </display>
        </flow>
        <aux name="Growth_Rate">
            <doc>4&#x0D;</doc>
            <eqn>.1</eqn>
            <display x="96" y="123" color="blue" />
        </aux>
        <display page_width="595" page_height="775" isee:converter_size="medium" interval="DT">
            <connector x="204" y="82" uid="0">
                <from>Squirrels</from>
                <to>Net_Growth</to>
            </connector>
            <connector x="101" y="116" uid="1">
                <from>Growth_Rate</from>
                <to>Net_Growth</to>
            </connector>
            <stacked_container height="282" width="492" uid="2">
                <graph type="time_series" title="Population Graph" background="#C8C8C8" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-07T15:47:06Z" cleared="true" time_precision="0" from="0" to="12">
                    <plot index="0" pen_width="1" color="red" precision="1" show_y_axis="true">
                        <entity name="Squirrels" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="86" y="192" width="26" height="22" color="#0CA0FF" label_side="bottom" label="Graph 1" type="graph" icon_of="2" />
            <stacked_container height="286" width="465" uid="3">
                <table font-size="9" background="#FFFE91" column_width="60" orientation="vertical" interval="1" cleared="true" date_time="1995-09-08T14:39:10Z">
                    <title>Population Values</title>
                    <item type="time" color="black" precision="0.01" width="100" />
                    <item color="black" precision="0.01" delimit_000s="true" index="0">
                        <entity name="Squirrels" />
                    </item>
                    <item color="black" precision="0.01" delimit_000s="true" index="1">
                        <entity name="Net_Growth" />
                    </item>
                </table>
            </stacked_container>
            <pad_icon x="149" y="191" width="26" height="22" color="#008F44" label_side="bottom" label="Table 1" type="table" icon_of="3" />
            <style font-family="Arial" font-size="9" />
        </display>
        <interface page_cols="0" page_rows="0" page_width="788" page_height="528" home_page="0">
            <simulation_delay>0.1</simulation_delay>
            <style font-family="Arial" font-size="9" />
        </interface>
        <popup x="16" y="78" content="2" />
        <popup x="16" y="78" content="3" />
        <style font-family="Arial" font-size="9" />
    </model>
</xmile>
