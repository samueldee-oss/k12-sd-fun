<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" level="3" xmlns="http://www.systemdynamics.org/XMILE" xmlns:isee="http://iseesystems.com/XMILE">
    <header>
        <smile version="1.0" namespace="std, isee">
            <uses_arrays>1</uses_arrays>
        </smile>
        <name>BuiltSmallpox.v6</name>
        <uuid>98829a4f-8cb9-455a-ac51-5e5a985436db</uuid>
        <vendor>isee systems, inc.</vendor>
        <product version="10.1.2" isee:saved_by_v1="false" lang="en">iThink</product>
    </header>
    <style>
        <model font-family="Arial" font-size="9" />
        <interface font-family="Arial" font-size="9" />
    </style>
    <sim_specs method="Euler" time_units="fortnights" isee:pause_after_rates="false" isee:instantaneous_flows="false">
        <start>0</start>
        <stop>520</stop>
        <dt>0.25</dt>
        <isee:analyze_mode>false</isee:analyze_mode>
    </sim_specs>
    <dimensions>
        <dim name="Dim_Name_1" size="1" />
    </dimensions>
    <model_units />
    <isee:prefs last_model="true" layer="interface" grid_width="20" grid_height="50" divide_by_zero_alert="true" link_high_level_map="true" show_module_prefix="true">
        <isee:window width="623" height="429" />
        <isee:security password="true" />
        <isee:print_setup width="730" height="552" />
    </isee:prefs>
    <isee:equation_prefs order_by="sector" />
    <model>
        <stock name="SUSCEPTIBLE">
            <eqn>initial_total_population * (1 - initial_fraction_immune)</eqn>
            <inflow>Births</inflow>
            <outflow>Become_Infected</outflow>
            <outflow>Susceptible_Deaths</outflow>
            <non_negative />
            <display x="115" y="130" color="blue" label_angle="142" />
        </stock>
        <stock name="INFECTED_BUT_NOT_CONTAGIOUS">
            <eqn>1</eqn>
            <inflow>Become_Infected</inflow>
            <outflow>Rash_Develops</outflow>
            <non_negative />
            <display x="243" y="130" color="blue" label_angle="57" />
        </stock>
        <flow name="Become_Infected">
            <eqn>ILL_&amp;_CONTAGIOUS*number_of_contacts*prob_contact_is_susceptible*prob_of_infection</eqn>
            <non_negative />
            <display x="179" y="143" color="blue" label_side="top">
                <pts>
                    <pt x="135" y="143" />
                    <pt x="223" y="143" />
                </pts>
            </display>
        </flow>
        <aux name="number_of_contacts">
            <eqn>60</eqn>
            <display x="180" y="215" color="blue" />
        </aux>
        <aux name="prob_of_infection">
            <eqn>.25</eqn>
            <display x="237" y="198" color="blue" />
        </aux>
        <aux name="prob_contact_is_susceptible">
            <eqn>SUSCEPTIBLE/(total_population-1)</eqn>
            <display x="190" y="72" color="blue" label_side="top" label_angle="93" />
        </aux>
        <stock name="ILL_&amp;_CONTAGIOUS">
            <eqn>0</eqn>
            <inflow>Rash_Develops</inflow>
            <outflow>Recover</outflow>
            <outflow>Die_of_Smallpox</outflow>
            <non_negative />
            <display x="366" y="130" color="blue" label_angle="48" />
        </stock>
        <flow name="Rash_Develops">
            <eqn>INFECTED_BUT_NOT_CONTAGIOUS</eqn>
            <non_negative />
            <display x="304" y="135" color="blue" label_side="top">
                <pts>
                    <pt x="263" y="135" />
                    <pt x="346" y="135" />
                </pts>
            </display>
        </flow>
        <stock name="IMMUNE">
            <eqn>initial_total_population*initial_fraction_immune</eqn>
            <inflow>Recover</inflow>
            <outflow>Immune_Deaths</outflow>
            <non_negative />
            <display x="461" y="126" color="blue" />
        </stock>
        <stock name="DEAD_FROM_SMALLPOX">
            <eqn>0</eqn>
            <inflow>Die_of_Smallpox</inflow>
            <non_negative />
            <display x="335" y="244" color="blue" label_side="bottom" label_angle="279" />
        </stock>
        <flow name="Recover">
            <eqn>ILL_&amp;_CONTAGIOUS*(1-smallpox_mortality_fract)</eqn>
            <non_negative />
            <display x="413" y="137" color="blue" label_side="top">
                <pts>
                    <pt x="386" y="137" />
                    <pt x="441" y="137" />
                </pts>
            </display>
        </flow>
        <flow name="Die_of_Smallpox">
            <eqn>ILL_&amp;_CONTAGIOUS*smallpox_mortality_fract</eqn>
            <non_negative />
            <display x="354" y="187" color="blue" label_side="left" label_angle="177">
                <pts>
                    <pt x="354" y="145" />
                    <pt x="354" y="229" />
                </pts>
            </display>
        </flow>
        <aux name="smallpox_mortality_fract">
            <eqn>.3</eqn>
            <display x="415" y="225" color="blue" label_angle="292" />
        </aux>
        <flow name="Births">
            <eqn>birth_rate*childbearing_population</eqn>
            <non_negative />
            <display x="76" y="128" color="blue">
                <pts>
                    <pt x="58" y="128" />
                    <pt x="95" y="128" />
                </pts>
            </display>
        </flow>
        <flow name="Susceptible_Deaths">
            <eqn>SUSCEPTIBLE*birth_rate*.99</eqn>
            <non_negative />
            <display x="124" y="193" color="blue" label_side="left" label_angle="177">
                <pts>
                    <pt x="124" y="145" />
                    <pt x="124" y="241" />
                </pts>
            </display>
        </flow>
        <flow name="Immune_Deaths">
            <eqn>IMMUNE*birth_rate*.99</eqn>
            <non_negative />
            <display x="451" y="177" color="blue" label_angle="325">
                <pts>
                    <pt x="451" y="141" />
                    <pt x="451" y="214" />
                </pts>
            </display>
        </flow>
        <aux name="total_population">
            <eqn>ILL_&amp;_CONTAGIOUS+IMMUNE+INFECTED_BUT_NOT_CONTAGIOUS+SUSCEPTIBLE</eqn>
            <display x="381" y="378" color="blue" />
        </aux>
        <aux name="childbearing_population">
            <eqn>IMMUNE+SUSCEPTIBLE</eqn>
            <display x="60" y="283" color="blue" label_side="right" label_angle="9" />
        </aux>
        <aux name="birth_rate">
            <eqn>annual_birth_rate/26</eqn>
            <display x="28" y="94" color="blue" label_side="top" label_angle="74" />
        </aux>
        <aux name="initial_total_population">
            <eqn>1000000</eqn>
            <display x="76" y="382" color="blue" />
        </aux>
        <aux name="initial_fraction_immune">
            <eqn>.2</eqn>
            <display x="75" y="336" color="blue" />
        </aux>
        <aux name="annual_birth_rate">
            <eqn>.03</eqn>
            <display x="97" y="52" color="blue" label_side="left" label_angle="174" />
        </aux>
        <display page_width="730" page_height="552" isee:converter_size="large" interval="DT" scroll_y="32">
