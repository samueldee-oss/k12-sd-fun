<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" level="3" xmlns="http://www.systemdynamics.org/XMILE" xmlns:isee="http://iseesystems.com/XMILE">
    <header>
        <smile version="1.0" namespace="std, isee">
            <uses_arrays>1</uses_arrays>
        </smile>
        <name>SocialStudies4.1.v5</name>
        <uuid>22a6d851-f179-4cb5-b68a-468d9bdb090d</uuid>
        <vendor>isee systems, inc.</vendor>
        <product version="10.1.2" isee:saved_by_v1="false" lang="en">iThink</product>
    </header>
    <style>
        <model font-family="Arial" font-size="9" />
        <interface font-family="Arial" font-size="9" />
    </style>
    <sim_specs method="Euler" time_units="Months" isee:pause_after_rates="false" isee:instantaneous_flows="false">
        <start>0</start>
        <stop>12</stop>
        <dt>1</dt>
        <isee:analyze_mode>false</isee:analyze_mode>
    </sim_specs>
    <dimensions>
        <dim name="Dim_Name_1" size="1" />
    </dimensions>
    <model_units />
    <isee:prefs last_model="true" layer="model" grid_width="20" grid_height="50" divide_by_zero_alert="true" link_high_level_map="true" show_module_prefix="true">
        <isee:window width="1334" height="630" />
        <isee:security />
        <isee:print_setup width="552" height="728" />
    </isee:prefs>
    <isee:equation_prefs order_by="sector" />
    <model>
        <stock name="Checking_Account">
            <eqn>0</eqn>
            <inflow>Income</inflow>
            <outflow>Expenses</outflow>
            <outflow>Transfer</outflow>
            <non_negative />
            <display x="229" y="149" color="black" />
        </stock>
        <flow name="Income">
            <eqn>1800</eqn>
            <non_negative />
            <display x="155" y="149" color="black">
                <pts>
                    <pt x="101" y="149" />
                    <pt x="209" y="149" />
                </pts>
            </display>
        </flow>
        <flow name="Expenses">
            <eqn>Food+Housing+Transportation+Utilities</eqn>
            <non_negative />
            <display x="339" y="148" color="black" label_side="top">
                <pts>
                    <pt x="249" y="148" />
                    <pt x="430" y="148" />
                </pts>
            </display>
        </flow>
        <aux name="Housing">
            <eqn>600</eqn>
            <display x="279" y="199" color="black" />
        </aux>
        <aux name="Food">
            <eqn>450</eqn>
            <display x="332" y="226" color="black" />
        </aux>
        <aux name="Transportation">
            <eqn>250</eqn>
            <display x="396" y="226" color="black" />
        </aux>
        <aux name="Utilities">
            <eqn>150</eqn>
            <display x="453" y="197" color="black" />
        </aux>
        <stock name="Savings_Account">
            <eqn>0</eqn>
            <inflow>Transfer</inflow>
            <inflow>Interest_Income</inflow>
            <non_negative />
            <display x="231" y="287" color="black" label_side="bottom" />
        </stock>
        <flow name="Transfer">
            <eqn>Checking_Account</eqn>
            <non_negative />
            <display x="230" y="218" color="black" label_side="left">
                <pts>
                    <pt x="230" y="164" />
                    <pt x="230" y="272" />
                </pts>
            </display>
        </flow>
        <flow name="Interest_Income">
            <eqn>Savings_Account*Interest_Rate</eqn>
            <non_negative />
            <display x="156" y="288" color="black" label_side="top">
                <pts>
                    <pt x="101" y="288" />
                    <pt x="211" y="288" />
                </pts>
            </display>
        </flow>
        <aux name="Interest_Rate">
            <eqn>.05/12</eqn>
            <display x="93" y="340" color="black" />
        </aux>
        <display page_width="552" page_height="728" isee:converter_size="large" interval="DT">
            <connector x="289" y="193" uid="0">
                <from>Housing</from>
                <to>Expenses</to>
            </connector>
            <connector x="339" y="216" uid="1">
                <from>Food</from>
                <to>Expenses</to>
            </connector>
            <connector x="388" y="217" uid="2">
                <from>Transportation</from>
                <to>Expenses</to>
            </connector>
            <connector x="441" y="194" uid="3">
                <from>Utilities</from>
                <to>Expenses</to>
            </connector>
            <connector x="208" y="299" uid="4">
                <from>Savings_Account</from>
                <to>Interest_Income</to>
            </connector>
            <connector x="103" y="334" uid="5">
                <from>Interest_Rate</from>
                <to>Interest_Income</to>
            </connector>
            <connector x="243" y="166" uid="6">
                <from>Checking_Account</from>
                <to>Transfer</to>
            </connector>
            <stacked_container height="282" width="492" uid="7">
                <graph type="time_series" title="Untitled Graph" background="#C8C8C8" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-04T10:13:40Z" cleared="true" time_precision="2" from="0" to="12">
                    <plot index="0" pen_width="1" color="red" precision="0.01" show_y_axis="true">
                        <scale min="0" max="5000" />
                        <entity name="Checking_Account" />
                    </plot>
                    <plot index="1" pen_width="1" color="blue" precision="0.01" show_y_axis="true">
                        <scale min="0" max="5000" />
                        <entity name="Savings_Account" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="37" y="172" width="26" height="22" color="black" label_side="bottom" label="Graph 1" type="graph" icon_of="7" />
            <stacked_container height="286" width="465" uid="8">
                <table font-size="9" background="#FFFE91" column_width="60" orientation="vertical" interval="1" cleared="true" date_time="1997-07-16T23:06:41Z">
                    <title>Untitled Table</title>
                    <item type="time" color="black" width="100" />
                    <item color="black" precision="0.01" delimit_000s="true" index="0">
                        <entity name="Checking_Account" />
                    </item>
                    <item color="black" precision="0.01" delimit_000s="true" index="1">
                        <entity name="Savings_Account" />
                    </item>
                </table>
            </stacked_container>
            <pad_icon x="40" y="112" width="26" height="22" color="black" label_side="bottom" label="Table 1" type="table" icon_of="8" />
            <style font-family="Arial" font-size="9" />
        </display>
        <interface page_cols="0" page_rows="0" page_width="640" page_height="480" home_page="0">
            <simulation_delay>0</simulation_delay>
            <style font-family="Arial" font-size="9" />
        </interface>
        <popup x="8" y="51" content="7" />
        <popup x="8" y="51" content="8" />
        <style font-family="Arial" font-size="9" />
    </model>
