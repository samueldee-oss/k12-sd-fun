<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" level="3" xmlns="http://www.systemdynamics.org/XMILE" xmlns:isee="http://iseesystems.com/XMILE">
    <header>
        <smile version="1.0" namespace="std, isee">
            <uses_arrays>1</uses_arrays>
        </smile>
        <name>The Rainforest Game</name>
        <uuid>4ecb92d3-9c5b-4994-ade1-69c8afb47985</uuid>
        <vendor>isee systems, inc.</vendor>
        <product version="10.1.2" isee:saved_by_v1="false" lang="en">iThink</product>
    </header>
    <style>
        <model font-family="Arial" font-size="18" />
        <interface font-family="Arial" font-size="9" />
    </style>
    <sim_specs method="Euler" time_units="Years" isee:pause_after_rates="false" isee:instantaneous_flows="false">
        <start>0</start>
        <stop>50</stop>
        <dt>1</dt>
    </sim_specs>
    <dimensions>
        <dim name="Dim_Name_1" size="1" />
    </dimensions>
    <model_units />
    <isee:prefs last_model="true" layer="interface" grid_width="20" grid_height="50" divide_by_zero_alert="true" hide_taskbar="true" show_module_prefix="true">
        <isee:window width="989" height="584" />
        <isee:security />
        <isee:print_setup width="576" height="768" />
    </isee:prefs>
    <isee:equation_prefs order_by="module" />
    <model>
        <stock name="Seeds_in_ground">
            <eqn>3</eqn>
            <inflow>Planting__seeds</inflow>
            <outflow>Sprouting</outflow>
            <non_negative />
            <display x="237" y="151" color="blue" />
        </stock>
        <flow name="Planting_\nseeds">
            <eqn>3</eqn>
            <non_negative />
            <display x="161" y="161" color="blue" label_side="left" label_angle="264">
                <pts>
                    <pt x="107" y="161" />
                    <pt x="215" y="161" />
                </pts>
            </display>
        </flow>
        <stock name="Sprouts">
            <eqn>3</eqn>
            <inflow>Sprouting</inflow>
            <outflow>Growing</outflow>
            <non_negative />
            <display x="386" y="157" color="blue" />
        </stock>
        <stock name="Saplings">
            <eqn>3</eqn>
            <inflow>Growing</inflow>
            <outflow>Maturing</outflow>
            <non_negative />
            <display x="528" y="159" color="blue" />
        </stock>
        <stock name="Mature_trees">
            <eqn>25</eqn>
            <inflow>Maturing</inflow>
            <outflow>Harvesting</outflow>
            <non_negative />
            <display x="701" y="159" color="blue" />
        </stock>
        <flow name="Sprouting">
            <eqn>Seeds_in_ground</eqn>
            <non_negative />
            <display x="311" y="154" color="blue">
                <pts>
                    <pt x="259" y="154" />
                    <pt x="364" y="154" />
                </pts>
            </display>
        </flow>
        <flow name="Growing">
            <eqn>Sprouts</eqn>
            <non_negative />
            <display x="457" y="159" color="blue">
                <pts>
                    <pt x="408" y="159" />
                    <pt x="506" y="159" />
                </pts>
            </display>
        </flow>
        <flow name="Maturing">
            <eqn>Saplings</eqn>
            <non_negative />
            <display x="614" y="163" color="blue">
                <pts>
                    <pt x="550" y="163" />
                    <pt x="679" y="163" />
                </pts>
            </display>
        </flow>
        <flow name="Harvesting">
            <eqn>3 + step(2,10)</eqn>
            <non_negative />
            <display x="802" y="158" color="blue">
                <pts>
                    <pt x="723" y="158" />
                    <pt x="881" y="158" />
                </pts>
            </display>
        </flow>
        <stock name="Seeds_in_ground_2">
            <eqn>5</eqn>
            <inflow>Planting__seeds_2</inflow>
            <outflow>Sprouting_2</outflow>
            <non_negative />
            <display x="230" y="318" color="blue" />
        </stock>
        <flow name="Planting_\nseeds_2">
            <eqn>IF(TIME&lt;6) THEN 5 ELSE(Harvesting_policy_beginning_year_6)</eqn>
            <non_negative />
            <display x="154" y="328" color="blue" label_side="left" label_angle="264">
                <pts>
                    <pt x="100" y="328" />
                    <pt x="208" y="328" />
                </pts>
            </display>
        </flow>
        <stock name="Sprouts_2">
            <eqn>5</eqn>
            <inflow>Sprouting_2</inflow>
            <outflow>Growing_2</outflow>
            <non_negative />
            <display x="379" y="324" color="blue" />
        </stock>
        <stock name="Saplings_2">
            <eqn>5</eqn>
            <inflow>Growing_2</inflow>
            <outflow>Maturing_2</outflow>
            <non_negative />
            <display x="521" y="327" color="blue" />
        </stock>
        <stock name="Mature_trees_2">
            <eqn>25</eqn>
            <inflow>Maturing_2</inflow>
            <outflow>Harvesting_2</outflow>
            <non_negative />
            <display x="694" y="326" color="blue" />
        </stock>
        <flow name="Sprouting_2">
            <eqn>Seeds_in_ground_2</eqn>
            <non_negative />
            <display x="304" y="321" color="blue">
                <pts>
                    <pt x="252" y="321" />
                    <pt x="357" y="321" />
                </pts>
            </display>
        </flow>
        <flow name="Growing_2">
            <eqn>Sprouts_2</eqn>
            <non_negative />
            <display x="450" y="326" color="blue">
                <pts>
                    <pt x="401" y="326" />
                    <pt x="499" y="326" />
                </pts>
            </display>
        </flow>
        <flow name="Maturing_2">
            <eqn>Saplings_2</eqn>
            <non_negative />
            <display x="607" y="330" color="blue">
                <pts>
                    <pt x="543" y="330" />
                    <pt x="672" y="330" />
                </pts>
            </display>
        </flow>
        <flow name="Harvesting_2">
            <eqn>5- Step(5,6)+STEP(Harvesting_policy_beginning_year_6,6)</eqn>
            <non_negative />
            <display x="800" y="325" color="blue" label_side="right" label_angle="278">
                <pts>
                    <pt x="716" y="325" />
                    <pt x="885" y="325" />
                </pts>
            </display>
        </flow>
        <aux name="Harvesting_policy_beginning_year_6">
            <eqn>0</eqn>
            <display x="791" y="426" color="blue" />
        </aux>
        <display page_width="576" page_height="768" page_cols="2" isee:converter_size="medium" isee:animate_flows="true" isee:animate_stocks="true" isee:animate_converters="true" interval="DT">
            <connector x="259" y="165" uid="0">
                <from>Seeds_in_ground</from>
                <to>Sprouting</to>
            </connector>
            <connector x="408" y="168" uid="1">
                <from>Sprouts</from>
                <to>Growing</to>
            </connector>
            <connector x="550" y="172" uid="2">
                <from>Saplings</from>
                <to>Maturing</to>
            </connector>
            <connector x="252" y="332" uid="3">
                <from>Seeds_in_ground_2</from>
                <to>Sprouting_2</to>
            </connector>
            <connector x="401" y="335" uid="4">
                <from>Sprouts_2</from>
                <to>Growing_2</to>
            </connector>
            <connector x="543" y="344" uid="5">
                <from>Saplings_2</from>
                <to>Maturing_2</to>
            </connector>
            <connector x="776" y="430" uid="6">
                <from>Harvesting_policy_beginning_year_6</from>
                <to>Planting__seeds_2</to>
            </connector>
            <connector x="789" y="417" uid="7">
                <from>Harvesting_policy_beginning_year_6</from>
                <to>Harvesting_2</to>
            </connector>
            <style font-family="Arial" font-size="18" />
        </display>
        <interface show_pages="true" page_cols="3" page_rows="3" page_width="1012" page_height="696" scroll_x="1012" scroll_y="1392" home_page="8">
            <simulation_delay>0.233054</simulation_delay>
            <stacked_container x="40" y="71" height="282" width="492" uid="8">
                <graph type="time_series" title="Mature Treesin the Forest" background="#FFFFC9" show_grid="true" plot_numbers="true" isee:use_five_segments="false" hide_detail="true" cleared="true" time_precision="2" from="0" to="50">
                    <plot index="0" pen_width="3" color="blue" precision="1" show_y_axis="true">
                        <scale min="0" max="100" />
                        <entity name="Mature_trees" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="285" y="235" width="26" height="22" color="#008F44" label_side="bottom" label="Graph 1" type="graph" icon_of="8" />
            <stacked_container x="70" y="745" height="350" width="610" uid="9">
                <graph type="time_series" title="When the lumberjack and the planter coordinate ..." background="#FFFFC9" show_grid="true" plot_numbers="true" isee:use_five_segments="false" hide_detail="true" cleared="true" time_precision="2" from="0" to="50">
                    <plot index="0" pen_width="3" color="blue" precision="1" show_y_axis="true">
                        <entity name="Mature_trees_2" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="317" y="838" width="26" height="22" color="#008F44" label_side="bottom" label="Graph 2" type="graph" icon_of="9" />
            <stacked_container x="1084" y="36" height="424" width="628" uid="10">
                <table font-size="9" background="#E0E0E0" column_width="79" orientation="vertical" interval="1" cleared="true" date_time="2010-12-09T11:44:58Z">
                    <title>Rainforest Trees</title>
                    <item type="time" color="black" precision="max" width="100" />
                    <item color="black" precision="0.01" delimit_000s="true" index="0">
                        <entity name="Planting__seeds" />
                    </item>
                    <item color="black" precision="0.01" delimit_000s="true" index="1">
                        <entity name="Seeds_in_ground" />
                    </item>
                    <item color="black" precision="0.01" delimit_000s="true" index="2">
