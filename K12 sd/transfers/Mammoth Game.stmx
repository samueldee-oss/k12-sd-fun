            <pad_icon x="1448" y="289" width="26" height="22" color="#008F44" label_side="bottom" label="Graph 2" type="graph" icon_of="5" />
            <stacked_container x="498" y="981" height="257" width="450" uid="6">
                <graph type="time_series" title="Challenge 2" background="#FFFFC9" show_grid="true" plot_numbers="true" isee:use_five_segments="false" hide_detail="true" cleared="true" time_precision="2" from="0" to="20">
                    <plot index="0" pen_width="3" color="blue" precision="1" show_y_axis="true">
                        <entity name="Mammoths" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="1521" y="300" width="26" height="22" color="#008F44" label_side="bottom" label="Graph 3" type="graph" icon_of="6" />
            <stacked_container x="82" y="1930" height="263" width="458" uid="7">
                <graph type="time_series" title="Challenge 3" background="#FFFFC9" show_grid="true" plot_numbers="true" isee:use_five_segments="false" hide_detail="true" cleared="true" time_precision="2" from="0" to="20">
                    <plot index="0" pen_width="3" color="blue" precision="1" show_y_axis="true">
                        <scale min="0" max="100" />
                        <entity name="Mammoths" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="199" y="1086" width="26" height="22" color="#008F44" label_side="bottom" label="Graph 4" type="graph" icon_of="7" />
            <stacked_container x="626" y="1932" height="264" width="460" uid="8">
                <graph type="time_series" title="Challenge 4" background="#FFFFC9" show_grid="true" plot_numbers="true" isee:use_five_segments="false" hide_detail="true" cleared="true" time_precision="2" from="0" to="20">
                    <plot index="0" pen_width="3" color="blue" precision="1" show_y_axis="true">
