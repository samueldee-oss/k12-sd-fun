<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" level="3" xmlns="http://www.systemdynamics.org/XMILE" xmlns:isee="http://iseesystems.com/XMILE">
    <header>
        <smile version="1.0" namespace="std, isee">
            <uses_arrays>1</uses_arrays>
        </smile>
        <name>Mammoth Game</name>
        <uuid>a88b9b8e-fcde-45df-938f-48cfb14ba935</uuid>
        <vendor>isee systems, inc.</vendor>
        <product version="10.1.2" isee:saved_by_v1="false" lang="en">iThink</product>
    </header>
    <style>
        <model font-family="Arial" font-size="18" />
        <interface font-family="Arial" font-size="12" />
    </style>
    <sim_specs method="Euler" time_units="Years" isee:pause_after_rates="false" isee:instantaneous_flows="false">
        <start>0</start>
        <stop>20</stop>
        <dt>1</dt>
    </sim_specs>
    <dimensions>
        <dim name="Dim_Name_1" size="1" />
    </dimensions>
    <model_units />
    <isee:prefs last_model="true" layer="interface" grid_width="20" grid_height="50" divide_by_zero_alert="true" hide_taskbar="true" show_module_prefix="true">
        <isee:window width="1175" height="660" />
        <isee:security />
        <isee:print_setup width="576" height="768" />
    </isee:prefs>
    <isee:equation_prefs order_by="module" />
    <model>
        <stock name="Mammoths">
            <eqn>20</eqn>
            <inflow>Yearly_Births</inflow>
            <outflow>Yearly_Deaths</outflow>
            <non_negative />
            <display x="289" y="190" color="blue" />
        </stock>
        <flow name="Yearly_Births">
            <eqn>Mammoths*Birth_Fraction</eqn>
            <non_negative />
            <display x="185" y="188" color="blue">
                <pts>
                    <pt x="103" y="188" />
                    <pt x="267" y="188" />
                </pts>
            </display>
        </flow>
        <flow name="Yearly_Deaths">
            <eqn>Mammoths*Death_Fraction</eqn>
            <non_negative />
            <display x="398" y="188" color="blue">
                <pts>
                    <pt x="311" y="188" />
                    <pt x="485" y="188" />
                </pts>
            </display>
        </flow>
        <aux name="Birth_Fraction">
            <eqn>1/6</eqn>
            <display x="125" y="335" color="blue" />
        </aux>
        <aux name="Death_Fraction">
            <eqn>1/3</eqn>
            <display x="460" y="344" color="blue" />
        </aux>
        <aux name="Target_Herd">
            <eqn>40</eqn>
            <display x="650" y="184" color="#7F00FF" />
        </aux>
        <aux name="Survival_Goal">
            <eqn>10</eqn>
            <display x="650" y="262" color="#7F00FF" />
        </aux>
        <aux name="Herd_Difference">
            <eqn>IF Mammoths&gt;=Target_Herd THEN Mammoths-Target_Herd ELSE Target_Herd-Mammoths</eqn>
            <display x="650" y="340" color="#7F00FF" />
        </aux>
        <aux name="Game_Score">
            <eqn>max(0,100-Herd_Difference*2)</eqn>
            <display x="650" y="418" color="#7F00FF" />
        </aux>
        <aux name="Survival_Win">
            <eqn>IF Mammoths&gt;=Survival_Goal THEN 1 ELSE 0</eqn>
            <display x="650" y="496" color="#7F00FF" />
        </aux>
        <display page_width="576" page_height="768" page_cols="2" page_rows="2" isee:converter_size="medium" isee:animate_flows="true" isee:animate_stocks="true" isee:animate_converters="true" interval="DT">
            <connector x="119" y="328" uid="0">
                <from>Birth_Fraction</from>
                <to>Yearly_Births</to>
            </connector>
            <connector x="267" y="174" uid="1">
                <from>Mammoths</from>
                <to>Yearly_Births</to>
            </connector>
            <connector x="311" y="180" uid="2">
                <from>Mammoths</from>
                <to>Yearly_Deaths</to>
            </connector>
            <connector x="463" y="334" uid="3">
                <from>Death_Fraction</from>
                <to>Yearly_Deaths</to>
            </connector>
            <connector x="604" y="276" uid="36">
                <from>Mammoths</from>
                <to>Herd_Difference</to>
            </connector>
            <connector x="650" y="226" uid="37">
                <from>Target_Herd</from>
                <to>Herd_Difference</to>
            </connector>
            <connector x="650" y="380" uid="38">
                <from>Herd_Difference</from>
                <to>Game_Score</to>
            </connector>
            <connector x="592" y="420" uid="39">
                <from>Mammoths</from>
                <to>Survival_Win</to>
            </connector>
            <connector x="650" y="458" uid="40">
                <from>Survival_Goal</from>
                <to>Survival_Win</to>
            </connector>
            <style font-family="Arial" font-size="18" />
        </display>
        <interface show_pages="true" page_cols="3" page_rows="3" page_width="1268" page_height="952" scroll_x="1268" scroll_y="952" home_page="5">
            <simulation_delay>0.1</simulation_delay>
            <stacked_container x="31" y="43" height="282" width="492" uid="4">
                <graph type="time_series" title="Large Herd" background="#FFFFC9" show_grid="true" plot_numbers="true" isee:use_five_segments="false" hide_detail="true" cleared="true" time_precision="0" from="0" to="20">
                    <plot index="0" pen_width="3" color="blue" precision="1" show_y_axis="true">
                        <scale min="0" max="100" />
                        <entity name="Mammoths" />
                    </plot>
