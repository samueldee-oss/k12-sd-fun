            <pad_icon x="175" y="61" width="26" height="22" color="#008F44" label_side="bottom" label="Graph 1" type="graph" icon_of="4" />
            <stacked_container x="29" y="980" height="259" width="450" uid="5">
                <graph type="time_series" title="Challenge 1" background="#FFFFC9" show_grid="true" plot_numbers="true" isee:use_five_segments="false" hide_detail="true" cleared="true" time_precision="2" from="0" to="20">
                    <plot index="0" pen_width="3" color="blue" precision="1" show_y_axis="true">
