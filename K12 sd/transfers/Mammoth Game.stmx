            <numeric_display precision="0" display_as="number" color="#7F00FF" show_name="true" retain_ending_value="true" uid="35" x="768" y="650">
                <entity name="Target_Herd" />
            </numeric_display>
            <graphics_frame x="1967" y="1327" uid="28" width="125" height="149" border-color="black" border-style="solid" border-width="thin" fill="none">
