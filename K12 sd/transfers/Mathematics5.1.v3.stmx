<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" level="3" xmlns="http://www.systemdynamics.org/XMILE" xmlns:isee="http://iseesystems.com/XMILE">
    <header>
        <smile version="1.0" namespace="std, isee">
            <uses_arrays>1</uses_arrays>
        </smile>
        <name>Mathematics5.1.v3</name>
        <uuid>df43095e-6cda-455d-8134-f72077df0b8f</uuid>
        <vendor>isee systems, inc.</vendor>
        <product version="10.1.2" isee:saved_by_v1="false" lang="en">iThink</product>
    </header>
    <style>
        <model font-family="Arial" font-size="9" />
        <interface font-family="Arial" font-size="9" />
    </style>
    <sim_specs method="Euler" time_units="Days" isee:pause_after_rates="false" isee:instantaneous_flows="false">
        <start>0</start>
        <stop>7</stop>
        <dt>1</dt>
        <isee:analyze_mode>false</isee:analyze_mode>
    </sim_specs>
    <dimensions>
        <dim name="Dim_Name_1" size="1" />
    </dimensions>
    <model_units />
    <isee:prefs last_model="true" layer="model" grid_width="20" grid_height="50" divide_by_zero_alert="true" hide_taskbar="true" show_module_prefix="true">
        <isee:window width="1366" height="685" />
        <isee:security />
        <isee:print_setup width="595" height="775" />
    </isee:prefs>
    <isee:equation_prefs order_by="sector" />
    <model>
        <stock name="Bacteria_per_square_mm">
            <eqn>1000</eqn>
            <inflow>Increase_in_Bacteria</inflow>
            <non_negative />
            <display x="169" y="85" color="blue" />
        </stock>
        <flow name="Increase_in_Bacteria">
            <eqn>Bacteria_per_square_mm*Growth_Rate</eqn>
            <non_negative />
            <display x="103" y="84" color="blue">
                <pts>
                    <pt x="58" y="84" />
                    <pt x="149" y="84" />
                </pts>
            </display>
        </flow>
        <aux name="Growth_Rate">
            <eqn>.5</eqn>
            <display x="86" y="178" color="blue" />
        </aux>
        <display page_width="595" page_height="775" isee:converter_size="medium" interval="DT">
            <connector x="77" y="176" uid="0">
                <from>Growth_Rate</from>
                <to>Increase_in_Bacteria</to>
            </connector>
            <connector x="147" y="91" uid="1">
                <from>Bacteria_per_square_mm</from>
                <to>Increase_in_Bacteria</to>
            </connector>
            <stacked_container height="286" width="465" uid="2">
                <table font-size="9" background="#FFFE91" column_width="114" orientation="vertical" interval="1" cleared="true" date_time="1997-07-18T18:39:08Z">
                    <title>Untitled Table</title>
                    <item type="time" color="black" precision="0.01" width="100" />
                    <item color="black" precision="0.01" delimit_000s="true" index="0">
                        <entity name="Bacteria_per_square_mm" />
                    </item>
                </table>
            </stacked_container>
            <pad_icon x="267" y="75" width="26" height="22" color="#008F44" label_side="bottom" label="Table 1" type="table" icon_of="2" />
            <style font-family="Arial" font-size="9" />
        </display>
        <interface page_cols="0" page_rows="0" page_width="788" page_height="528" home_page="0">
            <simulation_delay>0.1</simulation_delay>
            <style font-family="Arial" font-size="9" />
        </interface>
        <popup x="16" y="78" content="2" />
        <style font-family="Arial" font-size="9" />
    </model>
</xmile>
