<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" level="3" xmlns="http://www.systemdynamics.org/XMILE" xmlns:isee="http://iseesystems.com/XMILE">
    <header>
        <smile version="1.0" namespace="std, isee">
            <uses_arrays>1</uses_arrays>
        </smile>
        <name>The Infection Game</name>
        <uuid>316e29c8-5850-415f-97dd-e80d3b33ee1b</uuid>
        <vendor>isee systems, inc.</vendor>
        <product version="10.1.2" isee:saved_by_v1="false" lang="en">iThink</product>
    </header>
    <style>
        <model font-family="Arial" font-size="18" />
        <interface font-family="Arial" font-size="12" />
    </style>
    <sim_specs method="Euler" time_units="Days" isee:pause_after_rates="false" isee:instantaneous_flows="false">
        <start>0</start>
        <stop>30</stop>
        <dt>0.25</dt>
    </sim_specs>
    <dimensions>
        <dim name="Dim_Name_1" size="1" />
    </dimensions>
    <model_units />
    <isee:prefs last_model="true" layer="interface" grid_width="20" grid_height="50" divide_by_zero_alert="true" hide_taskbar="true" show_module_prefix="true">
        <isee:window width="825" height="556" />
        <isee:security />
        <isee:print_setup width="576" height="768" />
    </isee:prefs>
    <isee:equation_prefs order_by="module" />
    <model>
        <stock name="Healthy_\nPeople">
            <eqn>30</eqn>
            <outflow>Getting_sick</outflow>
            <non_negative />
            <display x="194" y="139" color="blue" />
        </stock>
        <stock name="Infected_\nPeople">
            <eqn>1</eqn>
            <inflow>Getting_sick</inflow>
            <non_negative />
            <display x="561" y="143" color="blue" label_angle="129" />
        </stock>
        <flow name="Getting_sick">
            <eqn>Infected_Contacts__with_Healthy_People*Infectivity</eqn>
            <non_negative />
            <display x="377" y="141" color="blue" label_side="top" label_angle="58">
                <pts>
                    <pt x="216" y="141" />
                    <pt x="539" y="141" />
                </pts>
            </display>
        </flow>
        <aux name="Total_Number_\nof_People">
            <eqn>Healthy__People+Infected__People</eqn>
            <display x="101" y="343" color="blue" label_side="right" label_angle="38" />
        </aux>
        <aux name="Infected_Contacts_\nwith_Healthy_People">
            <eqn>Infected__People*Fraction_that_is_Healthy</eqn>
            <display x="420" y="265" color="blue" />
        </aux>
        <aux name="Fraction_that\nis_Healthy">
            <eqn>Healthy__People/Total_Number__of_People</eqn>
            <display x="214" y="235" color="blue" label_angle="227" />
        </aux>
        <aux name="Infectivity">
            <eqn>1</eqn>
            <display x="312" y="65" color="blue" label_side="top" label_angle="115" />
        </aux>
        <display page_width="576" page_height="768" page_cols="2" isee:converter_size="medium" isee:animate_flows="true" isee:animate_stocks="true" isee:animate_converters="true" interval="DT">
            <connector x="177" y="156" uid="0">
                <from>Healthy__People</from>
                <to>Fraction_that_is_Healthy</to>
            </connector>
            <connector x="100" y="334" uid="1">
                <from>Total_Number__of_People</from>
                <to>Fraction_that_is_Healthy</to>
            </connector>
            <connector x="220" y="239" uid="2">
                <from>Fraction_that_is_Healthy</from>
                <to>Infected_Contacts__with_Healthy_People</to>
            </connector>
            <connector x="559" y="161" uid="3">
                <from>Infected__People</from>
                <to>Infected_Contacts__with_Healthy_People</to>
            </connector>
            <connector x="412" y="262" uid="4">
                <from>Infected_Contacts__with_Healthy_People</from>
                <to>Getting_sick</to>
            </connector>
            <alias x="93" y="432" uid="5">
                <of>Healthy__People</of>
                <label_side>bottom</label_side>
                <label_angle>325</label_angle>
            </alias>
            <alias x="211" y="436" uid="6">
                <of>Infected__People</of>
                <label_side>bottom</label_side>
                <label_angle>306</label_angle>
            </alias>
            <connector x="98" y="415" uid="7">
                <from>
                    <alias uid="5" />
                </from>
                <to>Total_Number__of_People</to>
            </connector>
            <connector x="192" y="419" uid="8">
                <from>
                    <alias uid="6" />
                </from>
                <to>Total_Number__of_People</to>
            </connector>
            <connector x="314" y="74" uid="9">
                <from>Infectivity</from>
                <to>Getting_sick</to>
            </connector>
            <style font-family="Arial" font-size="18" />
        </display>
        <interface show_pages="true" page_cols="2" page_rows="2" page_width="788" page_height="528" scroll_y="528" home_page="3">
            <simulation_delay>0.1</simulation_delay>
            <stacked_container x="243" y="32" height="282" width="492" uid="10">
                <graph type="time_series" title="Untitled" background="#FFFFC9" show_grid="true" plot_numbers="true" isee:use_five_segments="false" hide_detail="true" cleared="true" time_precision="0" from="0" to="30">
                    <plot index="0" pen_width="3" color="blue" precision="1" show_y_axis="true">
                        <scale min="0" max="100" />
                        <entity name="Healthy__People" />
                    </plot>
                    <plot index="1" pen_width="3" color="red" precision="1" show_y_axis="true">
                        <scale min="0" max="100" />
                        <entity name="Infected__People" />
                    </plot>
                </graph>
                <graph type="time_series" title="Untitled" background="#FFFFC9" show_grid="true" plot_numbers="true" isee:use_five_segments="false" hide_detail="true" cleared="true" time_precision="2" from="0" to="30">
                    <plot index="0" pen_width="3" color="blue" precision="1" show_y_axis="true">
                        <scale min="0" max="30" />
                        <entity name="Getting_sick" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="461" y="115" width="26" height="22" color="#008F44" label_side="bottom" label="Graph 1" type="graph" icon_of="10" />
            <stacked_container height="334" width="603" uid="11">
                <table font-size="9" background="#E0E0E0" column_width="82" orientation="vertical" interval="0.25" cleared="true" date_time="2010-12-09T11:26:37Z">
                    <title>Untitled Table</title>
                    <item type="time" color="black" precision="max" width="100" />
                    <item color="black" precision="0.01" delimit_000s="true" index="0">
                        <entity name="Healthy__People" />
                    </item>
                    <item color="black" precision="0.01" delimit_000s="true" index="1">
                        <entity name="Infected__People" />
                    </item>
                    <item color="black" precision="0.01" delimit_000s="true" index="2">
                        <entity name="Getting_sick" />
                    </item>
                    <item color="black" precision="0.01" delimit_000s="true" index="3">
                        <entity name="Fraction_that_is_Healthy" />
                    </item>
                    <item color="black" precision="0.01" delimit_000s="true" index="4">
                        <entity name="Infected_Contacts__with_Healthy_People" />
                    </item>
                </table>
            </stacked_container>
            <pad_icon x="336" y="69" width="26" height="22" color="#008F44" label_side="bottom" label="Table 1" type="table" icon_of="11" />
            <knob x="81" y="415" color="black" width="83" height="91" min="0" max="80" precision="1">
                <entity name="Healthy__People" />
            </knob>
            <knob x="187" y="411" color="black" width="83" height="91" min="0" max="20" precision="1">
                <entity name="Infected__People" />
            </knob>
            <button x="668" y="334" width="65" height="34" uid="12" appearance="opaque" background="black" color="white" style="rounded" label="Run" font-family="Arial" font-size="12" text-align="center">
                <menu_action>run</menu_action>
            </button>
            <slider x="427" y="445" color="#30CB32" width="197" height="43" min="0" max="1" precision="0.1">
                <entity name="Infectivity" value="1" />
            </slider>
            <button x="667" y="382" width="76" height="45" uid="13" appearance="opaque" background="black" color="white" style="rounded" label="Restore Graphs &amp; Tables" font-family="Arial" font-size="12" text-align="center">
                <menu_action>restore_graphs_tables</menu_action>
            </button>
            <text_box x="15" y="259" uid="14" color="black" font-family="Arial" font-size="12" padding="5" border-style="solid" border-width="thin" width="215" height="58">Click page turning icon to see how many people get sick each day.   -----------&gt;</text_box>
            <text_box x="248" y="348" uid="15" color="black" font-family="Arial" font-size="12" padding="5" border-style="solid" border-width="thin" width="399" height="131">INFECTIVITY: indicates how contagious the disease is. A value of 1 (100%) means that every contact leads to infection.</text_box>
            <text_box x="18" y="154" uid="16" color="black" font-family="Arial" font-size="12" padding="5" border-style="solid" border-width="thin" width="213" height="87">First run the model to see how many people are healthy and how many are sick.</text_box>
            <button x="689" y="449" width="44" height="36" uid="17" appearance="opaque" background="black" color="white" style="rounded" icon="5">
                <link target="home_page" isee:default_icon="true" />
            </button>
            <text_box x="155" y="590" uid="18" color="black" font-family="Arial" font-size="12" padding="5" border-style="solid" border-width="thin" width="371" height="224">THE INFECTION GAME&#x0D;&#x0D;In the Infection Game, players learn about the spread of  disease, rumors, fads, and other &quot;catchy&quot; things.  Feedback is crucial to the course of the infection among a population, and you can see the connections in the model.  The more infected people there are, the more chances for a healthy person to become infected, and that person can then infect others.  &#x0D;&#x0D;Using the computer simulation, you can see behavior over time graphs of the number of infected people and the new infections occurring each day.  You can change some of the settings in the simulation and see what happens.  The &apos;u&apos; button on the knobs and slider return the settings to their original values.</text_box>
            <button x="273" y="867" width="160" height="35" uid="19" appearance="opaque" background="black" color="white" style="square" label="Try the simulation" font-family="Arial" font-size="12" text-align="center">
                <link target="interface" x="0" y="0" />
            </button>
            <style font-family="Arial" font-size="12" />
        </interface>
        <popup x="582" y="107" content="11" />
        <style font-family="Arial" font-size="18" />
    </model>
</xmile>
