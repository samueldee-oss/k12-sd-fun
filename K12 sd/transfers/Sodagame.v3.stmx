<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" level="3" xmlns="http://www.systemdynamics.org/XMILE" xmlns:isee="http://iseesystems.com/XMILE">
    <header>
        <smile version="1.0" namespace="std, isee">
            <uses_arrays>1</uses_arrays>
            <uses_conveyor />
        </smile>
        <name>Sodagame.v3</name>
        <uuid>9fb059d7-ec27-400b-a4bb-bdfb18c5eb68</uuid>
        <vendor>isee systems, inc.</vendor>
        <product version="10.1.2" isee:saved_by_v1="false" lang="en">iThink</product>
    </header>
    <style>
        <model font-family="Arial" font-size="9" />
        <interface font-family="Arial" font-size="9" />
    </style>
    <sim_specs method="Euler" time_units="Weeks" pause_interval="1" isee:pause_after_rates="false" isee:instantaneous_flows="false">
        <start>0</start>
        <stop>30</stop>
        <dt>0.25</dt>
        <isee:analyze_mode>false</isee:analyze_mode>
    </sim_specs>
    <dimensions>
        <dim name="Dim_Name_1" size="1" />
    </dimensions>
    <model_units />
    <isee:prefs last_model="true" layer="model" grid_width="20" grid_height="50" divide_by_zero_alert="true" hide_taskbar="true" show_module_prefix="true">
        <isee:window width="1366" height="685" />
        <isee:security />
        <isee:print_setup width="595" height="775" />
    </isee:prefs>
    <isee:equation_prefs order_by="sector" />
    <model>
        <stock name="Retail_Inventory">
            <eqn>12</eqn>
            <scale min="0" max="40" />
            <inflow>Arrivals“Supply“</inflow>
            <outflow>Sales“Demand“</outflow>
            <display x="333" y="205" color="#656518" label_side="bottom" label_angle="281">
                <scale min="0" max="40" />
            </display>
        </stock>
        <flow name="Sales“Demand“">
            <eqn>Customer_Demand+Demand_v_Price</eqn>
            <scale min="0" max="40" />
            <non_negative />
            <display x="257" y="212" color="#656518">
                <scale min="0" max="40" />
                <pts>
                    <pt x="313" y="212" />
                    <pt x="202" y="212" />
                </pts>
            </display>
        </flow>
        <flow name="shipments">
            <doc>s&apos;d;kfgms;dlkfjgs;ldkfjg</doc>
            <eqn>Orders</eqn>
            <non_negative />
            <display x="570" y="207" color="#FF7F00">
                <pts>
                    <pt x="626" y="207" />
                    <pt x="514" y="207" />
                </pts>
            </display>
        </flow>
        <flow name="Arrivals“Supply“">
            <eqn>0</eqn>
            <scale min="0" max="20" />
            <non_negative />
            <display x="413" y="206" color="#656518">
                <scale min="0" max="20" />
                <pts>
                    <pt x="474" y="206" />
                    <pt x="353" y="206" />
                </pts>
            </display>
        </flow>
        <stock name="Soda_in_Transit">
            <eqn>8</eqn>
            <inflow>shipments</inflow>
            <outflow>Arrivals“Supply“</outflow>
            <conveyor>
                <len>2</len>
            </conveyor>
            <display x="494" y="210" color="#FF7F00" />
        </stock>
        <aux name="Orders">
            <eqn>Inv_Adjustment+Sales“Demand“</eqn>
            <display x="412" y="122" color="#656518" />
        </aux>
        <aux name="Inv_Adjustment">
            <eqn>(12-Retail_Inventory)/2</eqn>
            <display x="353" y="150" color="#656518" label_angle="303" />
        </aux>
        <aux name="Customer_Demand">
            <eqn>Advertising–wk_$</eqn>
            <scale min="0" max="40" />
            <gf>
                <xscale min="0" max="100" />
                <yscale min="0" max="30" />
                <ypts>0,3,5.8499999999999996,9.1500000000000004,9.5999999999999996,9.75,9.9000000000000004,10.199999999999999,10.35,10.5,10.65</ypts>
            </gf>
            <display x="135" y="178" color="#184765">
                <scale min="0" max="40" />
            </display>
        </aux>
        <aux name="Current_Week">
            <eqn>time</eqn>
            <display x="90" y="541" color="#652D18" />
        </aux>
        <aux name="Advertising–wk_$">
            <doc>Model Assumptions: &#x0D; • Jump in demand curve at week=15&#x0D; • Price is variable&#x0D; • 2 week in-transit delay (Wholesaler to Retailer)</doc>
            <eqn>0</eqn>
            <display x="104" y="360" color="blue" />
        </aux>
        <aux name="Cust_Price">
            <eqn>20</eqn>
            <scale min="0" max="40" />
            <display x="282" y="377" color="#656518">
                <scale min="0" max="40" />
            </display>
        </aux>
        <aux name="Demand_v_Price">
            <eqn>Cust_Price</eqn>
            <gf>
                <xscale min="0" max="50" />
                <yscale min="-10" max="30" />
                <ypts>30.000000000000004,28.000000000000004,27.000000000000004,22.400000000000002,6.8000000000000007,6.0000000000000009,3.2000000000000006,0.40000000000000058,5.5511151231257827e-016,5.5511151231257827e-016,5.5511151231257827e-016</ypts>
            </gf>
            <display x="292" y="313" color="blue" />
        </aux>
        <stock name="Profits">
            <eqn>0&#x0D;</eqn>
            <scale min="-1000" max="1000" />
            <inflow>Money_In</inflow>
            <outflow>Costs</outflow>
            <display x="322" y="496" color="blue">
                <scale min="-1000" max="1000" />
            </display>
        </stock>
        <flow name="Money_In">
            <doc>The Cust_Price - $5.00 figures the difference between the Retail or Cust Price and the store&apos;s $5/case wholesale cost. The difference is the profit/case which is multiplied times the Sales&quot;Demand&quot;(number of cases sold)</doc>
            <eqn>Sales“Demand“*(Cust_Price-5.00)</eqn>
            <non_negative />
            <display x="239" y="490" color="blue">
                <pts>
                    <pt x="176" y="490" />
                    <pt x="302" y="490" />
                </pts>
            </display>
        </flow>
        <flow name="Costs">
            <doc>The negative sign in the else statement is to make certain the outflow is positive. If Retail Inventory dropped below 0 a negative outflow would result. STELLA reads negative outflow as positive inflow. By adding a negative 1 to the else statement we assure a positive or true outflow when the Retail Inventory is negative (backlog of orders.) </doc>
            <eqn>if Retail_Inventory &gt; 0 then&#x0D;   Retail_Inventory*Cost_of_Inventory + Advertising–wk_$&#x0D;else  &#x0D;  -1* ( Retail_Inventory*Cost_of_Back_order+Advertising–wk_$)</eqn>
            <non_negative />
            <display x="407" y="493" color="blue">
                <pts>
                    <pt x="342" y="493" />
                    <pt x="473" y="493" />
                </pts>
            </display>
        </flow>
        <aux name="Cost_of_Inventory">
            <eqn>5</eqn>
            <display x="446" y="458" color="blue" />
        </aux>
        <aux name="Cost_of_Back_order">
            <eqn>20</eqn>
            <display x="456" y="562" color="blue" />
        </aux>
        <aux name="Game_Time_Beeper">
            <eqn>Time</eqn>
            <event_poster min="0" max="30">
                <threshold value="26" interval="1">
                    <event sim_action="stop">
                        <text_box>This run is over. Please make sure you update your game sheet, then resume the game. Thanks</text_box>
                    </event>
                </threshold>
            </event_poster>
            <display x="334" y="556" color="blue" />
        </aux>
        <group name="Wholesaler_2">
            <entity name="shipments" />
            <entity name="Soda_in_Transit" />
            <display locked="true" x="453" y="99" width="193" height="222" color="#FF7F00" />
        </group>
        <group name="Retailer_2">
            <entity name="Retail_Inventory" />
            <entity name="Sales“Demand“" />
            <entity name="Arrivals“Supply“" />
            <entity name="Inv_Adjustment" />
            <entity name="Demand_v_Price" />
            <entity name="Orders" />
            <entity name="Cust_Price" />
            <display locked="true" x="222" y="99" width="228" height="318" color="#65653D">
                <item uid="0" />
                <item uid="1" />
                <item uid="2" />
                <item uid="3" />
                <item uid="4" />
                <item uid="5" />
                <item uid="6" />
                <item uid="7" />
                <item uid="8" />
            </display>
        </group>
        <group name="Customers_2">
            <entity name="Customer_Demand" />
            <entity name="Advertising–wk_$" />
            <display locked="true" x="53" y="99" width="167" height="318" color="red">
                <item uid="9" />
                <item uid="10" />
                <item uid="11" />
            </display>
        </group>
        <display page_width="595" page_height="775" page_cols="2" isee:converter_size="medium" interval="DT" scroll_x="32">
            <connector x="421" y="121" uid="6" color="#656518">
                <from>Orders</from>
                <to>shipments</to>
            </connector>
            <connector x="323" y="190" uid="4" color="#656518">
                <from>Retail_Inventory</from>
                <to>Inv_Adjustment</to>
            </connector>
            <connector x="103" y="348" uid="10">
                <from>Advertising–wk_$</from>
                <to>Customer_Demand</to>
            </connector>
            <connector x="143" y="181" uid="9">
                <from>Customer_Demand</from>
                <to>Sales“Demand“</to>
            </connector>
            <connector x="112" y="364" uid="11">
                <from>Advertising–wk_$</from>
                <to>Costs</to>
            </connector>
            <connector x="283" y="365" uid="5">
                <from>Cust_Price</from>
                <to>Demand_v_Price</to>
            </connector>
            <connector x="289" y="305" uid="0">
                <from>Demand_v_Price</from>
                <to>Sales“Demand“</to>
            </connector>
            <connector x="361" y="142" uid="7" color="#656518">
                <from>Inv_Adjustment</from>
                <to>Orders</to>
            </connector>
            <connector x="260" y="204" uid="1" color="#656518">
                <from>Sales“Demand“</from>
                <to>Orders</to>
            </connector>
            <connector x="277" y="384" uid="8">
                <from>Cust_Price</from>
                <to>Money_In</to>
            </connector>
            <connector x="254" y="220" uid="2">
                <from>Sales“Demand“</from>
                <to>Money_In</to>
            </connector>
            <connector x="337" y="222" uid="3">
                <from>Retail_Inventory</from>
                <to>Costs</to>
            </connector>
            <connector x="440" y="465" uid="12">
                <from>Cost_of_Inventory</from>
                <to>Costs</to>
            </connector>
            <connector x="452" y="554" uid="13">
                <from>Cost_of_Back_order</from>
                <to>Costs</to>
            </connector>
            <text_box x="476" y="378" uid="14" color="#652D18" font-family="Arial" font-size="9" padding="5" width="159" height="51">Click the &quot;dog ears&quot; in the lower left corner of the graph to see graphs of supply and demand</text_box>
            <text_box x="215" y="18" uid="15" color="#7F00FF" font-family="Arial" font-size="14" font-weight="bold" padding="5" border-style="double" border-width="thick-thin" width="285" height="40">Soda/Profit/Advertising Game </text_box>
            <style font-family="Arial" font-size="9" />
        </display>
        <interface page_rows="2" page_width="788" page_height="528" background="#C9FFE3" scroll_x="8">
            <simulation_delay>0.1</simulation_delay>
            <isee:process_frame x="359" y="309" width="177" height="77" name="Wholesaler" show_name="false" color="#0CA0FF" border-style="solid" border-width="thin">
                <isee:name_image>true</isee:name_image>
            </isee:process_frame>
            <isee:process_frame x="187" y="310" width="155" height="75" name="Retailer" show_name="false" color="#0CA0FF" border-style="solid" border-width="thin">
                <isee:name_image>true</isee:name_image>
            </isee:process_frame>
            <isee:process_frame x="51" y="312" width="119" height="71" name="Customers" show_name="false" color="#0CA0FF" border-style="solid" border-width="thin">
                <isee:name_image>true</isee:name_image>
            </isee:process_frame>
            <isee:bundled_flow color="blue">
                <from>Retailer</from>
                <to>Customers</to>
                <pts>
                    <pt x="187" y="359" />
                    <pt x="169" y="359" />
                </pts>
            </isee:bundled_flow>
            <isee:bundled_flow color="blue">
                <from>Wholesaler</from>
                <to>Retailer</to>
                <pts>
                    <pt x="359" y="344" />
                    <pt x="341" y="344" />
                </pts>
            </isee:bundled_flow>
            <isee:bundled_connector color="red">
                <from>Retailer</from>
                <to>Wholesaler</to>
                <pts>
                    <pt x="341" y="301" />
                    <pt x="359" y="301" />
                </pts>
            </isee:bundled_connector>
            <isee:bundled_connector color="red">
                <from>Customers</from>
                <to>Retailer</to>
                <pts>
                    <pt x="169" y="306" />
                    <pt x="187" y="306" />
                </pts>
            </isee:bundled_connector>
            <stacked_container x="67" y="738" height="106" width="207" uid="16">
                <graph type="time_series" title="Untitled Graph" background="white" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-07T15:51:22Z" cleared="true" time_precision="0" from="0" to="30">
                    <plot index="0" pen_width="1" color="red" precision="1" show_y_axis="true">
                        <entity name="Retail_Inventory" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="164" y="787" width="26" height="22" color="#0CA0FF" label_side="bottom" label="Graph 1" type="graph" icon_of="16" />
            <stacked_container x="68" y="892" height="106" width="207" uid="17">
                <graph type="time_series" title="Untitled Graph" background="white" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-07T15:51:22Z" cleared="true" time_precision="0" from="0" to="30">
                    <plot index="0" pen_width="1" color="blue" precision="1" show_y_axis="true">
                        <entity name="Sales“Demand“" />
                    </plot>
                    <plot index="1" pen_width="1" color="#FF7F00" precision="1" show_y_axis="true">
                        <entity name="Arrivals“Supply“" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="164" y="924" width="26" height="22" color="#0CA0FF" label_side="bottom" label="Graph 2" type="graph" icon_of="17" />
            <stacked_container x="341" y="738" height="106" width="207" uid="18">
                <graph type="time_series" title="Untitled Graph" background="white" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-07T15:51:22Z" cleared="true" time_precision="0" from="0" to="30">
                    <plot index="0" pen_width="1" color="red" precision="1" show_y_axis="true">
                        <scale min="-400" max="4000" />
                        <entity name="Profits" />
                    </plot>
                    <plot index="1" pen_width="1" color="#008F44" precision="1" show_y_axis="true">
                        <scale min="0" max="30" />
                        <entity name="Cust_Price" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="438" y="787" width="26" height="22" color="#0CA0FF" label_side="bottom" label="Graph 3" type="graph" icon_of="18" />
            <slider x="437" y="934" label_side="bottom" isee:navigate_to="true" color="red" width="197" height="43" min="0" max="50">
                <entity name="Orders" value="0" />
            </slider>
            <slider x="437" y="888" label_side="bottom" isee:navigate_to="true" color="red" width="197" height="43" min="0" max="50">
                <entity name="Cust_Price" value="0" />
            </slider>
            <text_box x="50" y="392" uid="19" color="#7F00FF" font-family="Arial" font-size="10" padding="5" border-style="double" border-width="thick-thin" width="511" height="256">RULES OF THE GAME&#x0D;You receive orders from customers, and in turn give them soda, if you have it in stock.  If you are out of soda, you backlog the orders until you can fill them.  You order cases from your wholesaler to keep your inventory stocked.  The new cases arrive after about 2 weeks.&#x0D;&#x0D;Your goals:&#x0D; 1. Order enough soda to keep your customers happy and to maintain a stable inventory.&#x0D; 2. Make as much profit as you can.&#x0D;&#x0D;At the outset, your customers have been drinking 4 cases a week (that can go up and down).  You likewise have been ordering 4 cases per week from your wholesaler.  &#x0D;&#x0D;Your COSTS in this game are as follows,  it costs you $5.00 for each case in your inventory and  $20.00 a case for each case that you are backlogged. If you choose to advertise the amount you choose to spend each week will be subtracted from your profit as well as any backlogged Retail Inventory or surplus Retail Inventory.&#x0D;&#x0D;SCROLL DOWN TO TO PLAY  (CENTER THE BOX).</text_box>
            <text_box x="52" y="21" uid="20" color="#7F00FF" font-family="Arial" font-size="10" font-style="italic" padding="5" border-style="solid" border-width="5px" width="513" height="121">Soda/Profit/Advertising Game, Created by  Sam DeVore, Will Glass-Husain, Mike Slootmaker, © 1995, System Dynamics Project, Catalina Foothills School  District, 1911 E. Orange Grove Rd., Tucson, AZ  85718.&#x0D;Permission is granted to copy the program with accompanying documentation for non-profit purposes. If you modify the  software and/or documentation, please do not distribute the modified version(s) outside &#x0D;your organization.&#x0D;</text_box>
            <slider x="438" y="980" label_side="bottom" isee:navigate_to="true" color="#008F44" width="197" height="43" min="0" max="100">
                <entity name="Advertising–wk_$" value="0" />
            </slider>
            <text_box x="60" y="182" uid="21" color="#7F00FF" font-family="Arial" font-size="12" padding="5" border-style="solid" border-width="5px" width="184" height="37">Scroll down for more.</text_box>
            <numeric_display precision="1" delimit_000s="true" color="red" show_name="true" retain_ending_value="true" uid="22" x="146" y="724">
                <entity name="Retail_Inventory" />
            </numeric_display>
            <numeric_display precision="1" delimit_000s="true" color="#FF7F00" show_name="true" retain_ending_value="true" uid="23" x="146" y="881">
                <entity name="Arrivals“Supply“" />
            </numeric_display>
            <numeric_display precision="1" delimit_000s="true" color="blue" show_name="true" retain_ending_value="true" uid="24" x="146" y="861">
                <entity name="Sales“Demand“" />
            </numeric_display>
            <numeric_display precision="0.01" display_as="currency" color="red" show_name="true" retain_ending_value="true" uid="25" x="420" y="726">
                <entity name="Profits" />
            </numeric_display>
            <numeric_display precision="0.01" display_as="currency" color="#008F44" show_name="true" retain_ending_value="true" uid="26" x="420" y="707">
                <entity name="Cust_Price" />
            </numeric_display>
            <text_box x="50" y="1016" uid="27" color="#7F00FF" font-family="Arial" font-size="9" padding="5" border-style="solid" border-width="thin" width="135" height="26">Supply vs. Demand</text_box>
            <text_box x="43" y="658" uid="28" color="black" font-family="Arial" font-size="12" padding="5" border-style="solid" border-width="5px" width="534" height="353" />
            <style font-family="Arial" font-size="9" />
        </interface>
        <style font-family="Arial" font-size="9" />
    </model>
</xmile>
