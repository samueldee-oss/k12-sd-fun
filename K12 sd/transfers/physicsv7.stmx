<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" level="3" xmlns="http://www.systemdynamics.org/XMILE" xmlns:isee="http://iseesystems.com/XMILE">
    <header>
        <smile version="1.0" namespace="std, isee">
            <uses_arrays>1</uses_arrays>
        </smile>
        <name>physicsv7</name>
        <uuid>5db2ab72-b422-48de-8348-3f9022fe0696</uuid>
        <vendor>isee systems, inc.</vendor>
        <product version="10.1.2" isee:saved_by_v1="false" lang="en">iThink</product>
    </header>
    <style>
        <model font-family="Arial" font-size="9" />
        <interface font-family="Arial" font-size="9" />
    </style>
    <sim_specs method="RK2" time_units="Hours" isee:pause_after_rates="false" isee:instantaneous_flows="false">
        <start>0</start>
        <stop>60</stop>
        <dt>0.125</dt>
        <isee:analyze_mode>false</isee:analyze_mode>
    </sim_specs>
    <dimensions>
        <dim name="Dim_Name_1" size="1" />
    </dimensions>
    <model_units />
    <isee:prefs last_model="true" layer="interface" grid_width="20" grid_height="50" divide_by_zero_alert="true" link_high_level_map="true" show_module_prefix="true">
        <isee:window width="644" height="662" />
        <isee:security />
        <isee:print_setup width="595" height="744" />
    </isee:prefs>
    <isee:equation_prefs order_by="sector" show_documentation="true" />
    <model>
        <stock name="Position">
            <doc>Initially, the object sits at its rest position.</doc>
            <eqn>rest_position</eqn>
            <scale min="0" max="200" />
            <inflow>velocity</inflow>
            <non_negative />
            <display x="302" y="90" color="#652A48">
                <scale min="0" max="200" />
            </display>
        </stock>
        <flow name="velocity">
            <eqn>Momentum/mass</eqn>
            <display x="224" y="87" color="#652A48" label_side="top">
                <pts>
                    <pt x="166" y="87" />
                    <pt x="282" y="87" />
                </pts>
            </display>
        </flow>
        <stock name="Momentum">
            <eqn>0</eqn>
            <scale min="-2500" max="2500" />
            <inflow>force</inflow>
            <outflow>restoring_force</outflow>
            <display x="255" y="211" color="#652A48" label_side="bottom">
                <scale min="-2500" max="2500" />
            </display>
        </stock>
        <flow name="force">
            <eqn>mass*acceleration</eqn>
            <display x="178" y="215" color="#652A48">
                <pts>
                    <pt x="121" y="215" />
                    <pt x="235" y="215" />
                </pts>
            </display>
        </flow>
        <aux name="mass">
            <eqn>75</eqn>
            <display x="150" y="138" color="#652A48" label_side="top" />
        </aux>
        <aux name="acceleration">
            <doc>-9.8 m/s^2 is the gravitational acceleration on the earth.  A value of -2 (m/s^2) approximates the value on the moon.</doc>
            <eqn>-9.8</eqn>
            <display x="91" y="250" color="#652A48" />
        </aux>
        <flow name="restoring_force">
            <doc>Hooke&apos;s law says:  f=-kx.  Here, the direction of the restoring force is handled by the directionality of the flow (confirm this in the equation listing)</doc>
            <eqn>hookes_constant*displacement_from_rest</eqn>
            <display x="342" y="214" color="#652A48">
                <pts>
                    <pt x="275" y="214" />
                    <pt x="409" y="214" />
                </pts>
            </display>
        </flow>
        <aux name="rest_position">
            <doc>The rest position of the object.</doc>
            <eqn>100</eqn>
            <display x="417" y="90" color="#652A48" label_side="top" />
        </aux>
        <aux name="displacement_from_rest">
            <doc>This equation calculates the displacement of the object from its rest position.</doc>
            <eqn>Position-rest_position</eqn>
            <display x="331" y="157" color="#652A48" label_side="right" label_angle="3" />
        </aux>
        <aux name="hookes_constant">
            <doc>hooke&apos;s constant tells the strength of the spring in a spring-mass system.  Here, with a setting of 20, we&apos;ve got a pretty hefty spring.</doc>
            <eqn>20</eqn>
            <display x="447" y="230" color="#652A48" />
        </aux>
        <group name="BOING!!">
            <entity name="Position" />
            <entity name="velocity" />
            <entity name="Momentum" />
            <entity name="force" />
            <entity name="mass" />
            <entity name="acceleration" />
            <entity name="restoring_force" />
            <entity name="displacement_from_rest" />
            <entity name="rest_position" />
            <entity name="hookes_constant" />
            <display locked="true" x="40" y="37" width="487" height="268" color="red">
                <image width="484" height="232">data:image/png;base64,</image>
                <item uid="0" />
                <item uid="1" />
                <item uid="2" />
                <item uid="3" />
                <item uid="4" />
                <item uid="5" />
                <item uid="6" />
                <item uid="7" />
                <item uid="8" />
            </display>
        </group>
        <display page_width="595" page_height="744" page_order="column" isee:converter_size="large" isee:animate_flows="true" isee:animate_stocks="true" isee:animate_converters="true">
            <connector x="258" y="194" uid="0" color="#652A48">
                <from>Momentum</from>
                <to>velocity</to>
            </connector>
            <connector x="162" y="140" uid="1" color="#652A48">
                <from>mass</from>
                <to>velocity</to>
            </connector>
            <connector x="149" y="150" uid="2" color="#652A48">
                <from>mass</from>
                <to>force</to>
            </connector>
            <connector x="103" y="252" uid="3" color="#652A48">
                <from>acceleration</from>
                <to>force</to>
            </connector>
            <connector x="294" y="105" uid="4" color="#652A48">
                <from>Position</from>
                <to>displacement_from_rest</to>
            </connector>
            <connector x="405" y="89" uid="5" color="#652A48">
                <from>rest_position</from>
                <to>displacement_from_rest</to>
            </connector>
            <connector x="323" y="166" uid="6" color="#652A48">
                <from>displacement_from_rest</from>
                <to>restoring_force</to>
            </connector>
            <connector x="442" y="219" uid="7" color="#652A48">
                <from>hookes_constant</from>
                <to>restoring_force</to>
            </connector>
            <stacked_container height="282" width="492" visible_index="1" uid="8">
                <graph type="time_series" title="Simple Harmonic Oscillation" background="#C9EAFF" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-04T10:03:23Z" cleared="true" time_precision="2" from="0" to="60">
                    <plot index="0" pen_width="1" color="red" precision="0.01" show_y_axis="true">
                        <entity name="Position" />
                    </plot>
                </graph>
                <graph type="scatter" title="Scatter Graph" background="#FFE4C9" show_grid="true" plot_numbers="false" isee:use_five_segments="false" date_time="2025-02-04T10:03:23Z" cleared="true" time_precision="2">
                    <plot index="0" pen_width="1" color="#A5CB7A" precision="0.01" show_y_axis="true">
                        <entity name="Position" />
                    </plot>
                    <plot index="1" pen_width="1" color="#C8C8C8" precision="0.01" show_y_axis="true">
                        <entity name="Momentum" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="85" y="87" width="26" height="22" color="#0CA0FF" label_angle="51" label="Position and momentum" type="graph" icon_of="8" />
            <text_box x="0" y="682" uid="9" color="black" font-family="Arial" font-size="12" text-align="center" padding="5" width="326" height="38">Physics</text_box>
            <style font-family="Arial" font-size="9" />
        </display>
        <interface page_order="column" page_width="1588" page_height="1128" background="#FFFFC9">
            <interaction_mode>flight_sim</interaction_mode>
            <simulation_delay>0.1</simulation_delay>
            <isee:process_frame x="50" y="31" width="454" height="260" name="BOING!!" color="#653E18" border-style="solid" border-width="5px" />
            <stacked_container x="52" y="33" height="256" width="450" visible_index="1" uid="10">
                <graph type="time_series" title="Untitled Graph" background="#C9FFFF" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-04T10:03:23Z" cleared="true" time_precision="2" from="0" to="60">
                    <plot index="0" pen_width="1" color="red" precision="0.01" show_y_axis="true">
                        <entity name="Position" />
                    </plot>
                </graph>
                <graph type="scatter" title="Untitled Graph" background="#FFD8C9" show_grid="true" plot_numbers="false" isee:use_five_segments="false" date_time="2025-02-04T10:03:23Z" cleared="true" time_precision="2">
                    <plot index="0" pen_width="1" color="red" precision="0.01" show_y_axis="true">
                        <entity name="Position" />
                    </plot>
                    <plot index="1" pen_width="1" color="blue" precision="0.01" show_y_axis="true">
                        <entity name="Momentum" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="267" y="129" width="26" height="22" color="#0CA0FF" label_side="bottom" label="Graph 1" type="graph" icon_of="10" />
            <slider x="408" y="322" label_side="bottom" label_angle="341" isee:navigate_to="true" color="blue" width="197" height="43" min="0" max="200">
                <entity name="rest_position" />
            </slider>
            <slider x="136" y="322" label_side="bottom" label_angle="201" isee:navigate_to="true" color="blue" width="197" height="43" min="0" max="30">
                <entity name="hookes_constant" />
            </slider>
            <slider x="259" y="371" label_side="bottom" isee:navigate_to="true" color="blue" width="197" height="43" min="-9.8" max="-1.63">
                <entity name="acceleration" />
            </slider>
            <text_box x="24" y="363" uid="11" color="blue" font-family="Times New Roman" font-size="12" text-align="right" padding="5" width="137" height="44">Earth&apos;s Gravitational Acceleration</text_box>
            <text_box x="357" y="364" uid="12" color="blue" font-family="Times New Roman" font-size="12" padding="5" width="152" height="44">The Moon&apos;s Gravitational Acceleration</text_box>
            <style font-family="Arial" font-size="9" />
        </interface>
        <popup x="13" y="112" content="8" />
        <style font-family="Arial" font-size="9" />
    </model>
</xmile>
