        <product version="10.1.2" isee:saved_by_v1="false" lang="en">iThink</product>
    </header>
    <style>
        <model font-family="Arial" font-size="9" />
        <interface font-family="Arial" font-size="9" />
    </style>
    <sim_specs method="Euler" time_units="Time" isee:pause_after_rates="false" isee:instantaneous_flows="false">
        <start>0</start>
        <stop>20</stop>
        <dt>1</dt>
        <isee:analyze_mode>false</isee:analyze_mode>
    </sim_specs>
    <dimensions>
        <dim name="Dim_Name_1" size="1" />
    </dimensions>
    <model_units />
    <isee:prefs last_model="true" layer="model" grid_width="20" grid_height="50" divide_by_zero_alert="true" link_high_level_map="true" show_module_prefix="true">
        <isee:window width="1334" height="630" />
        <isee:security />
        <isee:print_setup width="552" height="728" />
    </isee:prefs>
    <isee:equation_prefs order_by="sector" />
    <model>
        <stock name="Distance_Traveled">
            <eqn>0</eqn>
            <inflow>Movement</inflow>
            <non_negative />
            <display x="248" y="75" color="blue" />
        </stock>
        <flow name="Movement">
            <eqn>Size_of_Step*(Distance_to_Travel-Distance_Traveled)</eqn>
            <non_negative />
            <display x="153" y="72" color="blue" label_side="top" label_angle="95">
                <pts>
                    <pt x="79" y="72" />
                    <pt x="228" y="72" />
                </pts>
            </display>
        </flow>
        <aux name="Size_of_Step">
            <eqn>.5</eqn>
            <display x="98" y="143" color="blue" />
        </aux>
        <aux name="Distance_to_Travel">
            <eqn>200</eqn>
            <display x="228" y="148" color="blue" />
        </aux>
        <display page_width="552" page_height="728" isee:converter_size="large" interval="DT">
            <connector x="226" y="85" uid="0">
                <from>Distance_Traveled</from>
                <to>Movement</to>
            </connector>
            <connector x="100" y="131" uid="1">
                <from>Size_of_Step</from>
                <to>Movement</to>
            </connector>
            <connector x="219" y="140" uid="2">
                <from>Distance_to_Travel</from>
                <to>Movement</to>
            </connector>
            <stacked_container height="282" width="492" uid="3">
                <graph type="time_series" title="Untitled Graph" background="#C8C8C8" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-04T10:08:37Z" cleared="true" time_precision="2" from="0" to="20">
                    <plot index="0" pen_width="1" color="red" precision="0.01" show_y_axis="true">
                        <scale min="0" max="200" />
                        <entity name="Distance_Traveled" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="373" y="74" width="26" height="22" color="#0CA0FF" label_side="bottom" label="Graph 1" type="graph" icon_of="3" />
            <stacked_container height="286" width="465" uid="4">
                <table font-size="9" background="#FFFE91" column_width="60" orientation="vertical" interval="1" cleared="true" date_time="1997-07-20T12:18:10Z">
                    <title>Untitled Table</title>
                    <item type="time" color="black" width="100" />
                    <item color="black" precision="max" delimit_000s="true" index="0">
                        <entity name="Distance_Traveled" />
                    </item>
                </table>
            </stacked_container>
            <pad_icon x="375" y="146" width="26" height="22" color="#008F44" label_side="bottom" label="Table 1" type="table" icon_of="4" />
            <style font-family="Arial" font-size="9" />
        </display>
        <interface page_cols="0" page_rows="0" page_width="640" page_height="480" home_page="0">
            <simulation_delay>0</simulation_delay>
