    <model>
        <stock name="Amount_A">
            <eqn>1000</eqn>
            <inflow>Interest_A</inflow>
            <non_negative />
            <display x="221" y="76" color="blue" />
        </stock>
        <flow name="Interest_A">
            <eqn>Amount_A*Annual_Rate_A</eqn>
            <non_negative />
            <display x="143" y="69" color="blue">
                <pts>
                    <pt x="86" y="69" />
                    <pt x="201" y="69" />
                </pts>
            </display>
        </flow>
        <aux name="Annual_Rate_A">
            <eqn>.06</eqn>
            <display x="62" y="100" color="blue" />
        </aux>
        <stock name="Amount_C">
