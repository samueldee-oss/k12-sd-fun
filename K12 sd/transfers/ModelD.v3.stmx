                    <pt x="205" y="192" />
                </pts>
            </display>
        </flow>
        <aux name="Annual_Rate_B">
            <eqn>.0595</eqn>
            <display x="73" y="224" color="blue" />
        </aux>
        <group name="Bank_A___6%_Interest___Compounded_Quarterly">
