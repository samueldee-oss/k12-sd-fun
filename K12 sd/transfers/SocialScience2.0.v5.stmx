    <model>
        <stock name="Graffiti">
            <eqn>100000</eqn>
            <outflow>Graffiti_painted</outflow>
            <non_negative />
            <display x="93" y="66" color="black" />
        </stock>
        <flow name="Graffiti_painted">
            <eqn>Area_Painted_per_Scout*Number_of_Scouts</eqn>
            <non_negative />
            <display x="182" y="63" color="black" label_side="top">
                <pts>
                    <pt x="113" y="63" />
                    <pt x="251" y="63" />
                </pts>
            </display>
        </flow>
        <aux name="Number_of_Scouts">
            <eqn>23</eqn>
            <display x="118" y="135" color="black" />
        </aux>
        <aux name="Area_Painted_per_Scout">
            <eqn>500</eqn>
            <display x="240" y="130" color="black" />
        </aux>
        <display page_width="552" page_height="728" isee:converter_size="large" interval="DT">
            <connector x="127" y="127" uid="0">
                <from>Number_of_Scouts</from>
                <to>Graffiti_painted</to>
            </connector>
            <connector x="231" y="122" uid="1">
                <from>Area_Painted_per_Scout</from>
                <to>Graffiti_painted</to>
            </connector>
            <stacked_container height="282" width="492" uid="2">
