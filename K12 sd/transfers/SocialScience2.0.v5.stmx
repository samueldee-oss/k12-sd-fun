            <pad_icon x="318" y="45" width="26" height="22" color="#0CA0FF" label_side="bottom" label="Graph 1" type="graph" icon_of="2" />
            <stacked_container height="286" width="465" uid="3">
                <table font-size="9" background="#FFFE91" column_width="60" orientation="vertical" interval="1" cleared="true" date_time="1997-07-16T21:35:38Z">
                    <title>Untitled Table</title>
                    <item type="time" color="black" width="100" />
                    <item color="black" precision="0.01" delimit_000s="true" index="0">
