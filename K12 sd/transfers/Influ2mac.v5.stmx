            <pad_icon x="714" y="2001" width="26" height="22" color="#0CA0FF" label_side="bottom" label="Graph 9" type="graph" icon_of="79" />
            <text_box x="131" y="48" uid="80" color="black" font-family="Times New Roman" font-size="48" text-align="center" padding="5" width="311" height="68">Influenza</text_box>
            <text_box x="214" y="302" uid="81" color="black" font-family="Times New Roman" font-size="18" text-align="center" padding="5" width="139" height="32">Ryan Ivie</text_box>
            <text_box x="28" y="411" uid="82" color="black" font-family="Times New Roman" font-size="12" padding="5" width="492" height="250">     Influenza is a virus that attacks all over the world.  When a person is infected with the influenza virus (flu) they experience chills, fever, headache, dry coughs, sore throat, weakness,  and general muscle aches.  The virus lasts from a few days to more then a week.&#x0D;     The most severe influenza outbreaks have been in . . . &#x0D;     There is a vaccine to the flu, but this vaccine only gives short term immunity that lasts about six months.  This time span, however, covers the time that influenza is in its peak.&#x0D;</text_box>
            <button x="481" y="157" width="46" height="29" uid="83" appearance="opaque" background="#C9EAFF" color="white" style="rounded" label="Next" font-family="Arial" font-size="12" text-align="center">
                <link target="interface" x="0" y="344" isee:effect="9" />
            </button>
            <button x="529" y="488" width="44" height="28" uid="84" appearance="opaque" background="#C9EAFF" color="white" style="rounded" label="Back" font-family="Arial" font-size="12" text-align="center">
                <link target="interface" x="0" y="0" isee:effect="9" />
            </button>
            <text_box x="143" y="365" uid="85" color="black" font-family="Times New Roman" font-size="18" text-align="center" padding="5" width="251" height="32">Influenza Information</text_box>
            <button x="530" y="529" width="42" height="28" uid="86" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Next" font-family="Arial" font-size="12" text-align="center">
                <link target="interface" x="0" y="712" isee:effect="9" />
            </button>
            <text_box x="192" y="726" uid="87" color="black" font-family="Times New Roman" font-size="18" text-align="center" padding="5" width="185" height="32">Basic Influenza System</text_box>
            <button x="524" y="917" width="41" height="28" uid="88" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Next" font-family="Arial" font-size="12" text-align="center">
                <link target="model" x="0" y="0" isee:effect="9" />
            </button>
            <button x="525" y="873" width="42" height="26" uid="89" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Back" font-family="Arial" font-size="12" text-align="center">
                <link target="interface" x="0" y="345" isee:effect="9" />
            </button>
            <text_box x="134" y="1125" uid="90" color="black" font-family="Times New Roman" font-size="24" text-align="center" padding="5" width="255" height="39">Interactivities</text_box>
            <text_box x="86" y="1308" uid="91" color="black" font-family="Times New Roman" font-size="12" padding="5" width="379" height="90">The following pages are interactive and allow the viwer to experience the model and adapt it in order to attain knowledge of its workings.  It would be greatly appreciated if the model not be saved after running new versions and that the sliders are reset to their original position by clicking on the &quot;U&quot; in the lower left hand corner of every slider.  Thank you.</text_box>
            <button x="502" y="1206" width="42" height="27" uid="92" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Back" font-family="Arial" font-size="12" text-align="center">
                <link target="model" x="0" y="0" isee:effect="9" />
            </button>
            <button x="503" y="1251" width="41" height="28" uid="93" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Next" font-family="Arial" font-size="12" text-align="center">
                <link target="interface" x="0" y="1456" isee:effect="9" />
            </button>
            <text_box x="231" y="1494" uid="94" color="black" font-family="Times New Roman" font-size="18" text-align="center" padding="5" width="142" height="32">Vaccinations</text_box>
            <button x="397" y="1496" width="41" height="24" uid="95" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Info" font-family="Arial" font-size="12" text-align="center">
                <popup x="0" y="32" width="200" height="100" background="yellow" color="black">
                    <text_box font-family="Arial" font-size="10">This page allows the viewer to change the average percentage of people that recieve vaccinations yearly.  By doing so, the viewer can see the changing effects of the disease on a population based on the number of people who become vaccinated.</text_box>
                </popup>
            </button>
            <slider x="122" y="1511" color="black" width="197" height="43" min="0" max="1" precision="0.01">
                <entity name="vaccine_perc" />
            </slider>
            <button x="458" y="1496" width="40" height="25" uid="96" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Run" font-family="Arial" font-size="12" text-align="center">
                <menu_action>run</menu_action>
            </button>
            <button x="527" y="1632" width="42" height="27" uid="97" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Back" font-family="Arial" font-size="12" text-align="center">
                <link target="interface" x="0" y="1081" isee:effect="9" />
            </button>
            <button x="528" y="1676" width="41" height="25" uid="98" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Next" font-family="Arial" font-size="12" text-align="center">
                <link target="interface" x="0" y="1831" isee:effect="9" />
            </button>
            <text_box x="223" y="1858" uid="99" color="black" font-family="Times New Roman" font-size="18" text-align="center" padding="5" width="133" height="32">Virus Mutation</text_box>
            <slider x="112" y="1872" color="black" width="197" height="43" min="0" max="1" precision="0.01">
                <entity name="immune_%" />
            </slider>
            <button x="367" y="1860" width="41" height="25" uid="100" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Info" font-family="Arial" font-size="12" text-align="center">
                <popup x="0" y="33" width="200" height="135" background="yellow" color="black">
                    <text_box font-family="Arial" font-size="10">Viral strains mutate very quickly.  This attribute allows the influenza virus to re-infect people who have become immune to the previous non-mutated strain.  The initial model assumes that the virus doesn&apos;t change and that 99% of the people infected become immune.  By lowering this percentage, the viewer can assume that the virus has mutated and less people become immune.</text_box>
                </popup>
            </button>
            <button x="437" y="1861" width="39" height="25" uid="101" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Run" font-family="Arial" font-size="12" text-align="center">
                <menu_action>run</menu_action>
            </button>
            <button x="518" y="2001" width="44" height="27" uid="102" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Back" font-family="Arial" font-size="12" text-align="center">
                <link target="interface" x="0" y="1464" isee:effect="9" />
            </button>
            <button x="519" y="2047" width="42" height="24" uid="103" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Next" font-family="Arial" font-size="12" text-align="center">
                <link target="interface" x="602" y="0" isee:effect="9" />
            </button>
            <text_box x="843" y="33" uid="104" color="black" font-family="Times New Roman" font-size="18" text-align="center" padding="5" width="108" height="32">Contacts</text_box>
            <slider x="720" y="49" color="black" width="197" height="43" min="0" max="300">
                <entity name="number_of_contacts" />
            </slider>
            <button x="984" y="31" width="41" height="27" uid="105" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Info" font-family="Arial" font-size="12" text-align="center">
                <popup x="0" y="35" width="130" height="85" background="yellow" color="black">
                    <text_box font-family="Arial" font-size="10">This page allows the viewer to change the average number of people that someone comes in contact with daily. </text_box>
                </popup>
            </button>
            <button x="427" y="728" width="40" height="27" uid="106" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Info" font-family="Arial" font-size="12" text-align="center">
                <popup x="0" y="35" width="150" height="125" background="yellow" color="black">
                    <text_box font-family="Arial" font-size="10">This graph shows what would happen to a population when an influenza virus is introduced.  The x-axis is measured by days and the the y-axis is measured by people.  Click on the tab on the bottom left hand corner of the graph to view the second page.</text_box>
                </popup>
            </button>
            <button x="1120" y="215" width="42" height="25" uid="107" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Next" font-family="Arial" font-size="12" text-align="center">
                <link target="interface" x="618" y="415" isee:effect="9" />
            </button>
            <button x="1120" y="170" width="43" height="27" uid="108" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Back" font-family="Arial" font-size="12" text-align="center">
                <link target="interface" x="0" y="1834" isee:effect="9" />
            </button>
            <text_box x="839" y="444" uid="109" color="black" font-family="Times New Roman" font-size="18" text-align="center" padding="5" width="125" height="32">Contraction</text_box>
            <slider x="728" y="457" color="black" width="197" height="43" min="0" max="1" precision="0.01">
                <entity name="prob_of_contraction" />
            </slider>
            <button x="977" y="447" width="41" height="26" uid="110" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Info" font-family="Arial" font-size="12" text-align="center">
                <popup x="0" y="34" width="130" height="85" background="yellow" color="black">
                    <text_box font-family="Arial" font-size="10">This page allows the viewer to change the probability that someone who comes in contact with an infected person will be infected.</text_box>
                </popup>
            </button>
            <button x="1046" y="447" width="42" height="26" uid="111" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Run" font-family="Arial" font-size="12" text-align="center">
                <menu_action>run</menu_action>
            </button>
            <button x="1132" y="591" width="42" height="26" uid="112" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Back" font-family="Arial" font-size="12" text-align="center">
                <link target="interface" x="602" y="0" isee:effect="9" />
            </button>
            <button x="1133" y="635" width="41" height="26" uid="113" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Next" font-family="Arial" font-size="12" text-align="center">
                <link target="interface" x="618" y="782" isee:effect="9" />
            </button>
            <text_box x="825" y="808" uid="114" color="black" font-family="Times New Roman" font-size="18" text-align="center" padding="5" width="154" height="32">Vaccine Fault</text_box>
            <slider x="724" y="823" color="black" width="197" height="43" min="0" max="1" precision="0.01">
                <entity name="fault_rate" />
            </slider>
            <button x="987" y="809" width="38" height="25" uid="115" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Info" font-family="Arial" font-size="12" text-align="center">
                <popup x="0" y="33" width="150" height="120" background="yellow" color="black">
                    <text_box font-family="Arial" font-size="10">This page allows the viewer to change the average percentage of people upon whom the vaccine is ineffective.  It can be assumed that the vaccine never fails or that there is no vaccine by lowering and raising the value.</text_box>
                </popup>
            </button>
            <button x="1056" y="809" width="37" height="25" uid="116" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Run" font-family="Arial" font-size="12" text-align="center">
                <menu_action>run</menu_action>
            </button>
            <button x="1134" y="957" width="42" height="28" uid="117" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Back" font-family="Arial" font-size="12" text-align="center">
                <link target="interface" x="618" y="415" isee:effect="9" />
            </button>
            <button x="1135" y="1003" width="42" height="26" uid="118" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Next" font-family="Arial" font-size="12" text-align="center">
                <link target="interface" x="618" y="1157" isee:effect="9" />
            </button>
            <button x="1051" y="31" width="38" height="27" uid="119" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Run" font-family="Arial" font-size="12" text-align="center">
                <menu_action>run</menu_action>
            </button>
            <text_box x="840" y="1184" uid="120" color="black" font-family="Times New Roman" font-size="18" text-align="center" padding="5" width="110" height="32">Incubation</text_box>
            <slider x="726" y="1202" color="black" width="197" height="43" min="1" max="14" precision="1">
                <entity name="incubation_period" />
            </slider>
            <button x="981" y="1189" width="40" height="25" uid="121" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Info" font-family="Arial" font-size="12" text-align="center">
                <popup x="0" y="33" width="150" height="110" background="yellow" color="black">
                    <text_box font-family="Arial" font-size="10">This page allow the viewer to change the incubation period of the particular influenza strain.  The initial model assumes an average of 2 days, but some strains can act quicker or slower depending on make-up and conditions.</text_box>
                </popup>
            </button>
            <button x="1056" y="1189" width="37" height="26" uid="122" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Run" font-family="Arial" font-size="12" text-align="center">
                <menu_action>run</menu_action>
            </button>
            <button x="1137" y="1338" width="41" height="26" uid="123" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Back" font-family="Arial" font-size="12" text-align="center">
                <link target="interface" x="618" y="782" isee:effect="9" />
            </button>
            <button x="1138" y="1384" width="40" height="25" uid="124" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Next" font-family="Arial" font-size="12" text-align="center">
                <link target="interface" x="618" y="1532" isee:effect="9" />
            </button>
            <text_box x="841" y="1558" uid="125" color="#9FCBB4" font-family="Times New Roman" font-size="18" text-align="center" padding="5" width="114" height="32">Recovery</text_box>
            <slider x="728" y="1577" color="black" width="197" height="43" min="1" max="14" precision="1">
                <entity name="recovery_time" />
            </slider>
            <button x="973" y="1565" width="38" height="24" uid="126" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Info" font-family="Arial" font-size="12" text-align="center">
                <popup x="0" y="32" width="150" height="125" background="yellow" color="black">
                    <text_box font-family="Arial" font-size="10">This page allows the viewer to change the amount of time it takes for a person to recover from influenza.  The initial model assumes an average recovery of time of 6 days, but the recovery rate changes based on the make-up and conditions of the virus.</text_box>
                </popup>
            </button>
            <button x="1049" y="1566" width="38" height="23" uid="127" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Run" font-family="Arial" font-size="12" text-align="center">
                <menu_action>run</menu_action>
            </button>
            <button x="1137" y="1714" width="40" height="28" uid="128" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Back" font-family="Arial" font-size="12" text-align="center">
                <link target="interface" x="618" y="1157" isee:effect="9" />
            </button>
            <button x="1137" y="1759" width="40" height="27" uid="129" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Next" font-family="Arial" font-size="12" text-align="center">
                <link target="interface" x="618" y="1899" isee:effect="9" />
            </button>
            <text_box x="865" y="1929" uid="130" color="black" font-family="Times New Roman" font-size="18" text-align="center" padding="5" width="81" height="32">Death</text_box>
            <slider x="731" y="1947" color="black" width="197" height="43" min="0" max="1">
                <entity name="death_rate" />
            </slider>
            <button x="975" y="1936" width="36" height="24" uid="131" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Info" font-family="Arial" font-size="12" text-align="center">
                <popup x="0" y="32" width="140" height="100" background="yellow" color="black">
                    <text_box font-family="Arial" font-size="10">This page allows the viewer to change the death rate caused by the influenza virus.  Some strains are more fatal than others, and this page allows experimentation with that.</text_box>
                </popup>
            </button>
            <button x="1044" y="1937" width="35" height="24" uid="132" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Run" font-family="Arial" font-size="12" text-align="center">
                <menu_action>run</menu_action>
            </button>
            <button x="1140" y="2080" width="41" height="28" uid="133" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Back" font-family="Arial" font-size="12" text-align="center">
                <link target="interface" x="618" y="1532" isee:effect="9" />
            </button>
            <button x="1141" y="2125" width="40" height="27" uid="134" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Next" font-family="Arial" font-size="12" text-align="center">
                <link target="interface" x="1196" y="0" isee:effect="9" />
            </button>
            <text_box x="1423" y="25" uid="135" color="black" font-family="Times New Roman" font-size="24" text-align="center" padding="5" width="81" height="39">End</text_box>
            <text_box x="1302" y="57" uid="136" color="black" font-family="Times New Roman" font-size="12" padding="5" width="338" height="42">You have now completed the exploration of the Influenza model.  Remember not to save the model when it is closed.</text_box>
            <text_box x="1259" y="268" uid="137" color="black" font-family="Times New Roman" font-size="12" padding="5" width="414" height="58">The information neccessary to the construction of this model was obtained through research in text books and various web pages throughout the internet.  A special thanks goes out to Mr. Guthrie for his help in making this model run efficiently.</text_box>
            <button x="1695" y="141" width="40" height="28" uid="138" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Back" font-family="Arial" font-size="12" text-align="center">
                <link target="interface" x="618" y="1898" isee:effect="9" />
            </button>
            <button x="1688" y="192" width="57" height="36" uid="139" appearance="opaque" background="#C9FFFF" color="white" style="rounded" label="Return to Start" font-family="Arial" font-size="12" text-align="center">
                <link target="interface" x="0" y="0" isee:effect="9" />
            </button>
            <style font-family="Arial" font-size="9" />
        </interface>
        <style font-family="Arial" font-size="9" />
    </model>
</xmile>
