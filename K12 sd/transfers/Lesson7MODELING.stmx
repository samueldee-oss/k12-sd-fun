            </stacked_container>
            <pad_icon x="738" y="1314" width="26" height="22" color="#008F44" label_side="bottom" label="Table 2" type="table" icon_of="21" />
            <numeric_display precision="0.01" display_as="currency" color="red" show_name="true" retain_ending_value="true" uid="22" x="689" y="1275">
                <entity name="MY__SAVINGS" />
            </numeric_display>
            <button x="311" y="49" width="183" height="30" uid="23" appearance="opaque" background="#0CA0FF" color="white" style="rounded" label="Intro: Build Your Own Model!" font-family="Arial" font-size="12" text-align="center">
                <popup x="-184" y="40" width="617" height="346" background="yellow" color="black">
                    <text_box font-family="Arial" font-size="16">If you haven&apos;t modeled before, watch our Build Your Own Personal Finance Model video to help you get started with using STELLA modeling software, available at http://clexchange.org/curriculum/dollarsandsense.asp. &#x0D;&#x0D;Choose from 3 options:&#x0D;&#x0D;(1) Use this blank STELLA page to build your own model from scratch. Everything you need is here (icons/buttons for building blocks, tables and graphs, text; Word menus to run and print...);  OR&#x0D;&#x0D;(2) Click on the &quot;Explore Simple Stock and Flow Model&quot; button to see the core pre-built stock and flow model (Go ahead and make changes -- insert new numbers, change names, add building blocks!);  OR&#x0D;&#x0D;(3) Click on the &quot;Explore Model Used in Lesson 7&quot; to explore a version of the actual model used in Lesson 7 (it&apos;s a bit more complicated, but everything in it is explained!). &#x0D;&#x0D;Start wherever you want! Play with it and have fun!&#x0D;</text_box>
                </popup>
            </button>
            <button x="289" y="1217" width="129" height="34" uid="24" appearance="opaque" background="#0CA0FF" color="white" style="rounded" label="What can I do with this?" font-family="Arial" font-size="12" text-align="center">
                <popup x="-124" y="286" width="422" height="204" background="yellow" color="black">
                    <text_box font-family="Arial" font-size="16">This is a version of the model underlying the Lesson 7 Simulation. When you click and open any building block, you will find an explanation for how it works. &#x0D;&#x0D;You will notice that we have added several new TOTAL STOCKS.  Why do you think we put those in? Click on these STOCKS to learn more.&#x0D;&#x0D;Explore how you can make changes (e.g., change numbers; rename or add new building blocks to make this your model). Play with it and have fun!&#x0D;</text_box>
                </popup>
            </button>
            <numeric_display precision="1" delimit_000s="true" color="blue" show_name="true" retain_ending_value="true" uid="25" x="689" y="1259">
                <entity name="Years_Elapsed" />
            </numeric_display>
            <button x="476" y="1092" width="146" height="31" uid="26" appearance="opaque" background="red" color="white" style="square" label="Explore Model Used in Lesson 1" font-family="Arial" font-size="12" text-align="center">
                <link target="model" x="0" y="1144" />
            </button>
            <button x="502" y="518" width="146" height="31" uid="27" appearance="opaque" background="red" color="white" style="square" label="Explore Model Used in Lesson 1" font-family="Arial" font-size="12" text-align="center">
                <link target="model" x="0" y="1144" />
            </button>
            <button x="340" y="518" width="146" height="31" uid="28" appearance="opaque" background="red" color="white" style="square" label="Explore Simple Stock and Flow Model" font-family="Arial" font-size="12" text-align="center">
                <link target="model" x="0" y="588" />
            </button>
            <button x="179" y="518" width="147" height="32" uid="29" appearance="opaque" background="#E0E0E0" color="white" style="square" label="Build Your Own Model " font-family="Arial" font-size="12" text-align="center">
                <link target="model" x="0" y="0" />
            </button>
