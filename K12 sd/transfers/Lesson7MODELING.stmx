            </stacked_container>
            <pad_icon x="744" y="882" width="26" height="22" color="#008F44" label_side="bottom" label="Table 1" type="table" icon_of="20" />
            <stacked_container height="253" width="381" visible_index="1" uid="21">
                <table font-size="9" background="#FFFE91" column_width="98" orientation="vertical" interval="1" cleared="true" date_time="2010-12-22T11:08:27Z">
                    <title>Untitled Table</title>
                    <item type="time" color="black" precision="max" width="47" />
