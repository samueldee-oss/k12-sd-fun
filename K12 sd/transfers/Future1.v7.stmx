                <item uid="21" />
            </display>
        </group>
        <display page_width="552" page_height="730" page_cols="2" page_rows="2" isee:converter_size="large" isee:animate_flows="true" isee:animate_stocks="true" isee:animate_converters="true" interval="DT" report_balances="ending">
            <connector x="112" y="394" uid="9">
