            <text_box x="141" y="26" uid="22" color="#7F00FF" font-family="Times New Roman" font-size="18" font-weight="bold" text-align="center" padding="5" border-style="double" border-width="thick-thin" width="299" height="68">MODELING YOUR FUTURE:&#x0D;Education and Career Choice Options&#x0D;</text_box>
            <style font-family="Arial" font-size="9" />
        </display>
