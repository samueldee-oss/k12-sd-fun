    <model>
        <stock name="Epsilon">
            <eqn>2200000</eqn>
            <non_negative />
            <display x="273" y="59" color="blue" />
        </stock>
        <stock name="Meteor">
            <eqn>200000</eqn>
            <inflow>Meteor_Speed</inflow>
            <non_negative />
            <display x="273" y="131" color="blue" />
        </stock>
        <flow name="Meteor_Speed">
            <eqn>200000</eqn>
            <non_negative />
            <display x="195" y="134" color="blue">
                <pts>
                    <pt x="138" y="134" />
                    <pt x="253" y="134" />
                </pts>
