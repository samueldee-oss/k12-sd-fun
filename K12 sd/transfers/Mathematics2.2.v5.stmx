        </flow>
        <stock name="Enterprise">
            <eqn>0</eqn>
            <inflow>Enterprise_speed</inflow>
            <non_negative />
            <display x="273" y="215" color="blue" />
        </stock>
        <flow name="Enterprise_speed">
            <eqn>219500</eqn>
            <non_negative />
            <display x="201" y="217" color="blue">
                <pts>
                    <pt x="149" y="217" />
                    <pt x="253" y="217" />
                </pts>
