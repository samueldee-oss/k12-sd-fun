<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" level="3" xmlns="http://www.systemdynamics.org/XMILE" xmlns:isee="http://iseesystems.com/XMILE">
    <header>
        <smile version="1.0" namespace="std, isee">
            <uses_arrays>1</uses_arrays>
        </smile>
        <name>Gallaher5.4.v3</name>
        <uuid>74a1f958-fc34-40ad-bd10-cc46ac2ffae5</uuid>
        <vendor>isee systems, inc.</vendor>
        <product version="10.1.2" isee:saved_by_v1="false" lang="en">iThink</product>
    </header>
    <style>
        <model font-family="Arial" font-size="9" />
        <interface font-family="Arial" font-size="9" />
    </style>
    <sim_specs method="Euler" time_units="Hours" isee:pause_after_rates="false" isee:instantaneous_flows="false">
        <start>0</start>
        <stop>72</stop>
        <dt>0.1</dt>
        <isee:analyze_mode>false</isee:analyze_mode>
    </sim_specs>
    <dimensions>
        <dim name="Dim_Name_1" size="1" />
    </dimensions>
    <model_units />
    <isee:prefs last_model="true" layer="model" grid_width="20" grid_height="50" divide_by_zero_alert="true" hide_taskbar="true" show_module_prefix="true">
        <isee:window width="1366" height="685" />
        <isee:security />
        <isee:print_setup width="595" height="775" />
    </isee:prefs>
    <isee:equation_prefs order_by="sector" />
    <model>
        <stock name="Amt_in_Stomach">
            <eqn>0</eqn>
            <inflow>Ingestion</inflow>
            <outflow>Absorption_Rate</outflow>
            <non_negative />
            <display x="158" y="64" color="black" label_angle="104" />
        </stock>
        <flow name="Ingestion">
            <eqn>PULSE(2*Pill_Size,0,6)</eqn>
            <non_negative />
            <display x="110" y="65" color="black">
                <pts>
                    <pt x="82" y="65" />
                    <pt x="138" y="65" />
                </pts>
            </display>
        </flow>
        <aux name="Pill_Size">
            <eqn>10000</eqn>
            <display x="68" y="125" color="blue" />
        </aux>
        <stock name="Amt_in_Body">
            <eqn>0</eqn>
            <inflow>Absorption_Rate</inflow>
            <outflow>Metabolism_Rate</outflow>
            <non_negative />
            <display x="317" y="63" color="black" label_angle="76" />
        </stock>
        <flow name="Absorption_Rate">
            <eqn>Amt_in_Stomach*Ka</eqn>
            <non_negative />
            <display x="237" y="62" color="black" label_side="top">
                <pts>
                    <pt x="178" y="62" />
                    <pt x="297" y="62" />
                </pts>
            </display>
        </flow>
        <aux name="Ka">
            <eqn>.693/Absorp_Halftime</eqn>
            <display x="273" y="121" color="blue" />
        </aux>
        <aux name="Absorp_Halftime">
            <eqn>1 {hours}</eqn>
            <display x="202" y="116" color="blue" />
        </aux>
        <flow name="Metabolism_Rate">
            <eqn>Amt_in_Body*Ke</eqn>
            <non_negative />
            <display x="383" y="60" color="black" label_side="top" label_angle="54">
                <pts>
                    <pt x="337" y="60" />
                    <pt x="430" y="60" />
                </pts>
            </display>
        </flow>
        <aux name="Ke">
            <eqn>.693/Elimination_Halftime</eqn>
            <display x="416" y="117" color="blue" />
        </aux>
        <aux name="Elimination_Halftime">
            <eqn>8 {hours}</eqn>
            <display x="339" y="104" color="blue" />
        </aux>
        <display page_width="595" page_height="775" isee:converter_size="medium" interval="DT">
            <connector x="66" y="116" uid="0">
                <from>Pill_Size</from>
                <to>Ingestion</to>
            </connector>
            <connector x="213" y="120" uid="1">
                <from>Absorp_Halftime</from>
                <to>Ka</to>
            </connector>
            <connector x="267" y="114" uid="2">
                <from>Ka</from>
                <to>Absorption_Rate</to>
            </connector>
            <connector x="180" y="68" uid="3">
                <from>Amt_in_Stomach</from>
                <to>Absorption_Rate</to>
            </connector>
            <connector x="410" y="110" uid="4">
                <from>Ke</from>
                <to>Metabolism_Rate</to>
            </connector>
            <connector x="350" y="108" uid="5">
                <from>Elimination_Halftime</from>
                <to>Ke</to>
            </connector>
            <connector x="339" y="77" uid="6">
                <from>Amt_in_Body</from>
                <to>Metabolism_Rate</to>
            </connector>
            <stacked_container height="282" width="492" uid="7">
                <graph type="time_series" title="Amount vs Time" background="#C8C8C8" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-07T15:43:18Z" cleared="true" time_precision="0" from="0" to="72">
                    <plot index="0" pen_width="1" color="red" precision="1" show_y_axis="true">
                        <scale min="0" max="50000" />
                        <entity name="Amt_in_Stomach" />
                    </plot>
                    <plot index="1" pen_width="1" color="blue" precision="1" show_y_axis="true">
                        <scale min="0" max="50000" />
                        <entity name="Amt_in_Body" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="150" y="173" width="26" height="22" color="black" label_side="bottom" label="Graph of Amount vs Time" type="graph" icon_of="7" />
            <stacked_container height="286" width="465" uid="8">
                <table font-size="9" background="#FFFE91" column_width="60" orientation="vertical" interval="0.1" cleared="true" date_time="1997-07-03T20:46:13Z">
                    <title>Amount vs Time</title>
                    <item type="time" color="black" precision="0.01" width="100" />
                    <item color="black" precision="0.01" delimit_000s="true" index="0">
                        <entity name="Amt_in_Stomach" />
                    </item>
                    <item color="black" precision="0.01" delimit_000s="true" index="1">
                        <entity name="Amt_in_Body" />
                    </item>
                </table>
            </stacked_container>
            <pad_icon x="331" y="175" width="26" height="22" color="black" label_side="bottom" label="Table of Amount vs Time" type="table" icon_of="8" />
            <style font-family="Arial" font-size="9" />
        </display>
        <interface page_cols="0" page_rows="0" page_width="788" page_height="528" home_page="0">
            <simulation_delay>0.1</simulation_delay>
            <style font-family="Arial" font-size="9" />
        </interface>
        <popup x="16" y="78" content="7" />
        <popup x="16" y="78" content="8" />
        <style font-family="Arial" font-size="9" />
    </model>
</xmile>
