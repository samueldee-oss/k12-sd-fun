    <model>
        <stock name="Y">
            <eqn>1.21</eqn>
            <inflow>Increase_in_value</inflow>
            <non_negative />
            <display x="85" y="78" color="blue" />
        </stock>
        <flow name="Increase_in_value">
            <eqn>Y*Rate_of_increase</eqn>
            <non_negative />
            <display x="169" y="81" color="blue">
                <pts>
                    <pt x="234" y="81" />
                    <pt x="105" y="81" />
                </pts>
            </display>
        </flow>
        <aux name="Rate_of_increase">
            <eqn>.1</eqn>
            <display x="164" y="171" color="blue" />
        </aux>
        <display page_width="552" page_height="728" isee:converter_size="large" interval="DT">
            <connector x="107" y="81" uid="0">
                <from>Y</from>
                <to>Increase_in_value</to>
            </connector>
            <connector x="176" y="173" uid="1">
                <from>Rate_of_increase</from>
                <to>Increase_in_value</to>
            </connector>
            <stacked_container height="286" width="465" uid="2">
                <table font-size="9" background="#FFFE91" column_width="101" orientation="vertical" interval="1" cleared="true" date_time="1997-07-18T18:50:42Z">
                    <title>Untitled Table</title>
                    <item type="time" color="black" width="100" />
                    <item color="black" precision="max" delimit_000s="true" index="0">
