<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" level="3" xmlns="http://www.systemdynamics.org/XMILE" xmlns:isee="http://iseesystems.com/XMILE">
    <header>
        <smile version="1.0" namespace="std, isee">
            <uses_arrays>1</uses_arrays>
        </smile>
        <name>EXTBASIN</name>
        <uuid>697a98a3-42c5-45a5-81ce-a245b53dc38b</uuid>
        <vendor>isee systems, inc.</vendor>
        <product version="10.1.2" isee:saved_by_v1="false" lang="en">iThink</product>
    </header>
    <style>
        <model font-family="Arial" font-size="9" />
        <interface font-family="Arial" font-size="9" />
    </style>
    <sim_specs method="Euler" time_units="Days" isee:pause_after_rates="false" isee:instantaneous_flows="false">
        <start>0</start>
        <stop>100</stop>
        <dt>0.25</dt>
        <isee:analyze_mode>false</isee:analyze_mode>
    </sim_specs>
    <dimensions>
        <dim name="Dim_Name_1" size="1" />
    </dimensions>
    <model_units />
    <isee:prefs last_model="true" layer="interface" grid_width="20" grid_height="50" divide_by_zero_alert="true" link_high_level_map="true" show_module_prefix="true">
        <isee:window width="624" height="430" />
        <isee:security password="true" />
        <isee:print_setup width="595" height="744" />
    </isee:prefs>
    <isee:equation_prefs order_by="sector" />
    <model>
        <stock name="UNINFECTED">
            <eqn>initial_population_size*(1-initial_fraction_immune)</eqn>
            <outflow>New_Infections</outflow>
            <non_negative />
            <display x="100" y="200" color="blue" />
        </stock>
        <stock name="INFECTED">
            <eqn>1</eqn>
            <inflow>New_Infections</inflow>
            <outflow>Recovery</outflow>
            <non_negative />
            <display x="240" y="200" color="blue" />
        </stock>
        <stock name="IMMUNE">
            <eqn>initial_population_size*initial_fraction_immune</eqn>
            <inflow>Recovery</inflow>
            <non_negative />
            <display x="380" y="200" color="blue" />
        </stock>
        <flow name="New_Infections">
            <eqn>INFECTED*number_of_contacts*prob_contact_is_susceptible*prob_of_infection</eqn>
            <non_negative />
            <display x="170" y="200" color="blue" label_side="top">
                <pts>
                    <pt x="120" y="200" />
                    <pt x="220" y="200" />
                </pts>
            </display>
        </flow>
        <flow name="Recovery">
            <eqn>INFECTED/duration_of_illness_in_days</eqn>
            <non_negative />
            <display x="310" y="200" color="blue">
                <pts>
                    <pt x="260" y="200" />
                    <pt x="360" y="200" />
                </pts>
            </display>
        </flow>
        <aux name="number_of_contacts">
            <eqn>10</eqn>
            <display x="100" y="250" color="blue" />
        </aux>
        <aux name="prob_of_infection">
            <eqn>.1</eqn>
            <display x="190" y="248" color="blue" />
        </aux>
        <aux name="prob_contact_is_susceptible">
            <eqn>UNINFECTED/(INFECTED+IMMUNE+UNINFECTED-1)</eqn>
            <display x="140" y="300" color="blue" />
        </aux>
        <aux name="duration_of_illness_in_days">
            <eqn>2</eqn>
            <display x="300" y="150" color="blue" label_side="top" label_angle="77" />
        </aux>
        <aux name="initial_population_size">
            <eqn>99999</eqn>
            <display x="103" y="144" color="blue" label_side="top" label_angle="74" />
        </aux>
        <aux name="initial_fraction_immune">
            <eqn>.4</eqn>
            <display x="198" y="129" color="blue" />
        </aux>
        <display page_width="595" page_height="744" isee:converter_size="large" interval="DT">
            <connector x="108" y="240" uid="0">
                <from>number_of_contacts</from>
                <to>New_Infections</to>
            </connector>
            <connector x="218" y="212" uid="1">
                <from>INFECTED</from>
                <to>New_Infections</to>
            </connector>
            <connector x="192" y="236" uid="2">
                <from>prob_of_infection</from>
                <to>New_Infections</to>
            </connector>
            <connector x="144" y="289" uid="3">
                <from>prob_contact_is_susceptible</from>
                <to>New_Infections</to>
            </connector>
            <connector x="244" y="215" uid="4">
                <from>INFECTED</from>
                <to>prob_contact_is_susceptible</to>
            </connector>
            <connector x="80" y="209" uid="5">
                <from>UNINFECTED</from>
                <to>prob_contact_is_susceptible</to>
            </connector>
            <connector x="262" y="216" uid="6">
                <from>INFECTED</from>
                <to>Recovery</to>
            </connector>
            <connector x="311" y="156" uid="7">
                <from>duration_of_illness_in_days</from>
                <to>Recovery</to>
            </connector>
            <connector x="374" y="215" uid="8">
                <from>IMMUNE</from>
                <to>prob_contact_is_susceptible</to>
            </connector>
            <style font-family="Arial" font-size="9" />
        </display>
        <interface page_rows="6" page_width="640" page_height="480" scroll_y="1102">
            <simulation_delay>0</simulation_delay>
            <stacked_container x="7" y="145" height="251" width="450" uid="9">
                <graph type="time_series" title="Untitled" background="white" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-04T09:30:27Z" comparative="true" cleared="true" time_precision="2" from="0" to="100">
                    <plot index="0" pen_width="1" color="red" precision="0.01" show_y_axis="true">
                        <entity name="IMMUNE" />
                    </plot>
                </graph>
                <graph type="time_series" title="Untitled" background="white" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-04T09:30:27Z" comparative="true" cleared="true" time_precision="2" from="0" to="100">
                    <plot index="0" pen_width="1" color="red" precision="0.01" show_y_axis="true">
                        <entity name="INFECTED" />
                    </plot>
                </graph>
                <graph type="time_series" title="Untitled" background="white" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-04T09:30:27Z" comparative="true" cleared="true" time_precision="2" from="0" to="100">
                    <plot index="0" pen_width="1" color="red" precision="0.01" show_y_axis="true">
                        <entity name="New_Infections" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="180" y="326" width="26" height="22" color="#0CA0FF" label_side="bottom" label="Graph 1" type="graph" icon_of="9" />
            <slider x="109" y="65" label_angle="146" color="red" width="197" height="43" min="1" max="10" precision="1">
                <entity name="duration_of_illness_in_days" />
            </slider>
            <slider x="412" y="64" label_angle="28" color="red" width="197" height="43" min="0" max="0.8" precision="0.01">
                <entity name="initial_fraction_immune" />
            </slider>
            <slider x="259" y="22" label_side="right" label_angle="5" color="red" width="197" height="43" min="0" max="1e+006" precision="10000">
                <entity name="initial_population_size" />
            </slider>
            <slider x="365" y="107" label_side="bottom" color="red" width="197" height="43" min="0" max="50" precision="1">
                <entity name="number_of_contacts" />
            </slider>
            <slider x="168" y="107" label_side="bottom" color="red" width="197" height="43" min="0" max="1" precision="0.01">
                <entity name="prob_of_infection" />
            </slider>
            <button x="489" y="268" width="66" height="33" uid="10" appearance="opaque" background="red" color="white" style="rounded" clicking_sound="false" label="Clear Graphs" font-family="Arial" font-size="10" text-align="center" font-weight="bold">
                <menu_action>restore_graphs_tables</menu_action>
            </button>
            <button x="234" y="48" width="66" height="33" uid="11" appearance="opaque" background="red" color="white" style="rounded" clicking_sound="false" label="Reset Sliders" font-family="Arial" font-size="10" text-align="center" font-weight="bold">
                <menu_action>restore_sliders</menu_action>
            </button>
            <button x="489" y="228" width="66" height="33" uid="12" appearance="opaque" background="red" color="white" style="rounded" clicking_sound="false" label="Run" font-family="Arial" font-size="10" text-align="center" font-weight="bold">
                <menu_action>run</menu_action>
            </button>
            <button x="488" y="309" width="66" height="22" uid="13" appearance="opaque" background="blue" color="white" style="rounded" clicking_sound="false" label="Intro" font-family="Arial" font-size="10" text-align="center" font-weight="bold">
                <link target="interface" x="0" y="1102" />
            </button>
            <button x="490" y="338" width="66" height="22" uid="14" appearance="opaque" background="blue" color="white" style="rounded" clicking_sound="false" label="Debrief" font-family="Arial" font-size="10" text-align="center" font-weight="bold">
                <link target="interface" x="0" y="2212" />
            </button>
            <text_box x="35" y="1103" uid="15" color="red" font-family="Arial" font-size="18" font-weight="bold" text-align="center" padding="5" width="511" height="33">Extending the Basic Infection Model</text_box>
            <text_box x="13" y="1127" uid="16" color="black" font-family="Arial" font-size="12" padding="5" width="562" height="154">All models are simplifications of some real system.  As such, they treat the reality selectively, focusing on certain aspects, consciously or unconsciously downplaying others.  As each model is developed and explored, the insights it provides suggest additional directions for analysis.  This basic model of a contagious disease is certainly no exception.  That model was designed to capture the essence of the spread of a disease.  As a first step into that process, however, it was greatly  simplified:  Well people get sick and stay sick!  End of story!  That actually was a good first step, but what happens to the dynamics of the system, if people actually get well after a time?  This model extends the initial model to allow that question to be explored.</text_box>
            <graphics_frame x="7" y="1286" uid="17" width="222" height="177" border-color="#0CA0FF" fill="none">
                <image width="235" height="172">data:image/png;base64,</image>
            </graphics_frame>
            <text_box x="229" y="1279" uid="18" color="black" font-family="Arial" font-size="12" padding="5" width="343" height="154">To the left is the basic model with which we start.  Notice that once infected, there is no movement from that condition.&#x0D;&#x0D;Below is a slight modification of this model in which the INFECTED population recovers in a user-defined period of time.  Recovered individuals are now &quot;IMMUNE&quot; and no longer available to catch the disease nor to pass it on to others.</text_box>
            <button x="488" y="1432" width="53" height="19" uid="19" appearance="opaque" background="blue" color="white" style="rounded" clicking_sound="false" label="Down" font-family="Arial" font-size="10" text-align="center" font-weight="bold">
                <link target="interface" x="0" y="1304" />
            </button>
            <graphics_frame x="213" y="1475" uid="20" width="371" height="218" border-color="#0CA0FF" fill="none">
                <image width="379" height="228">data:image/png;base64,</image>
            </graphics_frame>
            <button x="111" y="1468" width="66" height="22" uid="21" appearance="opaque" background="blue" color="white" style="rounded" clicking_sound="false" label="Debrief" font-family="Arial" font-size="10" text-align="center" font-weight="bold">
                <link target="interface" x="0" y="2208" />
            </button>
            <button x="9" y="1468" width="95" height="22" uid="22" appearance="opaque" background="blue" color="white" style="rounded" clicking_sound="false" label="Control Panel" font-family="Arial" font-size="10" text-align="center" font-weight="bold">
                <link target="interface" x="0" y="0" />
            </button>
            <text_box x="6" y="1526" uid="23" color="black" font-family="Arial" font-size="12" padding="5" width="209" height="122">Click any of the new building blocks to see its definition.  Click the &quot;Control Panel&quot; button to move to a screen that provides the means to explore the behavior of this extended model.</text_box>
            <button x="15" y="1657" width="45" height="22" uid="24" appearance="opaque" background="blue" color="white" style="rounded" clicking_sound="false" label="Up" font-family="Arial" font-size="10" text-align="center" font-weight="bold">
                <link target="interface" x="0" y="1104" />
            </button>
            <button x="532" y="1549" width="42" height="31" uid="25" appearance="transparent" color="blue" style="square">
                <popup x="-165" y="0" width="150" height="30" background="yellow" color="black">
                    <text_box font-family="Arial" font-size="10">initial IMMUNE = 0</text_box>
                </popup>
            </button>
            <button x="265" y="1493" width="25" height="26" uid="26" appearance="transparent" color="blue" style="rounded">
                <popup x="-215" y="0" width="200" height="70" background="yellow" color="black">
                    <text_box font-family="Arial" font-size="10">The slider allows you to define the total initial population (SUSCEPTIBLE + INFECTED + IMMUNE) to a wide range of values.</text_box>
                </popup>
            </button>
            <button x="360" y="1479" width="25" height="26" uid="27" appearance="transparent" color="blue" style="rounded">
                <popup x="-215" y="0" width="200" height="70" background="yellow" color="black">
                    <text_box font-family="Arial" font-size="10">What proportion (0 - 1) of the total population is already immune to the disease when the simulation begins.</text_box>
                </popup>
            </button>
            <button x="473" y="1565" width="25" height="26" uid="28" appearance="transparent" color="blue" style="rounded">
                <popup x="-215" y="0" width="200" height="70" background="yellow" color="black">
                    <text_box font-family="Arial" font-size="10">Recovery = INFECTED/duration of illness in days</text_box>
                </popup>
            </button>
            <button x="460" y="1501" width="25" height="26" uid="29" appearance="transparent" color="blue" style="rounded">
                <popup x="-215" y="0" width="200" height="70" background="yellow" color="black">
                    <text_box font-family="Arial" font-size="10">How long (in days) does it take to recover from the disease and no longer be contagious?</text_box>
                </popup>
            </button>
            <button x="476" y="185" width="90" height="31" uid="30" appearance="opaque" background="black" color="white" style="rounded" clicking_sound="false" label="Instructions" font-family="Arial" font-size="10" text-align="center" font-weight="bold">
                <popup x="-465" y="0" width="450" height="300" background="yellow" color="black">
                    <text_box font-family="Arial" font-size="10">This control panel provides the means to play a wide diversity of &quot;what-if&quot; games with a simple model of disease transmission.  This new model, presented in the introductory screens (click the &quot;Intro&quot; button), divides a population into three stocks: UNINFECTED, INFECTED, and IMMUNE.  You can control several features of this simulation with the sliders provided:&#x0D;•  &quot;initial population size&quot;&#x0D;•  &quot;duration of illness in days&quot;&#x0D;•&quot;initial fraction immune&quot; (this allocates the total population between UNINFECTED and IMMUNE; 1 individual always begins in INFECTED)&#x0D;• &quot;prob(ability) of infection&quot; (how likely is infection from any given contact?)&#x0D;• &quot;number of contacts&quot; (with how many individuals does each INFECTED come into contact?)&#x0D;&#x0D;There are three graphs provided on the Graph Pad; each is set up to run as a comparative graph so that subsequent runs can be plotted together for comparison.  Cllick the &quot;dogear&quot; in the lower left corner of the graph to move between the available graphs.&#x0D;&#x0D;Explore these factors one at a time to begin.  For instance, what impact is there in the simulation&apos;s results, as &quot;initial fraction immune&quot; changes from 0, to .1, .2, .4. and .6?  What if &quot;duration of illness in days&quot; changes?  Explore a number of factors and after each exploration, please consider (write answers for) the questions posed in the &quot;Debrief&quot; section.</text_box>
                </popup>
            </button>
            <text_box x="33" y="2208" uid="31" color="red" font-family="Arial" font-size="18" font-weight="bold" text-align="center" padding="5" width="511" height="33">Extending the Basic Infection Model</text_box>
            <text_box x="138" y="2232" uid="32" color="red" font-family="Arial" font-size="14" font-weight="bold" text-align="center" padding="5" width="296" height="27">Debrief</text_box>
            <text_box x="23" y="2270" uid="33" color="black" font-family="Arial" font-size="12" padding="5" width="532" height="202">There were a multitude of experiments you could have pursued in this exercise.  Some parameter settings lead to rapid intense outbreaks of disease in which everyone eventually gets ill.  Some settings do not lead to any noticable outbreak of disease at all.  Some produce slow-to-develop, relatively minor outbreaks, which fizzle out before everyone is infected.  For any experiment, or set of related experiments, you carried out:&#x0D;&#x0D;•  Can you explain why the course(s) of the disease played out the way it(they) did?&#x0D;&#x0D;•  Can you identify a &quot;real world&quot; scenario for which your experiment represents a good model?</text_box>
            <button x="225" y="2522" width="95" height="22" uid="34" appearance="opaque" background="blue" color="white" style="rounded" clicking_sound="false" label="Control Panel" font-family="Arial" font-size="10" text-align="center" font-weight="bold">
                <link target="interface" x="0" y="0" />
            </button>
            <button x="333" y="2520" width="66" height="22" uid="35" appearance="opaque" background="blue" color="white" style="rounded" clicking_sound="false" label="Intro" font-family="Arial" font-size="10" text-align="center" font-weight="bold">
                <link target="interface" x="0" y="1102" />
            </button>
            <text_box x="4" y="1288" uid="36" color="blue" font-family="Arial" font-size="9" text-align="center" padding="5" width="79" height="21">UNINFECTED</text_box>
            <style font-family="Arial" font-size="9" />
        </interface>
        <style font-family="Arial" font-size="9" />
    </model>
</xmile>
