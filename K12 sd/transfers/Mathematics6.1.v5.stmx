<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" level="3" xmlns="http://www.systemdynamics.org/XMILE" xmlns:isee="http://iseesystems.com/XMILE">
    <header>
        <smile version="1.0" namespace="std, isee">
            <uses_arrays>1</uses_arrays>
        </smile>
        <name>Mathematics6.1.v5</name>
        <uuid>9388ebbd-dcc7-401d-a9ef-211deac5bcb8</uuid>
        <vendor>isee systems, inc.</vendor>
        <product version="10.1.2" isee:saved_by_v1="false" lang="en">iThink</product>
    </header>
    <style>
        <model font-family="Arial" font-size="9" />
        <interface font-family="Arial" font-size="9" />
    </style>
    <sim_specs method="RK4" time_units="Time" isee:pause_after_rates="false" isee:instantaneous_flows="false">
        <start>0</start>
        <stop>100</stop>
        <dt>1</dt>
        <isee:analyze_mode>false</isee:analyze_mode>
    </sim_specs>
    <dimensions>
        <dim name="Dim_Name_1" size="1" />
    </dimensions>
    <model_units />
    <isee:prefs last_model="true" layer="model" grid_width="20" grid_height="50" divide_by_zero_alert="true" link_high_level_map="true" show_module_prefix="true">
        <isee:window width="1334" height="630" />
        <isee:security />
        <isee:print_setup width="552" height="728" />
    </isee:prefs>
    <isee:equation_prefs order_by="sector" />
    <model>
        <stock name="Rabbits">
            <eqn>50000</eqn>
            <inflow>Rabbit_Births</inflow>
            <outflow>Rabbit_Deaths</outflow>
            <non_negative />
            <display x="253" y="89" color="blue" />
        </stock>
        <flow name="Rabbit_Births">
            <eqn>.5*10*.25*Rabbits</eqn>
            <non_negative />
            <display x="168" y="92" color="blue" label_side="top" label_angle="85">
                <pts>
                    <pt x="103" y="92" />
                    <pt x="233" y="92" />
                </pts>
            </display>
        </flow>
        <flow name="Rabbit_Deaths">
            <eqn>Rabbit_Kills_per_wolf*Wolves</eqn>
            <non_negative />
            <display x="334" y="92" color="blue" label_side="top">
                <pts>
                    <pt x="273" y="92" />
                    <pt x="395" y="92" />
                </pts>
            </display>
        </flow>
        <stock name="Wolves">
            <eqn>1250</eqn>
            <inflow>Wolf_Births</inflow>
            <outflow>Wolf_deaths</outflow>
            <non_negative />
            <display x="258" y="229" color="blue" label_side="bottom" />
        </stock>
        <flow name="Wolf_deaths">
            <eqn>Wolves*Wolf_Death_Rate+PULSE(10,5,999)</eqn>
            <non_negative />
            <display x="161" y="230" color="blue">
                <pts>
                    <pt x="238" y="230" />
                    <pt x="84" y="230" />
                </pts>
            </display>
        </flow>
        <flow name="Wolf_Births">
            <eqn>.5*1*.5*Wolves</eqn>
            <non_negative />
            <display x="334" y="229" color="blue">
                <pts>
                    <pt x="390" y="229" />
                    <pt x="278" y="229" />
                </pts>
            </display>
        </flow>
        <aux name="Rabbit_Density">
            <eqn>Rabbits/Area</eqn>
            <display x="150" y="153" color="blue" />
        </aux>
        <aux name="Area">
            <eqn>1000</eqn>
            <display x="51" y="154" color="blue" />
        </aux>
        <aux name="Rabbit_Kills_per_wolf">
            <eqn>Rabbit_Density</eqn>
            <gf>
                <xscale min="0" max="500" />
                <yscale min="0" max="500" />
                <ypts>0,50,100,150,200,250,300,350,400,450,500</ypts>
            </gf>
            <display x="255" y="149" color="blue" />
        </aux>
        <aux name="Wolf_Death_Rate">
            <eqn>Rabbit_Density</eqn>
            <gf>
                <xscale min="0" max="100" />
                <yscale min="0" max="0.5" />
                <ypts>0.5,0.45000000000000001,0.40000000000000002,0.34999999999999998,0.29999999999999999,0.25,0.20000000000000001,0.14999999999999999,0.10000000000000001,0.050000000000000003,0</ypts>
            </gf>
            <display x="60" y="279" color="blue" />
        </aux>
        <display page_width="552" page_height="728" isee:converter_size="large" interval="DT">
            <connector x="232" y="106" uid="0">
                <from>Rabbits</from>
                <to>Rabbit_Births</to>
            </connector>
            <connector x="236" y="240" uid="1">
                <from>Wolves</from>
                <to>Wolf_deaths</to>
            </connector>
            <connector x="281" y="244" uid="2">
                <from>Wolves</from>
                <to>Wolf_Births</to>
            </connector>
            <connector x="277" y="212" uid="3">
                <from>Wolves</from>
                <to>Rabbit_Deaths</to>
            </connector>
            <connector x="63" y="152" uid="4">
                <from>Area</from>
                <to>Rabbit_Density</to>
            </connector>
            <connector x="237" y="104" uid="5">
                <from>Rabbits</from>
                <to>Rabbit_Density</to>
            </connector>
            <connector x="162" y="152" uid="6">
                <from>Rabbit_Density</from>
                <to>Rabbit_Kills_per_wolf</to>
            </connector>
            <connector x="266" y="143" uid="7">
                <from>Rabbit_Kills_per_wolf</from>
                <to>Rabbit_Deaths</to>
            </connector>
            <connector x="138" y="156" uid="8">
                <from>Rabbit_Density</from>
                <to>Wolf_Death_Rate</to>
            </connector>
            <connector x="71" y="275" uid="9">
                <from>Wolf_Death_Rate</from>
                <to>Wolf_deaths</to>
            </connector>
            <stacked_container height="282" width="492" uid="10">
                <graph type="time_series" title="Untitled Graph" background="#C8C8C8" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-04T10:00:36Z" cleared="true" time_precision="2" from="0" to="100">
                    <plot index="0" pen_width="1" color="fuchsia" precision="0.01" show_y_axis="true">
                        <scale min="1000" max="2000" />
                        <entity name="Wolves" />
                    </plot>
                    <plot index="1" pen_width="1" color="red" precision="0.01" show_y_axis="true">
                        <scale min="40000" max="60000" />
                        <entity name="Rabbits" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="438" y="158" width="26" height="22" color="#0CA0FF" label_side="bottom" label="Graph 1" type="graph" icon_of="10" />
            <style font-family="Arial" font-size="9" />
        </display>
        <interface page_cols="0" page_rows="0" page_width="640" page_height="480" home_page="0">
            <simulation_delay>0</simulation_delay>
            <style font-family="Arial" font-size="9" />
        </interface>
        <popup x="8" y="51" content="10" />
        <style font-family="Arial" font-size="9" />
    </model>
</xmile>
