        <isee:security />
        <isee:print_setup width="595" height="775" />
    </isee:prefs>
    <isee:equation_prefs order_by="sector" />
    <model>
        <stock name="Poison_concentration">
            <eqn>.00372</eqn>
            <outflow>Decrease_in_value</outflow>
            <non_negative />
            <display x="105" y="80" color="blue" />
        </stock>
        <flow name="Decrease_in_value">
            <eqn>Poison_concentration*Rate_of_decrease</eqn>
            <non_negative />
            <display x="185" y="77" color="blue">
                <pts>
                    <pt x="125" y="77" />
                    <pt x="245" y="77" />
                </pts>
            </display>
        </flow>
        <aux name="Rate_of_decrease">
            <eqn>.0639</eqn>
            <display x="182" y="183" color="blue" />
        </aux>
        <display page_width="595" page_height="775" isee:converter_size="medium" interval="DT">
            <connector x="127" y="83" uid="0">
                <from>Poison_concentration</from>
                <to>Decrease_in_value</to>
            </connector>
            <connector x="191" y="183" uid="1">
                <from>Rate_of_decrease</from>
                <to>Decrease_in_value</to>
            </connector>
            <stacked_container height="286" width="465" uid="2">
                <table font-size="9" background="#FFFE91" column_width="101" orientation="vertical" interval="1" cleared="true" date_time="1997-07-18T18:46:31Z">
                    <title>Untitled Table</title>
                    <item type="time" color="black" precision="0.01" width="100" />
                    <item color="black" precision="max" delimit_000s="true" index="0">
                        <entity name="Poison_concentration" />
                    </item>
                </table>
            </stacked_container>
            <pad_icon x="336" y="73" width="26" height="22" color="#008F44" label_side="bottom" label="Table 1" type="table" icon_of="2" />
            <style font-family="Arial" font-size="9" />
        </display>
        <interface page_cols="0" page_rows="0" page_width="788" page_height="528" home_page="0">
            <simulation_delay>0.1</simulation_delay>
            <style font-family="Arial" font-size="9" />
        </interface>
        <popup x="16" y="78" content="2" />
        <style font-family="Arial" font-size="9" />
    </model>
