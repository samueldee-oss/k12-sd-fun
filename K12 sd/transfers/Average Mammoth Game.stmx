<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" level="3" xmlns="http://www.systemdynamics.org/XMILE" xmlns:isee="http://iseesystems.com/XMILE">
    <header>
        <smile version="1.0" namespace="std, isee">
            <uses_arrays>1</uses_arrays>
        </smile>
        <name>Average Mammoth Game</name>
        <uuid>14e503ad-7d2d-4211-95e5-800580ae60c2</uuid>
        <vendor>isee systems, inc.</vendor>
        <product version="10.1.2" isee:saved_by_v1="false" lang="en">iThink</product>
    </header>
    <style>
        <model font-family="Arial" font-size="9" />
        <interface font-family="Arial" font-size="12" />
    </style>
    <sim_specs method="Euler" time_units="Years" isee:pause_after_rates="false" isee:instantaneous_flows="false">
        <start>0</start>
        <stop>20</stop>
        <dt>0.25</dt>
        <isee:analyze_mode>false</isee:analyze_mode>
    </sim_specs>
    <dimensions>
        <dim name="Dim_Name_1" size="1" />
    </dimensions>
    <model_units />
    <isee:prefs last_model="true" layer="interface" grid_width="20" grid_height="50" divide_by_zero_alert="true" show_module_prefix="true">
        <isee:window width="985" height="640" />
        <isee:security />
        <isee:print_setup width="576" height="768" />
    </isee:prefs>
    <isee:equation_prefs order_by="sector" />
    <model>
        <stock name="Mammoths">
            <eqn>20</eqn>
            <inflow>Mammoth_births_p_yr</inflow>
            <outflow>Mammoth_deaths_p_yr</outflow>
            <non_negative />
            <display x="282" y="136" color="blue" />
        </stock>
        <flow name="Mammoth_births_p_yr">
            <eqn>Mammoths*birth_fraction</eqn>
            <non_negative />
            <display x="206" y="134" color="blue">
                <pts>
                    <pt x="152" y="134" />
                    <pt x="260" y="134" />
                </pts>
            </display>
        </flow>
        <flow name="Mammoth_deaths_p_yr">
            <eqn>Mammoths*death_fraction</eqn>
            <non_negative />
            <display x="374" y="135" color="blue">
                <pts>
                    <pt x="304" y="135" />
                    <pt x="445" y="135" />
                </pts>
            </display>
        </flow>
        <aux name="birth_fraction">
            <eqn>average_birth_fraction*random_influences_on_births</eqn>
            <display x="166" y="186" color="blue" />
        </aux>
        <aux name="death_fraction">
            <eqn>average_death_fraction*random_influences_on_lifespan</eqn>
            <display x="429" y="213" color="blue" />
        </aux>
        <aux name="random_influences_on_births">
            <doc>Theoretical  binomial distribution:&#x0D;SD=SQRT(p(1-p)/1)</doc>
            <eqn>NORMAL(1,0.37)</eqn>
            <display x="182" y="305" color="blue" />
        </aux>
        <aux name="random_influences_on_lifespan">
            <doc>Theoretical  binomial distribution:&#x0D;SD=SQRT(p(1-p)/1)</doc>
            <eqn>NORMAL(1,0.47)</eqn>
            <display x="355" y="317" color="blue" />
        </aux>
        <aux name="average_birth_fraction">
            <eqn>1/6</eqn>
            <display x="84" y="246" color="blue" />
        </aux>
        <aux name="average_death_fraction">
            <eqn>1/3</eqn>
            <display x="465" y="329" color="blue" />
        </aux>
        <stock name="Mammoths_Average">
            <eqn>20</eqn>
            <inflow>Mammoth_births</inflow>
            <outflow>Mammoths_deaths</outflow>
            <non_negative />
            <display x="294" y="450" color="blue" />
        </stock>
        <flow name="Mammoth_births">
            <eqn>average_birth_fraction*Mammoths_Average</eqn>
            <non_negative />
            <display x="208" y="453" color="blue">
                <pts>
                    <pt x="145" y="453" />
                    <pt x="272" y="453" />
                </pts>
            </display>
        </flow>
        <flow name="Mammoths_deaths">
            <eqn>average_death_fraction*Mammoths_Average</eqn>
            <non_negative />
            <display x="379" y="454" color="blue">
                <pts>
                    <pt x="316" y="454" />
                    <pt x="442" y="454" />
                </pts>
            </display>
        </flow>
        <display page_width="576" page_height="768" page_cols="2" isee:converter_size="medium" interval="DT">
            <connector x="276" y="153" uid="0">
                <from>Mammoths</from>
                <to>Mammoth_births_p_yr</to>
            </connector>
            <connector x="289" y="153" uid="1">
                <from>Mammoths</from>
                <to>Mammoth_deaths_p_yr</to>
            </connector>
            <connector x="91" y="241" uid="2">
                <from>average_birth_fraction</from>
                <to>birth_fraction</to>
            </connector>
            <connector x="177" y="298" uid="3">
                <from>random_influences_on_births</from>
                <to>birth_fraction</to>
            </connector>
            <connector x="171" y="179" uid="4">
                <from>birth_fraction</from>
                <to>Mammoth_births_p_yr</to>
            </connector>
            <connector x="424" y="206" uid="5">
                <from>death_fraction</from>
                <to>Mammoth_deaths_p_yr</to>
            </connector>
            <connector x="362" y="312" uid="6">
                <from>random_influences_on_lifespan</from>
                <to>death_fraction</to>
            </connector>
            <connector x="462" y="320" uid="7">
                <from>average_death_fraction</from>
                <to>death_fraction</to>
            </connector>
            <connector x="83" y="255" uid="8">
                <from>average_birth_fraction</from>
                <to>Mammoth_births</to>
            </connector>
            <connector x="464" y="338" uid="9">
                <from>average_death_fraction</from>
                <to>Mammoths_deaths</to>
            </connector>
            <connector x="275" y="433" uid="10">
                <from>Mammoths_Average</from>
                <to>Mammoth_births</to>
            </connector>
            <connector x="315" y="433" uid="11">
                <from>Mammoths_Average</from>
                <to>Mammoths_deaths</to>
            </connector>
            <stacked_container height="514" width="896" uid="12">
                <graph type="time_series" title="Discrete Approach" background="#C8C8C8" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-04T09:22:15Z" comparative="true" cleared="true" time_precision="2" from="0" to="20">
                    <plot index="0" pen_width="3" color="blue" precision="1" show_y_axis="true">
                        <scale min="0" max="200" />
                        <entity name="Mammoths" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="155" y="28" width="26" height="22" color="#0CA0FF" label_side="bottom" label="Graph 1" type="graph" icon_of="12" />
            <stacked_container height="286" width="465" uid="13">
                <table font-size="9" background="#FFFE91" column_width="60" orientation="vertical" interval="0.25" cleared="true" date_time="2012-06-13T11:26:30Z">
                    <title>Untitled Table</title>
                    <item type="time" color="black" width="100" />
                    <item color="black" precision="0.01" delimit_000s="true" index="0">
                        <entity name="birth_fraction" />
                    </item>
                    <item color="black" precision="0.01" delimit_000s="true" index="1">
                        <entity name="death_fraction" />
                    </item>
                    <item color="black" precision="0.01" delimit_000s="true" index="2">
                        <entity name="Mammoth_births_p_yr" />
                    </item>
                    <item color="black" precision="0.01" delimit_000s="true" index="3">
                        <entity name="Mammoth_deaths_p_yr" />
                    </item>
                </table>
            </stacked_container>
            <pad_icon x="105" y="29" width="26" height="22" color="#008F44" label_side="bottom" label="Table 1" type="table" icon_of="13" />
            <style font-family="Arial" font-size="9" />
        </display>
        <interface show_pages="true" page_cols="2" page_rows="2" page_width="1012" page_height="696" scroll_y="696" home_page="3">
            <simulation_delay>0</simulation_delay>
            <stacked_container x="32" y="113" height="282" width="492" uid="14">
                <graph type="time_series" title="Mammoth Games" background="#FFFFC9" show_grid="true" plot_numbers="true" isee:use_five_segments="false" hide_detail="true" comparative="true" cleared="true" time_precision="0" from="0" to="20">
                    <plot index="0" pen_width="1" color="blue" precision="1" show_y_axis="true">
                        <scale min="0" max="40" />
                        <entity name="Mammoths" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="265" y="245" width="26" height="22" color="#0CA0FF" label_side="bottom" label="Graph 1" type="graph" icon_of="14" />
            <stacked_container x="1069" y="40" height="276" width="481" uid="15">
                <graph type="time_series" title="Mammoth Game Average" background="#FFFFC9" show_grid="true" plot_numbers="true" isee:use_five_segments="false" hide_detail="true" cleared="true" time_precision="2" from="0" to="20">
                    <plot index="0" pen_width="3" color="red" precision="1" show_y_axis="true">
                        <scale min="0" max="40" />
                        <entity name="Mammoths_Average" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="976" y="173" width="26" height="22" color="#0CA0FF" label_side="bottom" label="Graph 2" type="graph" icon_of="15" />
            <slider x="128" y="455" color="#30CB32" width="197" height="43" min="0" max="0.5" precision="0.01">
                <entity name="average_birth_fraction" value="0.3" />
            </slider>
            <slider x="131" y="530" color="red" width="197" height="43" min="0" max="0.5" precision="0.01">
                <entity name="average_death_fraction" />
            </slider>
            <button x="279" y="511" width="92" height="47" uid="16" appearance="opaque" background="black" color="white" style="rounded" label="Restore Graphs " font-family="Arial" font-size="12" text-align="center">
                <menu_action>restore_graphs_tables</menu_action>
            </button>
            <text_box x="87" y="33" uid="17" color="#7F00FF" font-family="Arial" font-size="12" padding="5" border-style="solid" border-width="thin" width="441" height="58">Set the sliders and run the model a few times. Try to predict what would happen if you would run the model many times. Then check the average to see the result.</text_box>
            <button x="274" y="431" width="88" height="47" uid="18" appearance="opaque" background="black" color="white" style="rounded" label="Run" font-family="Arial" font-size="12" text-align="center">
                <menu_action>run</menu_action>
            </button>
            <button x="413" y="425" width="112" height="51" uid="19" appearance="opaque" background="#FFFFC9" color="white" style="rounded" label="See average of all graphs" font-family="Arial" font-size="12" text-align="center">
                <link target="next_page" />
            </button>
            <button x="1188" y="379" width="104" height="49" uid="20" appearance="opaque" background="black" color="white" style="rounded" label="View sliders and graphs" font-family="Arial" font-size="12" text-align="center">
                <link target="interface" x="0" y="0" />
            </button>
            <button x="457" y="499" width="55" height="55" uid="21" appearance="opaque" background="black" color="white" style="square" icon="5">
                <link target="home_page" isee:default_icon="true" />
            </button>
            <text_box x="179" y="744" uid="22" color="#7F00FF" font-family="Arial" font-size="12" padding="5" border-style="solid" border-width="thin" width="383" height="260">FINDING THE AVERAGE OUTCOME&#x0D;&#x0D;Rolling dice in the Mammoth Game, and programming a computer to produce random numbers, both add a random aspect to the simulation of the life of the herd.  Playing the game twice, or running two or three computer simulations can result in very different results.  What happens when you play the game many times?&#x0D;&#x0D;Use this simulation to test your hypothesis.  Set the sliders and run the simulation as many times as you want.  Then click the button to view a graph of the average population under those rules.  How does your graph of many games compare to the graph of a mathematical average?</text_box>
            <button x="302" y="1040" width="172" height="33" uid="23" appearance="opaque" background="black" color="white" style="square" label="Try the simulation" font-family="Arial" font-size="12" text-align="center">
                <link target="interface" x="0" y="0" />
            </button>
            <style font-family="Arial" font-size="12" />
        </interface>
        <popup x="57" y="117" content="12" />
        <popup x="13" y="97" content="13" />
        <style font-family="Arial" font-size="9" />
    </model>
</xmile>
