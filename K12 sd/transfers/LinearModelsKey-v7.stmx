<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" level="3" xmlns="http://www.systemdynamics.org/XMILE" xmlns:isee="http://iseesystems.com/XMILE">
    <header>
        <smile version="1.0" namespace="std, isee">
            <uses_arrays>1</uses_arrays>
        </smile>
        <name>LinearModelsKey-v7</name>
        <uuid>09cfb898-c17f-4dfd-af2a-0aa5f4a04e40</uuid>
        <vendor>isee systems, inc.</vendor>
        <product version="10.1.2" isee:saved_by_v1="false" lang="en">iThink</product>
    </header>
    <style>
        <model font-family="Arial" font-size="9" />
        <interface font-family="Arial" font-size="9" />
    </style>
    <sim_specs method="Euler" time_units="Seconds" isee:pause_after_rates="false" isee:instantaneous_flows="false">
        <start>0</start>
        <stop>100</stop>
        <dt>1</dt>
        <isee:analyze_mode>false</isee:analyze_mode>
    </sim_specs>
    <dimensions>
        <dim name="Dim_Name_1" size="1" />
    </dimensions>
    <model_units />
    <isee:prefs last_model="true" layer="model" grid_width="20" grid_height="50" divide_by_zero_alert="true" link_high_level_map="true" show_module_prefix="true">
        <isee:window width="754" height="466" />
        <isee:security />
        <isee:print_setup width="595" height="744" />
    </isee:prefs>
    <isee:equation_prefs order_by="sector" />
    <model>
        <stock name="AUTO_VALUE">
            <eqn>15000&#x0D;{Dollars}</eqn>
            <outflow>Value_Loss_per_Month</outflow>
            <non_negative />
            <display x="59" y="153" color="blue" />
        </stock>
        <flow name="Value_Loss_per_Month">
            <eqn>175&#x0D;{Dollars per month depreciation rate}</eqn>
            <non_negative />
            <display x="140" y="150" color="blue">
                <pts>
                    <pt x="79" y="150" />
                    <pt x="202" y="150" />
                </pts>
            </display>
        </flow>
        <stock name="DISTANCE_ABOVE_GROUND">
            <eqn>4500&#x0D;{This is the height from which you jump; almost a mile up!}</eqn>
            <outflow>Meters_per_Sec_Terminal_Velocity</outflow>
            <non_negative />
            <display x="82" y="374" color="blue" />
        </stock>
        <flow name="Meters_per_Sec_Terminal_Velocity">
            <eqn>60&#x0D;{Meters per second; this assumes you reach terminal velocity the instant you leave the plane.  That&apos;s not especially realistic/accurate but not a bad approximation for an introductory model}</eqn>
            <non_negative />
            <display x="173" y="381" color="blue">
                <pts>
                    <pt x="102" y="381" />
                    <pt x="244" y="381" />
                </pts>
            </display>
        </flow>
        <display page_width="595" page_height="744" isee:converter_size="large" interval="DT">
            <stacked_container x="69" y="454" height="267" width="471" visible_index="1" uid="0">
                <graph type="time_series" title="Untitled" background="#FFFFC9" show_grid="true" plot_numbers="true" isee:use_five_segments="true" date_time="2025-02-04T09:49:45Z" cleared="true" time_precision="2" from="0" to="100">
                    <plot index="0" pen_width="1" color="red" precision="1" show_y_axis="true">
                        <entity name="DISTANCE_ABOVE_GROUND" />
                    </plot>
                </graph>
                <graph type="time_series" title="Untitled" background="#C9FFFF" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-04T09:49:45Z" cleared="true" time_precision="2" from="20" to="30">
                    <plot index="0" pen_width="1" color="red" precision="1" show_y_axis="true">
                        <scale min="2500" max="3500" />
                        <entity name="DISTANCE_ABOVE_GROUND" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="321" y="505" width="26" height="22" color="fuchsia" label_side="bottom" label="Graph 1" type="graph" icon_of="0" />
            <stacked_container x="241" y="104" height="183" width="215" uid="1">
                <table font-size="9" background="#FFFFC9" column_width="72" orientation="vertical" interval="1" cleared="true" date_time="2002-01-02T20:58:39Z">
                    <title>Table.TXT</title>
                    <item type="time" color="black" width="71" />
                    <item color="black" precision="1" delimit_000s="true" index="0">
                        <entity name="AUTO_VALUE" />
                    </item>
                </table>
            </stacked_container>
            <pad_icon x="274" y="178" width="26" height="22" color="#008F44" label_side="bottom" label="Table 1" type="table" icon_of="1" />
            <text_box x="112" y="7" uid="2" color="#7F00FF" font-family="Arial" font-size="14" font-weight="bold" text-align="center" padding="5" width="314" height="78">LINEAR MODELS IN STELLA II&#x0D;Fisher and Rogers, 1992&#x0D;Answer Key for Word Problems</text_box>
            <text_box x="16" y="82" uid="3" color="#FF7F00" font-family="Arial" font-size="14" font-weight="bold" text-align="center" padding="5" width="124" height="27">Auto Problem</text_box>
            <text_box x="12" y="298" uid="4" color="#FF7F00" font-family="Arial" font-size="14" font-weight="bold" text-align="center" padding="5" width="146" height="27">Freefall Problem</text_box>
            <style font-family="Arial" font-size="9" />
        </display>
        <interface page_cols="0" page_rows="0" page_width="1588" page_height="1128" home_page="0">
            <simulation_delay>0</simulation_delay>
            <style font-family="Arial" font-size="9" />
        </interface>
        <style font-family="Arial" font-size="9" />
    </model>
</xmile>
