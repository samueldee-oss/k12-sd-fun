            </connector>
            <connector x="497" y="852" uid="18" color="red">
                <from>weekly_movie_expenses</from>
                <to>Weekly_Expense_$</to>
            </connector>
            <connector x="592" y="915" uid="19" color="red">
                <from>weekly_music_expenses</from>
                <to>Weekly_Expense_$</to>
            </connector>
