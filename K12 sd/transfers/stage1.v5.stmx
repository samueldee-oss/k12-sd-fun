<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" level="3" xmlns="http://www.systemdynamics.org/XMILE" xmlns:isee="http://iseesystems.com/XMILE">
    <header>
        <smile version="1.0" namespace="std, isee">
            <uses_arrays>1</uses_arrays>
        </smile>
        <name>stage1.v5</name>
        <uuid>4c3002e6-36aa-4fb8-88ee-fbc801a49bd1</uuid>
        <vendor>isee systems, inc.</vendor>
        <product version="10.1.2" isee:saved_by_v1="false" lang="en">iThink</product>
    </header>
    <style>
        <model font-family="Arial" font-size="9" />
        <interface font-family="Arial" font-size="9" />
    </style>
    <sim_specs method="Euler" time_units="Time" isee:pause_after_rates="false" isee:instantaneous_flows="false">
        <start>0</start>
        <stop>5</stop>
        <dt>0.005</dt>
        <isee:analyze_mode>false</isee:analyze_mode>
    </sim_specs>
    <dimensions>
        <dim name="Dim_Name_1" size="1" />
    </dimensions>
    <model_units />
    <isee:prefs last_model="true" layer="model" grid_width="20" grid_height="50" divide_by_zero_alert="true" link_high_level_map="true" show_module_prefix="true">
        <isee:window width="630" height="428" />
        <isee:security />
        <isee:print_setup width="576" height="756" />
    </isee:prefs>
    <isee:equation_prefs order_by="sector" />
    <model>
        <stock name="Displacement">
            <doc>0</doc>
            <eqn>0</eqn>
            <scale min="0" max="35" />
            <inflow>Veloc</inflow>
            <display x="215" y="47" color="blue">
                <scale min="0" max="35" />
            </display>
        </stock>
        <flow name="Veloc">
            <eqn>Velocity</eqn>
            <scale min="-30" max="30" />
            <display x="132" y="43" color="blue">
                <scale min="-30" max="30" />
                <pts>
                    <pt x="69" y="43" />
                    <pt x="195" y="43" />
                </pts>
            </display>
        </flow>
        <stock name="Velocity">
            <eqn>0</eqn>
            <inflow>Acceleration</inflow>
            <display x="213" y="111" color="blue" />
        </stock>
        <flow name="Acceleration">
            <eqn>Gravity_acceleration+Thrust_acceleration</eqn>
            <display x="132" y="110" color="blue">
                <pts>
                    <pt x="71" y="110" />
                    <pt x="193" y="110" />
                </pts>
            </display>
        </flow>
        <aux name="Thrust_acceleration">
            <eqn>TIME</eqn>
            <gf>
                <xscale min="0" max="2" />
                <yscale min="0" max="50" />
                <ypts>50,35.5,29.75,26.5,0,0,0,0,0,0,0,0,0</ypts>
            </gf>
            <display x="65" y="165" color="blue" />
        </aux>
        <aux name="Gravity_acceleration">
            <eqn>-10</eqn>
            <display x="138" y="186" color="blue" />
        </aux>
        <display page_width="576" page_height="756" isee:converter_size="large" interval="DT">
            <connector x="191" y="97" uid="0">
                <from>Velocity</from>
                <to>Veloc</to>
            </connector>
            <connector x="70" y="154" uid="1">
                <from>Thrust_acceleration</from>
                <to>Acceleration</to>
            </connector>
            <connector x="137" y="174" uid="2">
                <from>Gravity_acceleration</from>
                <to>Acceleration</to>
            </connector>
            <stacked_container height="282" width="492" uid="3">
                <graph type="time_series" title="1: Rocket with Thrust" background="#C8C8C8" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-04T10:14:15Z" cleared="true" time_precision="2" from="0" to="5">
                    <plot index="0" pen_width="1" color="red" precision="0.01" show_y_axis="true">
                        <scale min="0" max="20" />
                        <entity name="Displacement" />
                    </plot>
                    <plot index="1" pen_width="1" color="#008F44" precision="0.01" show_y_axis="true">
                        <scale min="-20" max="20" />
                        <entity name="Veloc" />
                    </plot>
                    <plot index="2" pen_width="1" color="fuchsia" precision="0.01" show_y_axis="true">
                        <entity name="Acceleration" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="308" y="104" width="26" height="22" color="fuchsia" label_side="bottom" label="Graph 1" type="graph" icon_of="3" />
            <style font-family="Arial" font-size="9" />
        </display>
        <interface page_cols="0" page_rows="0" page_width="640" page_height="480" home_page="0">
            <simulation_delay>0</simulation_delay>
            <style font-family="Arial" font-size="9" />
        </interface>
        <popup x="13" y="112" visible="true" content="3" />
        <style font-family="Arial" font-size="9" />
    </model>
</xmile>
