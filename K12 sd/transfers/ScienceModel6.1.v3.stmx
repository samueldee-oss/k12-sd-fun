    <model>
        <stock name="Distance_Left">
            <eqn>200</eqn>
            <outflow>Distance_Moving</outflow>
            <non_negative />
            <display x="102" y="58" color="blue" />
        </stock>
        <flow name="Distance_Moving">
            <eqn>Distance_Left*Size_of_Step</eqn>
            <non_negative />
            <display x="188" y="55" color="blue" label_side="top">
                <pts>
                    <pt x="122" y="55" />
                    <pt x="255" y="55" />
                </pts>
            </display>
        </flow>
        <aux name="Size_of_Step">
            <eqn>.5</eqn>
            <display x="232" y="116" color="blue" />
        </aux>
        <display page_width="595" page_height="775" isee:converter_size="medium" interval="DT">
            <connector x="228" y="108" uid="0">
                <from>Size_of_Step</from>
                <to>Distance_Moving</to>
            </connector>
            <connector x="124" y="61" uid="1">
