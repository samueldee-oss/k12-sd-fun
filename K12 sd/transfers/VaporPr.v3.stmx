                        <entity name="Total_Pressure" />
                    </item>
                </table>
            </stacked_container>
            <pad_icon x="95" y="286" width="26" height="22" color="#008F44" label_side="bottom" label="Table 1" type="table" icon_of="13" />
            <style font-family="Arial" font-size="9" />
        </display>
        <interface page_width="788" page_height="528">
            <simulation_delay>0.1</simulation_delay>
            <isee:process_frame x="33" y="95" width="155" height="75" name="Pause_Sector" show_name="false" color="#0CA0FF" border-style="solid" border-width="thin" />
            <isee:process_frame x="35" y="212" width="155" height="75" name="Vapor_Pressure_Sector" show_name="false" color="#0CA0FF" border-style="solid" border-width="thin" />
            <style font-family="Arial" font-size="9" />
        </interface>
        <popup x="16" y="78" content="7" />
