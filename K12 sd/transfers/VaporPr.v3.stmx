                        <entity name="Evaporation_Rate" />
                    </item>
                    <item color="black" header-text-align="center" precision="max" display_as="number" index="1">
                        <entity name="Condensation_Rate" />
                    </item>
                    <item color="black" header-text-align="center" precision="max" display_as="number" index="2">
                        <entity name="Moles_of_Water_Vapor" />
                    </item>
                    <item color="black" header-text-align="center" precision="0.01" display_as="number" index="3">
                        <entity name="Standard_Vapor_Pressure" />
                    </item>
                    <item color="black" header-text-align="center" precision="0.01" display_as="number" index="4">
                        <entity name="Actual_Vapor_Pressure" />
                    </item>
                    <item color="black" header-text-align="center" precision="0.01" display_as="number" index="5">
                        <entity name="Hydrogen_Pressure" />
