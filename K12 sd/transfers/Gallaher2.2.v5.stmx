<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" level="3" xmlns="http://www.systemdynamics.org/XMILE" xmlns:isee="http://iseesystems.com/XMILE">
    <header>
        <smile version="1.0" namespace="std, isee">
            <uses_arrays>1</uses_arrays>
        </smile>
        <name>Gallaher2.2.v5</name>
        <uuid>9d495c8b-06fe-4584-b146-3573ff76b380</uuid>
        <vendor>isee systems, inc.</vendor>
        <product version="10.1.2" isee:saved_by_v1="false" lang="en">iThink</product>
    </header>
    <style>
        <model font-family="Arial" font-size="9" />
        <interface font-family="Arial" font-size="9" />
    </style>
    <sim_specs method="Euler" time_units="Minutes" isee:pause_after_rates="false" isee:instantaneous_flows="false">
        <start>0</start>
        <stop>80</stop>
        <dt>0.5</dt>
        <isee:analyze_mode>false</isee:analyze_mode>
    </sim_specs>
    <dimensions>
        <dim name="Dim_Name_1" size="1" />
    </dimensions>
    <model_units />
    <isee:prefs last_model="true" layer="model" grid_width="20" grid_height="50" divide_by_zero_alert="true" link_high_level_map="true" show_module_prefix="true">
        <isee:window width="817" height="572" />
        <isee:security />
        <isee:print_setup width="552" height="728" />
    </isee:prefs>
    <isee:equation_prefs order_by="sector" />
    <model>
        <stock name="Water_Volume">
            <eqn>40</eqn>
            <outflow>Output</outflow>
            <non_negative />
            <display x="66" y="46" color="black" />
        </stock>
        <flow name="Output">
            <eqn>Water_Volume*Drain</eqn>
            <non_negative />
            <display x="135" y="44" color="black">
                <pts>
                    <pt x="86" y="44" />
                    <pt x="184" y="44" />
                </pts>
            </display>
        </flow>
        <aux name="Drain">
            <eqn>.1</eqn>
            <display x="170" y="108" color="blue" />
        </aux>
        <display page_width="552" page_height="728" isee:converter_size="large" interval="DT">
            <connector x="171" y="96" uid="0">
                <from>Drain</from>
                <to>Output</to>
            </connector>
            <connector x="88" y="51" uid="1">
                <from>Water_Volume</from>
                <to>Output</to>
            </connector>
            <stacked_container height="282" width="492" uid="2">
                <graph type="time_series" title="Water Volume vs Time" background="#C8C8C8" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-04T09:40:18Z" cleared="true" time_precision="2" from="0" to="80">
                    <plot index="0" pen_width="1" color="red" precision="0.01" show_y_axis="true">
                        <scale min="0" max="60" />
                        <entity name="Water_Volume" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="318" y="44" width="26" height="22" color="black" label_side="bottom" label="Graph of Water Volume vs Time" type="graph" icon_of="2" />
            <stacked_container height="286" width="465" uid="3">
                <table font-size="9" background="#FFFE91" column_width="60" orientation="vertical" interval="0.5" cleared="true" date_time="1997-07-04T08:19:51Z">
                    <title>Untitled Table</title>
                    <item type="time" color="black" width="100" />
                    <item color="black" precision="0.01" delimit_000s="true" index="0">
                        <entity name="Water_Volume" />
                    </item>
                </table>
            </stacked_container>
            <pad_icon x="323" y="116" width="26" height="22" color="black" label_side="bottom" label="Table of Water Volume vs Time" type="table" icon_of="3" />
            <style font-family="Arial" font-size="9" />
        </display>
        <interface page_cols="0" page_rows="0" page_width="640" page_height="480" home_page="0">
            <simulation_delay>0</simulation_delay>
            <style font-family="Arial" font-size="9" />
        </interface>
        <popup x="8" y="51" content="2" />
        <popup x="8" y="51" content="3" />
        <style font-family="Arial" font-size="9" />
    </model>
</xmile>
