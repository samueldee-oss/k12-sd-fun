                <graph type="time_series" title="SHIPS" background="#C8C8C8" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-07T15:39:59Z" cleared="true" time_precision="0" from="1970" to="1986">
                    <plot index="0" pen_width="1" color="red" precision="1" show_y_axis="true">
