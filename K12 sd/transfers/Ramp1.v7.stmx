<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" level="3" xmlns="http://www.systemdynamics.org/XMILE" xmlns:isee="http://iseesystems.com/XMILE">
    <header>
        <smile version="1.0" namespace="std, isee">
            <uses_arrays>1</uses_arrays>
        </smile>
        <name>Ramp1.v7</name>
        <uuid>33349517-4e39-4e38-858c-8a93b60c3f1a</uuid>
        <vendor>isee systems, inc.</vendor>
        <product version="10.1.2" isee:saved_by_v1="false" lang="en">iThink</product>
    </header>
    <style>
        <model font-family="Arial" font-size="9" />
        <interface font-family="Arial" font-size="9" />
    </style>
    <sim_specs method="Euler" time_units="Time" isee:pause_after_rates="false" isee:instantaneous_flows="false">
        <start>0</start>
        <stop>12</stop>
        <dt>0.25</dt>
        <isee:analyze_mode>false</isee:analyze_mode>
    </sim_specs>
    <dimensions>
        <dim name="Dim_Name_1" size="1" />
    </dimensions>
    <model_units />
    <isee:prefs last_model="true" layer="model" grid_width="20" grid_height="50" divide_by_zero_alert="true" link_high_level_map="true" show_module_prefix="true">
        <isee:window width="1334" height="630" />
        <isee:security />
        <isee:print_setup width="583" height="763" />
    </isee:prefs>
    <isee:equation_prefs order_by="sector" />
    <model>
        <stock name="Velocity">
            <eqn>0</eqn>
            <inflow>Acceleration</inflow>
            <non_negative />
            <display x="258" y="101" color="blue" />
        </stock>
        <flow name="Acceleration">
            <eqn>Gravity*SIN(Ramp_angle)</eqn>
            <display x="194" y="98" color="blue">
                <pts>
                    <pt x="150" y="98" />
                    <pt x="238" y="98" />
                </pts>
            </display>
        </flow>
        <aux name="Ramp_angle">
            <eqn>PI/6</eqn>
            <display x="157" y="183" color="blue" />
        </aux>
        <aux name="Gravity">
            <eqn>9.8</eqn>
            <display x="258" y="167" color="blue" />
        </aux>
        <display page_width="583" page_height="763" isee:converter_size="large" interval="DT">
            <connector x="158" y="171" uid="0">
                <from>Ramp_angle</from>
                <to>Acceleration</to>
            </connector>
            <connector x="246" y="163" uid="1">
                <from>Gravity</from>
                <to>Acceleration</to>
            </connector>
            <stacked_container height="282" width="492" uid="2">
                <graph type="time_series" title="Untitled Graph" background="#C8C8C8" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-04T10:04:50Z" cleared="true" time_precision="2" from="0" to="12">
                    <plot index="0" pen_width="1" color="red" precision="0.01" show_y_axis="true">
                        <entity name="Velocity" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="457" y="98" width="26" height="22" color="#0CA0FF" label_side="bottom" label="Graph 1" type="graph" icon_of="2" />
            <style font-family="Arial" font-size="9" />
        </display>
        <interface page_cols="0" page_rows="0" page_width="1588" page_height="1128" home_page="0">
            <simulation_delay>0</simulation_delay>
            <style font-family="Arial" font-size="9" />
        </interface>
        <popup x="13" y="112" visible="true" content="2" />
        <style font-family="Arial" font-size="9" />
    </model>
</xmile>
