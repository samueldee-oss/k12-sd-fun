<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" level="3" xmlns="http://www.systemdynamics.org/XMILE" xmlns:isee="http://iseesystems.com/XMILE">
    <header>
        <smile version="1.0" namespace="std, isee">
            <uses_arrays>1</uses_arrays>
        </smile>
        <name>Galaxy.v5</name>
        <uuid>e9079654-12fa-4db4-8afe-71934b090327</uuid>
        <vendor>isee systems, inc.</vendor>
        <product version="10.1.2" isee:saved_by_v1="false" lang="en">iThink</product>
    </header>
    <style>
        <model font-family="Arial" font-size="9" />
        <interface font-family="Arial" font-size="9" />
    </style>
    <sim_specs method="Euler" time_units="100 Million Years" isee:pause_after_rates="false" isee:instantaneous_flows="false">
        <start>0</start>
        <stop>250</stop>
        <dt>1</dt>
        <isee:analyze_mode>false</isee:analyze_mode>
    </sim_specs>
    <dimensions>
        <dim name="Dim_Name_1" size="1" />
    </dimensions>
    <model_units />
    <isee:prefs last_model="true" layer="model" grid_width="20" grid_height="50" divide_by_zero_alert="true" link_high_level_map="true" show_module_prefix="true">
        <isee:window width="817" height="572" />
        <isee:security />
        <isee:print_setup width="365" height="276" />
    </isee:prefs>
    <isee:equation_prefs order_by="sector" show_documentation="true" />
    <model>
        <stock name="Nebula_Matter">
            <doc>This is the amount of Mass that is currently in the form of nebuli</doc>
            <eqn>1000000000000 {Solar Masses}</eqn>
            <inflow>Nebula_Matter_from_Supernovas</inflow>
            <outflow>Creation_of_Big_Stars</outflow>
            <outflow>Creation_of_Small_Stars</outflow>
            <display x="45" y="165" color="black" label_side="right" label_angle="26" />
        </stock>
        <stock name="Matter_in_Big_Stars">
            <doc>This is the amount of matter in big stars.</doc>
            <eqn>0 {Big Stars}</eqn>
            <inflow>Creation_of_Big_Stars</inflow>
            <outflow>Star_Matter_from_Supernovas</outflow>
            <outflow>Nebula_Matter_from_Supernovas</outflow>
            <display x="321" y="162" color="black" label_angle="68" />
        </stock>
        <aux name="Formation_Rate_of_Big_Stars">
            <doc>This is the percent of nebulae matter that turns into Big Stars every 100 million years</doc>
            <eqn>.1 {no units}</eqn>
            <display x="266" y="231" color="black" label_side="top" label_angle="55" />
        </aux>
        <stock name="Matter_in_WD_&amp;_NS_&amp;_BH">
            <doc>This is the total amout of matter in white dwarves, neutron stars and black holes from when the big stars go supernova.</doc>
            <eqn>0 {NS&amp;BH}</eqn>
            <inflow>Star_Matter_from_Supernovas</inflow>
            <inflow>Collapses_of_Small_Stars</inflow>
            <display x="577" y="158" color="black" label_angle="117" />
        </stock>
        <aux name="Fraction_that_goes_to_Nebulas">
            <doc>Fraction of matter that does not go into the remaining core of a star that goes supernova.</doc>
            <eqn>.825 {no units}</eqn>
            <display x="78" y="68" color="black" label_side="right" label_angle="13" />
        </aux>
        <aux name="Volume">
            <doc>This is the volume of the galaxy, based on the Milky Way Galaxy.</doc>
            <eqn>31420000000000 {cubic lightyears}</eqn>
            <display x="308" y="362" color="black" label_angle="257" />
        </aux>
        <stock name="Nebula_Matter_2">
            <doc>This is the amount of Mass that is currently in the form of nebuli</doc>
            <eqn>1000000000000 {Solar Masses}</eqn>
            <inflow>Nebula_Matter_from_Supernovas_2</inflow>
            <outflow>Creation_of_Big_Stars_2</outflow>
            <display x="39" y="598" color="white" label_side="right" label_angle="26" />
        </stock>
        <aux name="Fraction_that_goes_to_WD_NS_and_BH">
            <doc>This is the fraction of a Big Star that collapses into the core when it goes supernova.</doc>
            <eqn>.175 {no units}</eqn>
            <display x="502" y="246" color="black" label_side="top" label_angle="109" />
        </aux>
        <flow name="Creation_of_Big_Stars">
            <doc>This is the amount of Nebuela matter that is forming into Big Stars.</doc>
            <eqn>(Nebula_Matter*Percentage_of_Nebula_Matter_that_Forms_Stars)*Density_Effect_on_Creation_of_Stars*Formation_Rate_of_Big_Stars {Solar Masses}</eqn>
            <non_negative />
            <display x="183" y="163" color="black" label_angle="202">
                <pts>
                    <pt x="65" y="163" />
                    <pt x="301" y="163" />
                </pts>
            </display>
        </flow>
        <flow name="Star_Matter_from_Supernovas">
            <doc>This is the matter from big stars that becomes White Dwarves, Neutron Stars, and eventually Black Holes</doc>
            <eqn>Collapse_of_Big_Stars*Fraction_that_goes_to_WD_NS_and_BH {Solar Masses}</eqn>
            <non_negative />
            <display x="449" y="164" color="black" label_side="top" label_angle="127">
                <pts>
                    <pt x="341" y="164" />
                    <pt x="557" y="164" />
                </pts>
            </display>
        </flow>
        <stock name="Matter_in_Big_Stars_2">
            <doc>This is the amount of matter in big stars.</doc>
            <eqn>0 {Big Stars}</eqn>
            <inflow>Creation_of_Big_Stars_2</inflow>
            <outflow>Star_Matter_from_Supernovas_2</outflow>
            <outflow>Nebula_Matter_from_Supernovas_2</outflow>
            <display x="315" y="595" color="black" label_angle="68" />
        </stock>
        <aux name="Average_Lifespan_of_Big_Stars">
            <doc>This is the average for how long a Big Star will last until it goes supernova if unaffected by other factors</doc>
            <eqn>5 {100 million  years}</eqn>
            <display x="529" y="282" color="black" label_angle="198" />
        </aux>
        <aux name="Formation_Rate_of_Big_Stars_2">
            <doc>This is the percent of nebulae matter that turns into Big Stars every 100 million years</doc>
            <eqn>.1 {no units}</eqn>
            <display x="270" y="658" color="black" label_side="top" label_angle="55" />
        </aux>
        <aux name="Nebula_Density">
            <doc>This is how dense the nebulae matter is.</doc>
            <eqn>Nebula_Matter/Volume {no units}</eqn>
            <display x="144" y="332" color="black" label_angle="257" />
        </aux>
        <aux name="Density_Effect_on_Creation_of_Stars">
            <doc>This is how the density of the nebulae matter affects the creation of stars.</doc>
            <eqn>Nebula_Density {no units}</eqn>
            <gf>
                <xscale min="0" max="1" />
                <yscale min="0.1" max="1.5" />
                <ypts>0.10000000000000001,0.121,0.17699999999999999,0.23999999999999999,0.30299999999999999,0.42899999999999999,0.58999999999999997,0.7649999999999999,1.024,1.2829999999999999,1.4999999999999998</ypts>
            </gf>
            <display x="290" y="297" color="black" label_angle="203" />
        </aux>
        <aux name="Percentage_of_Nebula_Matter_that_Forms_Stars">
            <doc>This is the percent of the Nebula Matter that is turning into star matter at any given time</doc>
            <eqn>.07 {no units}</eqn>
            <display x="163" y="243" color="black" label_angle="320" />
        </aux>
        <flow name="Collapses_of_Small_Stars">
            <doc>This is the rate thet small stars collapses into white dwarfs.</doc>
            <eqn>Matter_in_Small_Stars*Fraction_of_small_stars_that_die</eqn>
            <non_negative />
            <display x="321" y="405" color="black" label_side="left" label_angle="212">
                <pts>
                    <pt x="65" y="405" />
                    <pt x="578" y="405" />
                    <pt x="578" y="173" />
                </pts>
            </display>
        </flow>
        <stock name="Matter_in_Small_Stars">
            <doc>This is the amount of small stars.</doc>
            <eqn>0 {Small Stars}</eqn>
            <inflow>Creation_of_Small_Stars</inflow>
            <outflow>Collapses_of_Small_Stars</outflow>
            <display x="45" y="407" color="black" label_side="bottom" label_angle="310" />
        </stock>
        <aux name="Collapse_of_Big_Stars">
            <doc>This is how many Big Stars collapse every 100 million years</doc>
            <eqn>(Matter_in_Big_Stars/Average_Lifespan_of_Big_Stars) {no units}</eqn>
            <display x="459" y="262" color="black" label_angle="267" />
        </aux>
        <aux name="Formation_Rate_of_Small_stars">
            <doc>This is the percent of nebulae matter that forms small stars every 100 millions years.</doc>
            <eqn>.9 {no units}</eqn>
            <display x="91" y="375" color="black" label_side="right" />
        </aux>
        <flow name="Creation_of_Small_Stars">
            <doc>This is the creation rate of small stars.</doc>
            <eqn>(Nebula_Matter*Percentage_of_Nebula_Matter_that_Forms_Stars)*Density_Effect_on_Creation_of_Stars*Formation_Rate_of_Small_stars {Solar Masses}</eqn>
            <non_negative />
            <display x="49" y="286" color="black">
                <pts>
                    <pt x="49" y="180" />
                    <pt x="49" y="392" />
                </pts>
            </display>
        </flow>
        <aux name="Fraction_of_small_stars_that_die">
            <doc>This is the average lifespan of small stars.</doc>
            <eqn>time {100 million years}</eqn>
            <gf>
                <xscale min="0" max="250" />
                <yscale min="0" max="0.005" />
                <ypts>2.5000000000000001e-005,0.000175,0.00050000000000000001,0.001,0.0018750000000000001,0.0037500000000000003,0.0048000000000000004,0.0050000000000000001,0.0050000000000000001,0.0050000000000000001,0.0050000000000000001</ypts>
            </gf>
            <display x="424" y="384" color="black" label_side="top" label_angle="26" />
        </aux>
        <flow name="Nebula_Matter_from_Supernovas">
            <doc>This is the amount of matter that goes back to nebula matter when big stars go supernova.</doc>
            <eqn>Collapse_of_Big_Stars*Fraction_that_goes_to_Nebulas {solar masses}</eqn>
            <non_negative />
            <display x="157" y="89" color="black" label_angle="322">
                <pts>
                    <pt x="301" y="151" />
                    <pt x="261" y="151" />
                    <pt x="261" y="89" />
                    <pt x="54" y="89" />
                    <pt x="54" y="150" />
                </pts>
            </display>
        </flow>
