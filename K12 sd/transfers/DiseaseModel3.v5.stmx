<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" level="3" xmlns="http://www.systemdynamics.org/XMILE" xmlns:isee="http://iseesystems.com/XMILE">
    <header>
        <smile version="1.0" namespace="std, isee">
            <uses_arrays>1</uses_arrays>
            <uses_conveyor />
        </smile>
        <name>DiseaseModel3.v5</name>
        <uuid>233e6daa-1818-41e3-9988-fd9e8698cc38</uuid>
        <vendor>isee systems, inc.</vendor>
        <product version="10.1.2" isee:saved_by_v1="false" lang="en">iThink</product>
    </header>
    <style>
        <model font-family="Arial" font-size="9" />
        <interface font-family="Arial" font-size="9" />
    </style>
    <sim_specs method="Euler" time_units="Days" isee:pause_after_rates="false" isee:instantaneous_flows="false">
        <start>0</start>
        <stop>100</stop>
        <dt>1</dt>
        <isee:analyze_mode>false</isee:analyze_mode>
    </sim_specs>
    <dimensions>
        <dim name="Dim_Name_1" size="1" />
    </dimensions>
    <model_units />
    <isee:prefs last_model="true" layer="model" grid_width="20" grid_height="50" divide_by_zero_alert="true" link_high_level_map="true" show_module_prefix="true">
        <isee:window width="817" height="572" />
        <isee:security />
        <isee:print_setup width="552" height="728" />
    </isee:prefs>
    <isee:equation_prefs order_by="sector" />
    <model>
        <stock name="Uninfected_Population">
            <eqn>100000&#x0D;</eqn>
            <outflow>New_Infections</outflow>
            <non_negative />
            <display x="70" y="93" color="blue" />
        </stock>
        <stock name="Infected_not_Contagious">
            <eqn>0</eqn>
            <scale min="0" max="2400" />
            <inflow>New_Infections</inflow>
            <outflow>New_Contagious_cases</outflow>
            <conveyor>
                <len>12</len>
            </conveyor>
            <display x="239" y="94" color="blue">
                <scale min="0" max="2400" />
            </display>
        </stock>
        <flow name="New_Infections">
            <eqn>Symptomatic_and_Contagious*Contacts_per_Time*Probabaility_of_Infection*Susceptible_contacts</eqn>
            <non_negative />
            <display x="154" y="97" color="blue">
                <pts>
                    <pt x="90" y="97" />
                    <pt x="219" y="97" />
                </pts>
            </display>
        </flow>
        <stock name="Symptomatic_and_Contagious">
            <eqn>0,0,0,1</eqn>
            <scale min="0" max="100" />
            <inflow>New_Contagious_cases</inflow>
            <outflow>Fatalities</outflow>
            <conveyor>
                <len>4</len>
            </conveyor>
            <display x="391" y="96" color="blue" label_angle="48">
                <scale min="0" max="100" />
            </display>
        </stock>
        <flow name="New_Contagious_cases">
            <eqn>0</eqn>
            <non_negative />
            <display x="315" y="96" color="blue">
                <pts>
                    <pt x="259" y="96" />
                    <pt x="371" y="96" />
                </pts>
            </display>
        </flow>
        <stock name="Deaths">
            <eqn>0</eqn>
            <scale min="0" max="10000" />
            <inflow>Fatalities</inflow>
            <non_negative />
            <display x="541" y="98" color="blue">
                <scale min="0" max="10000" />
            </display>
        </stock>
        <flow name="Fatalities">
            <eqn>0</eqn>
            <non_negative />
            <display x="466" y="96" color="blue">
                <pts>
                    <pt x="411" y="96" />
                    <pt x="521" y="96" />
                </pts>
            </display>
        </flow>
        <aux name="Susceptible_contacts">
            <eqn>Uninfected_Population/(Infected_not_Contagious+Symptomatic_and_Contagious+Uninfected_Population-1)</eqn>
            <display x="163" y="219" color="blue" />
        </aux>
        <aux name="Probabaility_of_Infection">
            <eqn>.5</eqn>
            <display x="97" y="147" color="blue" />
        </aux>
        <aux name="Contacts_per_Time">
            <eqn>1</eqn>
            <display x="192" y="171" color="blue" />
        </aux>
        <display page_width="552" page_height="728" isee:converter_size="large" interval="DT">
            <connector x="55" y="108" uid="0">
                <from>Uninfected_Population</from>
                <to>Susceptible_contacts</to>
            </connector>
            <connector x="101" y="136" uid="1">
                <from>Probabaility_of_Infection</from>
                <to>New_Infections</to>
            </connector>
            <connector x="200" y="162" uid="2">
                <from>Contacts_per_Time</from>
                <to>New_Infections</to>
            </connector>
            <connector x="249" y="109" uid="3">
                <from>Infected_not_Contagious</from>
                <to>Susceptible_contacts</to>
            </connector>
            <connector x="388" y="111" uid="4">
                <from>Symptomatic_and_Contagious</from>
                <to>Susceptible_contacts</to>
            </connector>
            <connector x="162" y="207" uid="5">
                <from>Susceptible_contacts</from>
                <to>New_Infections</to>
            </connector>
            <connector x="380" y="79" uid="6">
                <from>Symptomatic_and_Contagious</from>
                <to>New_Infections</to>
            </connector>
            <stacked_container height="282" width="492" visible_index="1" uid="7">
                <graph type="time_series" title="Untitled Graph" background="#C8C8C8" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-04T09:27:50Z" cleared="true" time_precision="2" from="0" to="100">
                    <plot index="0" pen_width="1" color="red" precision="0.01" show_y_axis="true">
                        <entity name="Infected_not_Contagious" />
                    </plot>
                    <plot index="1" pen_width="1" color="blue" precision="0.01" show_y_axis="true">
                        <entity name="Symptomatic_and_Contagious" />
                    </plot>
                </graph>
                <graph type="time_series" title="Untitled Graph" background="#C8C8C8" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-04T09:27:50Z" cleared="true" time_precision="2" from="0" to="100">
                    <plot index="0" pen_width="1" color="blue" precision="0.01" show_y_axis="true">
                        <scale min="0" max="100000" />
                        <entity name="Uninfected_Population" />
                    </plot>
                    <plot index="1" pen_width="1" color="#008F44" precision="0.01" show_y_axis="true">
                        <entity name="Symptomatic_and_Contagious" />
                    </plot>
                    <plot index="2" pen_width="1" color="fuchsia" precision="0.01" show_y_axis="true">
                        <scale min="0" max="100" />
                        <entity name="Infected_not_Contagious" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="399" y="206" width="26" height="22" color="black" label_side="bottom" label="Graph 1" type="graph" icon_of="7" />
            <stacked_container height="286" width="465" uid="8">
                <table font-size="9" background="#FFFE91" column_width="60" orientation="vertical" interval="1" cleared="true" date_time="1997-07-16T12:18:34Z">
                    <title>Untitled Table</title>
                    <item type="time" color="black" width="100" />
                    <item color="black" precision="0.01" delimit_000s="true" index="0">
                        <entity name="Deaths" />
                    </item>
                    <item color="black" precision="0.01" delimit_000s="true" index="1">
                        <entity name="Infected_not_Contagious" />
                    </item>
                    <item color="black" precision="0.01" delimit_000s="true" index="2">
                        <entity name="Symptomatic_and_Contagious" />
                    </item>
                    <item color="black" precision="0.01" delimit_000s="true" index="3">
                        <entity name="Uninfected_Population" />
                    </item>
                    <item color="black" precision="0.01" delimit_000s="true" index="4">
                        <entity name="New_Contagious_cases" />
                    </item>
                    <item color="black" precision="0.01" delimit_000s="true" index="5">
                        <entity name="New_Infections" />
                    </item>
                </table>
            </stacked_container>
            <pad_icon x="479" y="206" width="26" height="22" color="#008F44" label_side="bottom" label="Table 1" type="table" icon_of="8" />
            <style font-family="Arial" font-size="9" />
        </display>
        <interface page_cols="0" page_rows="0" page_width="640" page_height="480" home_page="0">
            <simulation_delay>0</simulation_delay>
            <style font-family="Arial" font-size="9" />
        </interface>
        <popup x="8" y="51" content="7" />
        <popup x="8" y="51" content="8" />
        <style font-family="Arial" font-size="9" />
    </model>
</xmile>
