    <model_units />
    <isee:prefs last_model="true" layer="model" grid_width="20" grid_height="50" divide_by_zero_alert="true" hide_taskbar="true" show_module_prefix="true">
        <isee:window width="1366" height="685" />
        <isee:security />
        <isee:print_setup width="595" height="775" />
    </isee:prefs>
    <isee:equation_prefs order_by="sector" />
    <model>
        <stock name="Bacteria">
            <eqn>10</eqn>
            <inflow>Bacteria_reproduction</inflow>
            <non_negative />
            <display x="213" y="75" color="black" />
        </stock>
        <flow name="Bacteria_reproduction">
            <eqn>Bacteria*Bacteria_reproduction_rate</eqn>
            <non_negative />
            <display x="119" y="74" color="black" label_side="top" label_angle="101">
                <pts>
                    <pt x="45" y="74" />
                    <pt x="193" y="74" />
                </pts>
            </display>
        </flow>
        <aux name="Bacteria_reproduction_rate">
            <eqn>Growth_Limit-Bacteria</eqn>
            <gf>
                <xscale min="0" max="2000" />
                <yscale min="0" max="1" />
                <ypts>0,0.10000000000000001,0.20000000000000001,0.29999999999999999,0.40000000000000002,0.5,0.59999999999999998,0.69999999999999996,0.80000000000000004,0.90000000000000002,1</ypts>
            </gf>
            <display x="85" y="137" color="black" />
        </aux>
        <aux name="Growth_Limit">
            <eqn>2000</eqn>
            <display x="191" y="142" color="black" />
        </aux>
        <display page_width="595" page_height="775" isee:converter_size="medium" interval="DT">
            <connector x="90" y="130" uid="0">
                <from>Bacteria_reproduction_rate</from>
                <to>Bacteria_reproduction</to>
            </connector>
            <connector x="191" y="78" uid="1">
                <from>Bacteria</from>
                <to>Bacteria_reproduction</to>
            </connector>
            <connector x="179" y="139" uid="2">
                <from>Growth_Limit</from>
                <to>Bacteria_reproduction_rate</to>
            </connector>
            <connector x="198" y="90" uid="3">
                <from>Bacteria</from>
                <to>Bacteria_reproduction_rate</to>
            </connector>
            <stacked_container height="282" width="492" uid="4">
                <graph type="time_series" title="Untitled Graph" background="#C8C8C8" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-07T15:49:16Z" cleared="true" time_precision="0" from="0" to="12">
                    <plot index="0" pen_width="1" color="red" precision="1" show_y_axis="true">
                        <scale min="0" max="2000" />
                        <entity name="Bacteria" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="344" y="73" width="26" height="22" color="black" label_side="bottom" label="Graph 1" type="graph" icon_of="4" />
            <stacked_container height="286" width="465" uid="5">
                <table font-size="9" background="#FFFE91" column_width="60" orientation="vertical" interval="1" cleared="true" date_time="1997-09-28T18:28:30Z">
