            <style font-family="Arial" font-size="9" />
        </display>
        <interface page_width="640" page_height="480" scroll_y="8">
            <simulation_delay>0</simulation_delay>
            <stacked_container x="3" y="6" height="259" width="456" uid="16">
                <graph type="time_series" title="Untitled Graph" background="#C8C8C8" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-04T09:27:29Z" cleared="true" time_precision="2" from="0" to="100">
