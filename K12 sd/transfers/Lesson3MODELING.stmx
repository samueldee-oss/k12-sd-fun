            <stacked_container height="260" width="454" uid="35">
                <graph type="time_series" title="Total $$ in MY ACCOUNT" background="#FFFE91" show_grid="true" plot_numbers="true" isee:use_five_segments="true" hide_detail="true" comparative="true" cleared="true" time_precision="2" from="0" to="5">
                    <plot index="0" pen_width="3" color="blue" precision="1" show_y_axis="true">
                        <entity name="MY__ACCOUNT" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="638" y="826" width="26" height="22" color="#008F44" label_side="bottom" label="Graph 1" type="graph" icon_of="35" />
            <stacked_container height="282" width="492" uid="36">
                <graph type="time_series" title="Total $$ in MY ACCOUNT" background="#FFFFC9" show_grid="true" plot_numbers="true" isee:use_five_segments="true" hide_detail="true" comparative="true" cleared="true" time_precision="2" from="0" to="5">
                    <plot index="0" pen_width="3" color="blue" precision="1" show_y_axis="true">
                        <entity name="MY_ACCOUNT" />
                    </plot>
