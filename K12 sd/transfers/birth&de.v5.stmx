<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" level="3" xmlns="http://www.systemdynamics.org/XMILE" xmlns:isee="http://iseesystems.com/XMILE">
    <header>
        <smile version="1.0" namespace="std, isee">
            <uses_arrays>1</uses_arrays>
        </smile>
        <name>birth&amp;de.v5</name>
        <uuid>0811ec88-770a-4049-8436-b0fceeaf3ba6</uuid>
        <vendor>isee systems, inc.</vendor>
        <product version="10.1.2" isee:saved_by_v1="false" lang="en">iThink</product>
    </header>
    <style>
        <model font-family="Arial" font-size="9" />
        <interface font-family="Arial" font-size="9" />
    </style>
    <sim_specs method="Euler" time_units="Hours" isee:pause_after_rates="false" isee:instantaneous_flows="false">
        <start>0</start>
        <stop>25</stop>
        <dt>0.25</dt>
        <isee:analyze_mode>false</isee:analyze_mode>
    </sim_specs>
    <dimensions>
        <dim name="Dim_Name_1" size="1" />
    </dimensions>
    <model_units />
    <isee:prefs last_model="true" layer="model" grid_width="20" grid_height="50" divide_by_zero_alert="true" show_module_prefix="true">
        <isee:window width="584" height="454" />
        <isee:security />
        <isee:print_setup width="552" height="730" />
    </isee:prefs>
    <isee:equation_prefs order_by="sector" show_documentation="true" />
    <model>
        <stock name="population">
            <eqn>100</eqn>
            <scale min="0" max="200" />
            <inflow>births</inflow>
            <outflow>deaths</outflow>
            <display x="227" y="86" color="blue" label_side="bottom">
                <scale min="0" max="200" />
            </display>
        </stock>
        <flow name="births">
            <eqn>birth_rate*population</eqn>
            <non_negative />
            <display x="159" y="87" color="blue" label_side="top">
                <pts>
                    <pt x="112" y="87" />
                    <pt x="207" y="87" />
                </pts>
            </display>
        </flow>
        <aux name="birth_rate">
            <eqn>.1</eqn>
            <display x="102" y="137" color="blue" />
        </aux>
        <flow name="deaths">
            <eqn>population*death_rate</eqn>
            <non_negative />
            <display x="287" y="86" color="blue" label_side="top">
                <pts>
                    <pt x="247" y="86" />
                    <pt x="327" y="86" />
                </pts>
            </display>
        </flow>
        <aux name="death_rate">
            <eqn>.08</eqn>
            <display x="344" y="139" color="blue" />
        </aux>
        <aux name="normalized_population">
            <eqn>population/INIT(population)</eqn>
            <scale min="0" max="2" />
            <display x="227" y="32" color="blue" label_side="top">
                <scale min="0" max="2" />
            </display>
        </aux>
        <display page_width="552" page_height="730" page_order="column" isee:converter_size="large">
            <connector x="208" y="103" uid="0">
                <from>population</from>
                <to>births</to>
            </connector>
            <connector x="107" y="126" uid="1">
                <from>birth_rate</from>
                <to>births</to>
            </connector>
            <connector x="340" y="128" uid="2">
                <from>death_rate</from>
                <to>deaths</to>
            </connector>
            <connector x="249" y="101" uid="3">
                <from>population</from>
                <to>deaths</to>
            </connector>
            <connector x="208" y="71" uid="4">
                <from>population</from>
                <to>normalized_population</to>
            </connector>
            <stacked_container height="282" width="492" uid="5">
                <graph type="time_series" title="Untitled Graph" background="white" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-04T09:24:24Z" cleared="true" time_precision="2" from="0" to="25">
                    <plot index="0" pen_width="1" color="red" precision="0.01" show_y_axis="true">
                        <entity name="normalized_population" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="230" y="220" width="26" height="22" color="#0CA0FF" label_side="bottom" label="Graph 1" type="graph" icon_of="5" />
            <style font-family="Arial" font-size="9" />
        </display>
        <interface page_order="column" page_cols="0" page_rows="0" page_width="640" page_height="480" home_page="0">
            <simulation_delay>0</simulation_delay>
            <style font-family="Arial" font-size="9" />
        </interface>
        <popup x="43" y="241" content="5" />
        <style font-family="Arial" font-size="9" />
    </model>
</xmile>
