<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" level="3" xmlns="http://www.systemdynamics.org/XMILE" xmlns:isee="http://iseesystems.com/XMILE">
    <header>
        <smile version="1.0" namespace="std, isee">
            <uses_arrays>1</uses_arrays>
        </smile>
        <name>JHJP5.v3</name>
        <uuid>1d3cb74c-5669-4ad4-92e7-e85a9f8a0920</uuid>
        <vendor>isee systems, inc.</vendor>
        <product version="10.1.2" isee:saved_by_v1="false" lang="en">iThink</product>
    </header>
    <style>
        <model font-family="Arial" font-size="9" />
        <interface font-family="Arial" font-size="9" />
    </style>
    <sim_specs method="Euler" time_units="Days" isee:pause_after_rates="false" isee:instantaneous_flows="false">
        <start>0</start>
        <stop>15</stop>
        <dt>0.25</dt>
        <isee:analyze_mode>false</isee:analyze_mode>
    </sim_specs>
    <dimensions>
        <dim name="Dim_Name_1" size="1" />
    </dimensions>
    <model_units />
    <isee:prefs last_model="true" layer="model" grid_width="20" grid_height="50" divide_by_zero_alert="true" hide_taskbar="true" show_module_prefix="true">
        <isee:window width="1366" height="685" />
        <isee:security />
        <isee:print_setup width="595" height="775" />
    </isee:prefs>
    <isee:equation_prefs order_by="sector" show_documentation="true" />
    <model>
        <stock name="nerds">
            <eqn>1</eqn>
            <inflow>new_infect</inflow>
            <display x="235" y="105" color="black" />
        </stock>
        <flow name="new_infect">
            <eqn>nerds*contacts_per_time_period*prob_of_infect*Fraction_Suscept_contacts</eqn>
            <non_negative />
            <display x="175" y="102" color="black" label_side="top">
                <pts>
                    <pt x="136" y="102" />
                    <pt x="215" y="102" />
                </pts>
            </display>
        </flow>
        <aux name="Fraction_Suscept_contacts">
            <eqn>uninfected/(uninfected+nerds-1)</eqn>
            <display x="177" y="221" color="black" />
        </aux>
        <aux name="contacts_per_time_period">
            <eqn>1</eqn>
            <display x="224" y="158" color="black" />
        </aux>
        <aux name="prob_of_infect">
            <eqn>.5</eqn>
            <display x="118" y="160" color="black" />
        </aux>
        <stock name="uninfected">
            <eqn>25</eqn>
            <outflow>new_infect</outflow>
            <display x="116" y="102" color="black" />
        </stock>
        <display page_width="595" page_height="775" isee:converter_size="medium" isee:animate_flows="true" isee:animate_stocks="true" isee:animate_converters="true">
            <connector x="96" y="114" uid="0" color="black">
                <from>uninfected</from>
                <to>Fraction_Suscept_contacts</to>
                <polarity>-</polarity>
            </connector>
            <connector x="213" y="108" uid="1" color="black">
                <from>nerds</from>
                <to>new_infect</to>
                <polarity>-</polarity>
            </connector>
            <connector x="172" y="213" uid="2" color="black">
                <from>Fraction_Suscept_contacts</from>
                <to>new_infect</to>
                <polarity>-</polarity>
            </connector>
            <connector x="217" y="152" uid="3" color="black">
                <from>contacts_per_time_period</from>
                <to>new_infect</to>
                <polarity>-</polarity>
            </connector>
            <connector x="122" y="153" uid="4" color="black">
                <from>prob_of_infect</from>
                <to>new_infect</to>
                <polarity>-</polarity>
            </connector>
            <connector x="255" y="117" uid="5" color="black">
                <from>nerds</from>
                <to>Fraction_Suscept_contacts</to>
                <polarity>-</polarity>
            </connector>
            <stacked_container height="282" width="492" uid="6">
                <graph type="time_series" title="Untitled Graph" background="white" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-07T15:43:52Z" cleared="true" time_precision="0" from="0" to="15">
                    <plot index="0" pen_width="1" color="black" precision="1" show_y_axis="true">
                        <scale min="0" max="26" />
                        <entity name="nerds" />
                    </plot>
                    <plot index="1" pen_width="1" color="red" precision="1" show_y_axis="true">
                        <scale min="0" max="26" />
                        <entity name="uninfected" />
                    </plot>
                    <plot index="2" pen_width="1" color="blue" precision="1" show_y_axis="true">
                        <scale min="0" max="4" />
                        <entity name="new_infect" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="334" y="32" width="26" height="22" color="black" label_side="bottom" label="Graph 1" type="graph" icon_of="6" />
            <stacked_container height="286" width="465" uid="7">
                <table font-size="9" background="#FFFE91" column_width="60" orientation="vertical" interval="1" cleared="true" date_time="1992-12-29T11:32:37Z">
                    <title>Untitled Table</title>
                    <item type="time" color="black" precision="0.01" width="100" />
                    <item color="black" precision="0.01" display_as="number" index="0">
                        <entity name="uninfected" />
                    </item>
                    <item color="black" precision="0.01" display_as="number" index="1">
                        <entity name="new_infect" />
                    </item>
                    <item color="black" precision="0.01" display_as="number" index="2">
                        <entity name="nerds" />
                    </item>
                </table>
            </stacked_container>
            <pad_icon x="335" y="99" width="26" height="22" color="black" label_side="bottom" label="Table 1" type="table" icon_of="7" />
            <style font-family="Arial" font-size="9" />
        </display>
        <interface page_cols="0" page_rows="0" page_width="788" page_height="528" home_page="0">
            <simulation_delay>0.1</simulation_delay>
            <style font-family="Arial" font-size="9" />
        </interface>
        <popup x="16" y="78" content="6" />
        <popup x="16" y="78" content="7" />
        <style font-family="Arial" font-size="9" />
    </model>
