<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" level="3" xmlns="http://www.systemdynamics.org/XMILE" xmlns:isee="http://iseesystems.com/XMILE">
    <header>
        <smile version="1.0" namespace="std, isee">
            <uses_arrays>1</uses_arrays>
        </smile>
        <name>mammoth.v5</name>
        <uuid>6e30b802-aea4-4180-ae8a-abcd89e0fae5</uuid>
        <vendor>isee systems, inc.</vendor>
        <product version="10.1.2" isee:saved_by_v1="false" lang="en">iThink</product>
    </header>
    <style>
        <model font-family="Arial" font-size="9" />
        <interface font-family="Arial" font-size="9" />
    </style>
    <sim_specs method="Euler" time_units="Years" isee:pause_after_rates="false" isee:instantaneous_flows="false">
        <start>0</start>
        <stop>20</stop>
        <dt>0.25</dt>
        <isee:analyze_mode>false</isee:analyze_mode>
    </sim_specs>
    <dimensions>
        <dim name="Dim_Name_1" size="1" />
    </dimensions>
    <model_units />
    <isee:prefs last_model="false" layer="map" grid_width="20" grid_height="50" divide_by_zero_alert="true" link_high_level_map="true" show_module_prefix="true">
        <isee:window width="785" height="529" />
        <isee:security />
        <isee:print_setup width="582" height="762" />
    </isee:prefs>
    <isee:equation_prefs order_by="sector" />
    <model>
        <stock name="Mammoth_Population">
            <doc>Units: Mammoths</doc>
            <eqn>100</eqn>
            <inflow>Births</inflow>
            <outflow>Deaths</outflow>
            <display x="253" y="152" color="blue" />
        </stock>
        <flow name="Births">
            <doc>Units: Mammoths/year</doc>
            <eqn>Probability_of_Birth*Mammoth_Population</eqn>
            <non_negative />
            <display x="199" y="153" color="blue">
                <pts>
                    <pt x="166" y="153" />
                    <pt x="233" y="153" />
                </pts>
            </display>
        </flow>
        <flow name="Deaths">
            <doc>Units: Mammoths/year</doc>
            <eqn>Mammoth_Population*Probability_of_Death</eqn>
            <non_negative />
            <display x="312" y="153" color="blue">
                <pts>
                    <pt x="273" y="153" />
                    <pt x="352" y="153" />
                </pts>
            </display>
        </flow>
        <aux name="Probability_of_Birth">
            <doc>The fraction of the numbers on the dice that represent births.&#x0D;&#x0A;Units:  Fraction/year</doc>
            <eqn>1/6</eqn>
            <display x="119" y="197" color="blue" />
        </aux>
        <aux name="Probability_of_Death">
            <doc>The fraction of the numbers on the dice that represent deaths.&#x0D;&#x0A;Units: Fraction/year</doc>
            <eqn>1/3</eqn>
            <display x="392" y="193" color="blue" />
        </aux>
        <display page_width="582" page_height="762" isee:converter_size="large" interval="DT">
            <connector x="247" y="169" uid="0">
                <from>Mammoth_Population</from>
                <to>Births</to>
            </connector>
            <connector x="265" y="169" uid="1">
                <from>Mammoth_Population</from>
                <to>Deaths</to>
            </connector>
            <connector x="131" y="199" uid="2">
                <from>Probability_of_Birth</from>
                <to>Births</to>
            </connector>
            <connector x="380" y="194" uid="3">
                <from>Probability_of_Death</from>
                <to>Deaths</to>
            </connector>
            <stacked_container height="282" width="492" uid="4">
                <graph type="time_series" title="Untitled" background="#C8C8C8" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-04T09:52:14Z" cleared="true" time_precision="2" from="0" to="20">
                    <plot index="0" pen_width="1" color="red" precision="0.01" show_y_axis="true">
                        <entity name="Mammoth_Population" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="245" y="305" width="26" height="22" color="fuchsia" label_side="bottom" label="Graph 1" type="graph" icon_of="4" />
            <style font-family="Arial" font-size="9" />
        </display>
        <interface page_cols="0" page_rows="0" page_width="640" page_height="480" home_page="0">
            <simulation_delay>0</simulation_delay>
            <style font-family="Arial" font-size="9" />
        </interface>
        <popup x="13" y="112" content="4" />
        <style font-family="Arial" font-size="9" />
    </model>
</xmile>
