<?xml version="1.0" encoding="utf-8" ?>
<xmile version="1.0" level="3" xmlns="http://www.systemdynamics.org/XMILE" xmlns:isee="http://iseesystems.com/XMILE">
    <header>
        <smile version="1.0" namespace="std, isee">
            <uses_arrays>1</uses_arrays>
        </smile>
        <name>The Tree Game</name>
        <uuid>29201b2c-b286-4064-ab30-89f803cf8540</uuid>
        <vendor>isee systems, inc.</vendor>
        <product version="10.1.2" isee:saved_by_v1="false" lang="en">iThink</product>
    </header>
    <style>
        <model font-family="Arial" font-size="14" />
        <interface font-family="Arial" font-size="9" />
    </style>
    <sim_specs method="Euler" time_units="Years" isee:pause_after_rates="false" isee:instantaneous_flows="false">
        <start>0</start>
        <stop>10</stop>
        <dt>1</dt>
    </sim_specs>
    <dimensions>
        <dim name="Dim_Name_1" size="1" />
    </dimensions>
    <model_units />
    <isee:prefs last_model="true" layer="interface" grid_width="20" grid_height="50" divide_by_zero_alert="true" hide_taskbar="true" show_module_prefix="true">
        <isee:window width="1094" height="658" />
        <isee:security />
        <isee:print_setup width="576" height="768" />
    </isee:prefs>
    <isee:equation_prefs order_by="module" />
    <model>
        <stock name="Trees_on_Farm">
            <eqn>120</eqn>
            <inflow>Planting_Trees</inflow>
            <outflow>Cutting_Trees</outflow>
            <non_negative />
            <display x="248" y="185" color="blue" />
        </stock>
        <flow name="Planting_Trees">
            <eqn>4</eqn>
            <non_negative />
            <display x="154" y="179" color="blue" label_angle="223">
                <pts>
                    <pt x="83" y="179" />
                    <pt x="226" y="179" />
                </pts>
            </display>
        </flow>
        <flow name="Cutting_Trees">
            <eqn>Demand</eqn>
            <non_negative />
            <display x="350" y="180" color="blue" label_angle="299">
                <pts>
                    <pt x="270" y="180" />
                    <pt x="430" y="180" />
                </pts>
            </display>
        </flow>
        <stock name="Demand">
            <eqn>1</eqn>
            <inflow>Increase_in__Demand</inflow>
            <non_negative />
            <display x="452" y="330" color="blue" />
        </stock>
        <flow name="Increase_in_\nDemand">
            <eqn>Demand*Demand_Growth_Fraction</eqn>
            <non_negative />
            <display x="391" y="339" color="blue">
                <pts>
                    <pt x="352" y="339" />
                    <pt x="430" y="339" />
                </pts>
            </display>
        </flow>
        <stock name="Total_Sold">
            <eqn>0</eqn>
            <inflow>Cutting_Trees</inflow>
            <non_negative />
            <display x="452" y="184" color="blue" />
        </stock>
        <aux name="Demand_Growth\nFraction">
            <eqn>1</eqn>
            <display x="312" y="406" color="blue" />
        </aux>
        <display page_width="576" page_height="768" isee:converter_size="medium" isee:animate_flows="true" isee:animate_stocks="true" isee:animate_converters="true" interval="DT">
            <connector x="440" y="313" uid="0">
                <from>Demand</from>
                <to>Cutting_Trees</to>
            </connector>
            <connector x="430" y="313" uid="1">
                <from>Demand</from>
                <to>Increase_in__Demand</to>
            </connector>
            <connector x="315" y="398" uid="2">
                <from>Demand_Growth_Fraction</from>
                <to>Increase_in__Demand</to>
            </connector>
            <style font-family="Arial" font-size="14" />
        </display>
        <interface show_pages="true" page_cols="2" page_rows="2" page_width="1012" page_height="696" scroll_y="696" home_page="3">
            <simulation_delay>0.1</simulation_delay>
            <stacked_container x="25" y="38" height="319" width="556" uid="3">
                <graph type="time_series" title="Untitled" background="#FFFFC9" show_grid="true" plot_numbers="true" isee:use_five_segments="false" hide_detail="true" cleared="true" time_precision="2" from="0" to="10">
                    <plot index="0" pen_width="3" color="blue" precision="1" show_y_axis="true">
                        <scale min="0" max="140" />
                        <entity name="Trees_on_Farm" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="233" y="128" width="26" height="22" color="#008F44" label_side="bottom" label="Graph 1" type="graph" icon_of="3" />
            <stacked_container x="608" y="37" height="322" width="389" uid="4">
                <table font-size="9" background="#FFFFC9" column_width="93" orientation="vertical" interval="DT" cleared="true" date_time="2012-06-13T11:41:08Z">
                    <title>Trees</title>
                    <item type="time" color="black" header-font-weight="bold" precision="1" width="47" />
                    <item color="black" header-font-weight="bold" precision="1" delimit_000s="true" index="0">
                        <entity name="Trees_on_Farm" />
                    </item>
                    <item color="black" header-font-weight="bold" precision="1" delimit_000s="true" index="1">
                        <entity name="Planting_Trees" />
                    </item>
                    <item color="black" header-font-weight="bold" precision="1" delimit_000s="true" index="2">
                        <entity name="Cutting_Trees" />
                    </item>
                </table>
            </stacked_container>
            <pad_icon x="903" y="161" width="26" height="22" color="#CACB30" label_side="bottom" label="Table 1" type="table" icon_of="4" />
            <button x="621" y="442" width="42" height="40" uid="5" appearance="opaque" background="black" color="white" style="rounded" icon="5">
                <link target="home_page" isee:default_icon="true" />
            </button>
            <text_box x="187" y="759" uid="6" color="black" font-family="Arial" font-size="12" padding="5" border-style="solid" border-width="thin" width="540" height="315">THE TREE GAME&#x0D;&#x0D;In this activity, trees are planted, grown, and sold.  Four trees are planted every year.  In the first year, one tree is sold.  What if that buyer was pleased with the tree and not only came back to buy another next year but also told a friend, and the friend bought a tree?  This friend was also a satisfied customer and told another person.  Every year customers returned to buy again and brought  someone else with them to buy a tree.  &#x0D;&#x0D;The computer model simulates the activity.  You can see that the number of trees are the stock.   Planting trees increases the stock, while cutting trees reduces it.  Demand for trees keeps the outflow (cutting trees) increasing while the inflow (planting) stays the same.  In order to have a sustainable, or stable stock, the flows must be in balance.  If the outflow  is greater than the inflow, the stock will decline.&#x0D;&#x0D;Run the computer simulation of the Tree Game and see what happens when an increasing number of trees are cut for sale, and the number being planted stays constant.  Then you can try another activity, the Tree Game Puzzle, and experiment with other policies for the inflow and outflow</text_box>
            <button x="334" y="440" width="68" height="45" uid="7" appearance="opaque" background="black" color="white" style="rounded" label="Restore Graphs &amp; Tables" font-family="Arial" font-size="12" text-align="center">
                <menu_action>restore_graphs_tables</menu_action>
            </button>
            <button x="335" y="381" width="65" height="34" uid="8" appearance="opaque" background="black" color="white" style="rounded" label="Run" font-family="Arial" font-size="12" text-align="center">
                <menu_action>run</menu_action>
            </button>
            <numeric_display precision="1" display_as="number" color="blue" show_name="true" retain_ending_value="true" uid="9" x="897" y="385">
                <entity name="Total_Sold" />
            </numeric_display>
            <button x="435" y="1130" width="154" height="36" uid="10" appearance="opaque" background="black" color="white" style="square" label="Run the simulation" font-family="Arial" font-size="12" text-align="center">
                <link target="interface" x="0" y="0" />
            </button>
            <button x="838" y="440" width="118" height="40" uid="11" appearance="opaque" background="black" color="white" style="rounded" label="Restore Numeric Displays" font-family="Arial" font-size="12" text-align="center">
                <menu_action>restore_numeric_displays</menu_action>
            </button>
            <style font-family="Arial" font-size="9" />
        </interface>
        <style font-family="Arial" font-size="14" />
    </model>
</xmile>
