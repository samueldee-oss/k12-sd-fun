    <model_units />
    <isee:prefs last_model="true" layer="model" grid_width="20" grid_height="50" divide_by_zero_alert="true" hide_taskbar="true" show_module_prefix="true">
        <isee:window width="1366" height="685" />
        <isee:security />
        <isee:print_setup width="595" height="775" />
    </isee:prefs>
    <isee:equation_prefs order_by="sector" />
    <model>
        <stock name="Infected_Population">
            <eqn>1</eqn>
            <inflow>flow</inflow>
            <non_negative />
            <display x="198" y="70" color="blue" />
        </stock>
        <flow name="flow">
            <eqn>Infected_Population*New_infections_per_individual_member_of_Infected_Population</eqn>
            <non_negative />
            <display x="136" y="64" color="blue">
                <pts>
                    <pt x="95" y="64" />
                    <pt x="178" y="64" />
                </pts>
            </display>
        </flow>
        <aux name="New_infections_per_individual_member_of_Infected_Population">
            <eqn>1</eqn>
            <display x="195" y="153" color="blue" />
        </aux>
        <display page_width="595" page_height="775" isee:converter_size="medium" interval="DT">
            <connector x="189" y="146" uid="0">
                <from>New_infections_per_individual_member_of_Infected_Population</from>
                <to>flow</to>
            </connector>
            <connector x="176" y="74" uid="1">
                <from>Infected_Population</from>
                <to>flow</to>
            </connector>
            <stacked_container height="282" width="492" uid="2">
                <graph type="time_series" title="Untitled Graph" background="#C8C8C8" show_grid="true" plot_numbers="true" isee:use_five_segments="false" date_time="2025-02-07T15:43:48Z" cleared="true" time_precision="0" from="0" to="12">
                    <plot index="0" pen_width="1" color="red" precision="1" show_y_axis="true">
                        <entity name="Infected_Population" />
                    </plot>
                </graph>
            </stacked_container>
            <pad_icon x="361" y="75" width="26" height="22" color="#0CA0FF" label_side="bottom" label="Graph 1" type="graph" icon_of="2" />
            <style font-family="Arial" font-size="9" />
        </display>
        <interface page_cols="0" page_rows="0" page_width="788" page_height="528" home_page="0">
            <simulation_delay>0.1</simulation_delay>
            <style font-family="Arial" font-size="9" />
        </interface>
        <popup x="16" y="78" content="2" />
        <style font-family="Arial" font-size="9" />
    </model>
